[{"id": "strtbl:68_0_1:1", "jp": "時間城では武器ガ買えるらしい\n", "zh": "听说时间城能买武器", "dup": null}, {"id": "strtbl:68_0_1:2", "jp": "トニーの店では武器ガ買えるらしい\n", "zh": "听说托尼的店能买武器", "dup": null}, {"id": "strtbl:68_0_1:3", "jp": "クレール・ド・リュンヌは武器屋?\n", "zh": "克蕾儿·德·露娜是武器店？", "dup": null}, {"id": "strtbl:68_0_1:4", "jp": "ジヨリーロジャーで武器ガ買えるらしい\n", "zh": "听说乔利·罗杰能买武器", "dup": null}, {"id": "strtbl:68_0_1:5", "jp": "ロサカンディータ蓮華台店は防具屋?\n", "zh": "罗莎坎迪塔莲华台店是防具店？", "dup": null}, {"id": "strtbl:68_0_1:6", "jp": "アニマムンディで防具ガ買えるらしい\n", "zh": "灵魂世界有防具卖", "dup": null}, {"id": "strtbl:68_0_1:7", "jp": "ロサカンディータ青華店は防具屋?\n", "zh": "罗莎坎迪塔青华店卖防具?", "dup": null}, {"id": "strtbl:68_0_1:8", "jp": "倫敦屋で防具ガ買えるらしい\n", "zh": "伦敦屋有防具卖", "dup": null}, {"id": "strtbl:68_0_1:9", "jp": "雑誌の懸賞で本物の武器ガ当たるらしい\n", "zh": "杂志抽奖可得真武器", "dup": null}, {"id": "strtbl:68_0_1:10", "jp": "ムー大陸でカジノガ楽しめるらしい\n", "zh": "穆大陆可玩赌场", "dup": null}, {"id": "strtbl:68_0_1:11", "jp": "ラーメンしらいしにスペシャルな武器ガ!\n", "zh": "拉面白石有特殊武器!", "dup": null}, {"id": "strtbl:68_0_1:13", "jp": "クレール・ド・リュンヌに凄い武器ガ!\n", "zh": "克蕾儿·德·露恩有强力武器!", "dup": null}, {"id": "strtbl:68_0_1:14", "jp": "時間城に伝説の武器ガ?\n", "zh": "时间城有传说武器?", "dup": null}, {"id": "strtbl:68_0_1:16", "jp": "怪奇、花子さん出現!\n", "zh": "怪奇，花子出现!", "dup": null}, {"id": "strtbl:68_0_1:17", "jp": "衝撃、ブキミちゃん出現!\n", "zh": "冲击，恐怖女孩出现!", "dup": null}, {"id": "strtbl:68_0_1:18", "jp": "脅威、たんすババア現る!\n", "zh": "威胁，衣橱婆婆现身!", "dup": null}, {"id": "strtbl:68_0_1:19", "jp": "凄惨、元アイドルの幽霊現る!\n", "zh": "凄惨，过气偶像幽灵现身!", "dup": null}, {"id": "strtbl:68_0_1:20", "jp": "恐怖、呪いのタクシー現る!\n", "zh": "恐怖，诅咒出租车现身!", "dup": null}, {"id": "strtbl:68_0_1:21", "jp": "恐怖再び、呪いの個人タクシー現る!\n", "zh": "恐怖再现，诅咒个人出租车现身!", "dup": null}, {"id": "strtbl:68_0_1:22", "jp": "戦慄、妖怪くちさけ現る!\n", "zh": "战栗，裂口女现身!", "dup": null}, {"id": "strtbl:68_0_1:23", "jp": "仰天、ジャンピングじじい現る!\n", "zh": "震惊，跳跃老头现身!", "dup": null}, {"id": "strtbl:68_0_1:24", "jp": "件\n", "zh": "件", "dup": null}, {"id": "strtbl:68_0_1:25", "jp": "珍品、隠しCD\n", "zh": "珍品隐藏CD", "dup": null}, {"id": "strtbl:68_0_1:26", "jp": "ラーメン屋さんの店主は元女スパイ\n", "zh": "拉面店主曾是女间谍", "dup": null}, {"id": "strtbl:68_0_1:28", "jp": "ゾディアック、二階の怪\n", "zh": "黄道十二宫，二楼怪谈", "dup": null}, {"id": "strtbl:68_0_1:29", "jp": "花だけに…話すんです\n", "zh": "花会说话", "dup": null}]