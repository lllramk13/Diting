[{"id": "script:508_8:diag0", "jp": "\n<SURNAME/>こんな時まで遊びに来るたぁ、\n<SURNAME/><c14/>も相当つわものだねぇ。\n<SURNAME/>どうせならここカジノにしちまえば良いのに。", "zh": "\n<SURNAME/>这种时候还来玩，\n<SURNAME/><c14/>也够有种的嘛。\n<SURNAME/>干脆把这儿搞成赌场得了。", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:508_8:diag1", "jp": "\n<SURNAME/>こんな時まで遊びに来るたぁ、\n<SURNAME/><c14/>も相当つわものだねぇ。\n<SURNAME/>ま、それぐらいの余裕も必要かな。", "zh": "\n<SURNAME/>这种时候还来玩，\n<SURNAME/><c14/>也够有种的嘛。\n<SURNAME/>嘛，这点余裕还是要有的。", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:508_8:diag2", "jp": "\n<SURNAME/>ここにいる人達、逃げないのかな?\n<SURNAME/>でも街ガ空の上じゃ逃げ場ないもんね…<pause:15/>\n<SURNAME/>ひらきなおってるのかな?", "zh": "\n<SURNAME/>这里的人都不逃吗?\n<SURNAME/>但城市在天上没处逃啊…<pause:15/>\n<SURNAME/>是看开了吧?", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:508_8:diag3", "jp": "\n<SURNAME/>コラコラ、\n<SURNAME/>こんな時までカジノで楽しもうというのか君は?\n<SURNAME/>ン、ンー?", "zh": "\n<SURNAME/>喂喂，\n<SURNAME/>这种时候还想在赌场玩吗?\n<SURNAME/>嗯，嗯—?", "speaker_jp": "舞耶", "speaker_zh": "舞耶", "dup": null}, {"id": "script:508_8:diag4", "jp": "\n<SURNAME/>え?\n<SURNAME/>ここガカジノだって噂ガあるの?", "zh": "\n<SURNAME/>咦?\n<SURNAME/>传闻说这里是赌场?", "speaker_jp": "淳", "speaker_zh": "纯", "dup": null}, {"id": "script:508_8:diag5", "jp": "\n<SURNAME/>う、うん…<pause:15/>\n<SURNAME/>僕ガジヨーカーでなくなった今でも、\n<SURNAME/>噂ガ広まれば現実になると思うけど…", "zh": "\n<SURNAME/>唔，嗯…<pause:15/>\n<SURNAME/>就算我现在不是小丑了，\n<SURNAME/>传闻扩散也会成真吧…", "speaker_jp": "淳", "speaker_zh": "纯", "dup": null}, {"id": "script:508_8:diag6", "jp": "\n<SURNAME/>え?<SURNAME/>じゃあここ、<c13/>達ガ噂を広めたから\n<SURNAME/>カジノになってるのかい?\n<SURNAME/>け、けっこう大胆な事するんだね…", "zh": "\n<SURNAME/>咦?<SURNAME/>那这里是因为<c13/>们散布传闻\n<SURNAME/>才变成赌场的?\n<SURNAME/>挺、挺敢干的嘛…", "speaker_jp": "淳", "speaker_zh": "纯", "dup": null}, {"id": "script:508_8:diag7", "jp": "\n<SURNAME/>え?<SURNAME/>街ガ飛んでる?\n<SURNAME/>何言ってんの?\n<SURNAME/>いくらなんでもそんな…マジで?", "zh": "\n<SURNAME/>哈?<SURNAME/>城市飞起来了?\n<SURNAME/>说啥呢?\n<SURNAME/>再怎样也…真的假的?", "speaker_jp": "若い男", "speaker_zh": "年轻男子", "dup": null}, {"id": "script:508_8:diag8", "jp": "\n<SURNAME/>あの…<pause:10/>今、外ってどうなってんですか?<pause:15/>\n<SURNAME/>私も彼も、あの兵隊見てから、\n<SURNAME/>ずっとこの中に隠れてたもんだから…", "zh": "\n<SURNAME/>那个…<pause:10/>现在外面怎样了?<pause:15/>\n<SURNAME/>我和他看见那些兵后，\n<SURNAME/>就一直躲在这里面…", "speaker_jp": "若い女", "speaker_zh": "年轻女子", "dup": null}, {"id": "script:508_8:diag9", "jp": "\n<SURNAME/>ラスト・バタリオンとは…予期せぬカードだな。<pause:15/>\n<SURNAME/>どうやらこの街全体ガ賭けの対象となったようだ。\n<SURNAME/>命運を分けるのは…カードか…", "zh": "\n<SURNAME/>最后堡垒…真是意外的卡啊。<pause:15/>\n<SURNAME/>看来整个城市都成了赌注。\n<SURNAME/>决定命运的…是卡吗…", "speaker_jp": "ギャンブル好きの男", "speaker_zh": "赌徒男", "dup": "dup:5fad7d62964e"}, {"id": "script:508_8:diag10", "jp": "\n<SURNAME/>この先は現在清掃中です。\n<SURNAME/>え?<SURNAME/>どうせずっと清掃中だろうって?\n<SURNAME/>す、するどい…", "zh": "\n<SURNAME/>前方正在清扫中。\n<SURNAME/>咦?<SURNAME/>说反正永远在清扫?\n<SURNAME/>好、好敏锐…", "speaker_jp": "警備員", "speaker_zh": "警卫", "dup": "dup:18a1e8977117"}, {"id": "script:508_8:diag11", "jp": "\n<SURNAME/>いらっしゃいませ。ムー大陸へようこそ。\n<SURNAME/>コインチェンジと景品の交換は、\n<SURNAME/>こちらで承ります。なんなりと言えや。", "zh": "\n<SURNAME/>欢迎光临。欢迎来到姆大陆。\n<SURNAME/>硬币兑换和奖品交换，\n<SURNAME/>由我负责。尽管说。", "speaker_jp": "店長", "speaker_zh": "店长", "dup": "dup:ae73d1de1c8f"}, {"id": "script:508_8:diag12", "jp": "\n<SURNAME/>えー、まだなんかあんの?<pause:15/>\n<SURNAME/>…って、うそうそ。\n<SURNAME/>何でも言っとくれ。", "zh": "\n<SURNAME/>诶—，还有什么事吗？<pause:15/>\n<SURNAME/>…啊，不不。\n<SURNAME/>尽管说。", "speaker_jp": "店長", "speaker_zh": "店长", "dup": "dup:b5dd34277124"}, {"id": "script:508_8:diag13", "jp": "\n<SURNAME/>え?<SURNAME/>街ガ飛んでる?<SURNAME/>言うな!<SURNAME/>言わんでいい。\n<SURNAME/>もう俺はどんな運命も受け入れる覚悟をしてる!\n<SURNAME/>けっこう、へこんでるけど…", "zh": "\n<SURNAME/>啥?<SURNAME/>城市飞了?<SURNAME/>别说了!<SURNAME/>不用讲。\n<SURNAME/>老子已决心接受任何命运!\n<SURNAME/>虽然挺消沉的…", "speaker_jp": "店長", "speaker_zh": "店长", "dup": null}, {"id": "script:508_8:diag14", "jp": "\n<SURNAME/>まぁ、いろいろあるだろうけど、\n<SURNAME/>また遊びに来てよ。\n<SURNAME/>それなりに歓迎はするし。", "zh": "\n<SURNAME/>嘛，虽然可能有些事，\n<SURNAME/>但再来玩吧。\n<SURNAME/>我会欢迎的。", "speaker_jp": "店長", "speaker_zh": "店长", "dup": "dup:f2fd56edc1d7"}, {"id": "script:508_8:diag15", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>01番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>01号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:98b6eb2a6fc3"}, {"id": "script:508_8:diag16", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>01番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>01号台<SURNAME/>要玩吗?", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag17", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>02番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>02号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:c8f1019998a2"}, {"id": "script:508_8:diag18", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>02番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>02号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag19", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>03番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>03号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:9aa2867999e4"}, {"id": "script:508_8:diag20", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>03番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>03号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag21", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>04番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>04号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:6a30e5934f5e"}, {"id": "script:508_8:diag22", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>04番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>04号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag23", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>05番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>05号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:f30493d2e824"}, {"id": "script:508_8:diag24", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>05番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>05号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag25", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>06番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>06号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:449083d2819c"}, {"id": "script:508_8:diag26", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>06番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>06号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag27", "jp": "\n<SURNAME/>ポーカー\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>07番台ガある。", "zh": "\n<SURNAME/>扑克\n<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>07号机有。", "speaker_jp": "ゲーム台", "speaker_zh": "游戏台", "dup": "dup:4f16380da651"}, {"id": "script:508_8:diag28", "jp": "\n<option:2/>はい\nいいえ\n<option_end/>", "zh": "<option:2/>是 否<option_end/>", "speaker_jp": "<SURNAME/>ポーカー<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>07番台<SURNAME/>プレイしますか?", "speaker_zh": "<SURNAME/>扑克<SURNAME/>「WILD<SURNAME/>9」\n<SURNAME/>07号机<SURNAME/>要玩吗？", "dup": "dup:6d73edbc6f08"}, {"id": "script:508_8:diag29", "jp": "\n<SURNAME/>ポーカー\n<S