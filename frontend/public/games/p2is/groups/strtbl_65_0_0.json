[{"id": "strtbl:65_0_0:1", "jp": "アイテムの種類を選択してください\n", "zh": "请选择物品类型", "dup": null}, {"id": "strtbl:65_0_0:2", "jp": "この種類のアイテムはありません\n", "zh": "没有此类物品", "dup": null}, {"id": "strtbl:65_0_0:3", "jp": "方向キー左右で個数選択 ○ボタンで決定\n", "zh": "方向键左右选数量 ○键确定", "dup": "dup:844f9b219774"}, {"id": "strtbl:65_0_0:4", "jp": "そのアイテムは売却できません\n", "zh": "无法出售此物品", "dup": null}, {"id": "strtbl:65_0_0:5", "jp": "これでよろしいですか?\n", "zh": "确定吗？", "dup": "dup:f0bfe28bfded"}, {"id": "strtbl:65_0_0:6", "jp": "これ以上は所持していません\n", "zh": "没有更多物品", "dup": null}, {"id": "strtbl:65_0_0:7", "jp": "所持金制限を上回る売却はできません\n", "zh": "超出金钱限制无法出售", "dup": null}]