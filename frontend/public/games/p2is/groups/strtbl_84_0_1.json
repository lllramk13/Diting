[{"id": "strtbl:84_0_1:0", "jp": "今週は、ずっと泊っていました。\n", "zh": "这周我一直住在这里。", "dup": null}, {"id": "strtbl:84_0_1:1", "jp": "ずいぶんプログラムは、進んだつもりです。\n", "zh": "程序应该进展了不少。", "dup": null}, {"id": "strtbl:84_0_1:2", "jp": "これからも毎日徹夜だぜ!!。\n", "zh": "以后也要每天熬夜!!", "dup": null}, {"id": "strtbl:84_0_1:3", "jp": "夜中に食べたぺヤング旨かったな\n", "zh": "半夜吃的ペヤング真香啊", "dup": null}, {"id": "strtbl:84_0_1:4", "jp": "ぺヤング有れば他に何もいらないや・・・\n", "zh": "有ペヤング就足够了・・・", "dup": null}]