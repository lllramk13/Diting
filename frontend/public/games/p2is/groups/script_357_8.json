[{"id": "script:357_8:diag0", "jp": "\n<SURNAME/>よかった、<c13/>…\n<SURNAME/>無事みたいだね。\n", "zh": "\n<SURNAME/>太好了，<c13/>…\n<SURNAME/>看来没事呢。\n", "speaker_jp": "淳", "speaker_zh": "黛纯", "dup": null}, {"id": "script:357_8:diag1", "jp": "\n<SURNAME/>君は、リサと舞耶姉さんを頼む。\n<SURNAME/>僕はミッシェルの様子を見るから。\n", "zh": "\n<SURNAME/>你，拜托照顾丽莎和舞耶姐姐。\n<SURNAME/>我去看看米切的情况。\n", "speaker_jp": "淳", "speaker_zh": "黛纯", "dup": null}, {"id": "script:357_8:diag2", "jp": "\n<SURNAME/>うーん…<pause:30/>\n<SURNAME/><c13/>…?\n", "zh": "\n<SURNAME/>嗯…<pause:30/>\n<SURNAME/><c13/>…？\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:357_8:diag3", "jp": "\n<SURNAME/>う…<pause:30/>\n<SURNAME/><c13/>クン…?\n<SURNAME/>みんな…は?\n", "zh": "\n<SURNAME/>唔…<pause:30/>\n<SURNAME/><c13/>君…？\n<SURNAME/>大家…呢？\n", "speaker_jp": "舞耶", "speaker_zh": "天野舞耶", "dup": null}, {"id": "script:357_8:diag4", "jp": "\n<SURNAME/>ってぇ…<pause:30/>\n<SURNAME/>ひでぇ目にあったぜ…\n", "zh": "\n<SURNAME/>真是的…<pause:30/>\n<SURNAME/>倒了大霉了…\n", "speaker_jp": "栄吉", "speaker_zh": "三科荣吉", "dup": null}, {"id": "script:357_8:diag5", "jp": "\n<SURNAME/>ふう…<pause:30/>\n<SURNAME/>とりあえず、みんな無事みたいね。\n", "zh": "\n<SURNAME/>呼…<pause:30/>\n<SURNAME/>总之，大家好像都没事呢。\n", "speaker_jp": "舞耶", "speaker_zh": "天野舞耶", "dup": null}, {"id": "script:357_8:diag6", "jp": "\n<SURNAME/>あんな高いとこから落ちたんじゃ、\n<SURNAME/>ここから戻るのも無理だし…<pause:30/>\n<SURNAME/>どうするか考えましょ。\n", "zh": "\n<SURNAME/>从那么高的地方掉下来，\n<SURNAME/>从这里回去也不可能了…<pause:30/>\n<SURNAME/>想想怎么办吧。\n", "speaker_jp": "舞耶", "speaker_zh": "天野舞耶", "dup": null}, {"id": "script:357_8:diag7", "jp": "\n<SURNAME/>ところで淳よ…<pause:30/>\n<SURNAME/>さっきから何見て…\n", "zh": "\n<SURNAME/>话说淳啊…<pause:30/>\n<SURNAME/>你从刚才在看什么…\n", "speaker_jp": "栄吉", "speaker_zh": "三科荣吉", "dup": null}]