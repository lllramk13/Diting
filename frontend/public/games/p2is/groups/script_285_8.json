[{"id": "script:285_8:diag0", "jp": "\n<SURNAME/>ジャーン!!\n", "zh": "\n<SURNAME/>锵—!!\n", "speaker_jp": "黒いお面の男の子", "speaker_zh": "黑面具男孩", "dup": null}, {"id": "script:285_8:diag1", "jp": "\n<SURNAME/>ケーン!!\n", "zh": "\n<SURNAME/>铿—!!\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:285_8:diag2", "jp": "\n<SURNAME/>ポ、ポーン!!\n", "zh": "\n<SURNAME/>砰、砰—!!\n", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:285_8:diag3", "jp": "\n<SURNAME/>………\n", "zh": "\n<SURNAME/>………\n", "speaker_jp": "<c13/>", "speaker_zh": "<c13/>", "dup": "dup:095d4f8cec80"}, {"id": "script:285_8:diag4", "jp": "\n<SURNAME/>わーい!!\n<SURNAME/>かったかったー!!\n", "zh": "\n<SURNAME/>哇—!!\n<SURNAME/>赢啦赢啦—!!\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:285_8:diag5", "jp": "\n<SURNAME/>じゃあ、きょうはぁ…<pause:30/>\n<SURNAME/>オママゴトにきーめたっ!!\n", "zh": "\n<SURNAME/>那么，今天呢…<pause:30/>\n<SURNAME/>就玩过家家吧!!\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:285_8:diag6", "jp": "\n<SURNAME/>え、え〜!?\n<SURNAME/>き、きょうは、お、お絵かきしようよお。\n<SURNAME/>せ、せっかく、クレヨン持ってきたのに…\n", "zh": "\n<SURNAME/>咦，咦～!?\n<SURNAME/>今、今天，画、画画吧～。\n<SURNAME/>好、好不容易，把蜡笔带来了…\n", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:285_8:diag7", "jp": "\n<SURNAME/>だめだよ、イエロー。\n<SURNAME/>ボスの言うことは、ぜったい聞かなきゃダメって、\n<SURNAME/>オキテじゃないか。\n", "zh": "\n<SURNAME/>不行啦，黄仔～\n<SURNAME/>老大的话，绝对要听才行，\n<SURNAME/>不是规矩吗～\n", "speaker_jp": "黒いお面の男の子", "speaker_zh": "黑面具男孩", "dup": null}, {"id": "script:285_8:diag8", "jp": "\n<SURNAME/>えーとお、お父さんはレッドでぇ、\n<SURNAME/>お母さんは、とうぜんリサでしょお?\n<SURNAME/>でぇ、ブラックはお兄ちゃん!\n", "zh": "\n<SURNAME/>嗯～，爸爸是红仔，\n<SURNAME/>妈妈当然是丽莎吧～?\n<SURNAME/>然后，黑仔是哥哥!\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:285_8:diag9", "jp": "\n<SURNAME/>ま、またぼく、赤ちゃん…?\n", "zh": "\n<SURNAME/>又、又是我，当婴儿…?\n", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:285_8:diag10", "jp": "\n<SURNAME/>わ、わかったよお…\n", "zh": "\n<SURNAME/>好、好吧…\n", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:285_8:diag11", "jp": "\n<SURNAME/>バ、バブバブー\n<SURNAME/>バ、バブバブー\n", "zh": "\n<SURNAME/>吧、吧吧吧～\n<SURNAME/>吧、吧吧吧～\n", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:285_8:diag12", "jp": "\n<SURNAME/>ねぇアナタ〜♥\n<SURNAME/>もう、子供たちもねたことだしい〜♥\n<SURNAME/>いっしょにおフロにはいりましょ〜♥\n", "zh": "\n<SURNAME/>喂，老公～♥\n<SURNAME/>孩子们也睡了，\n<SURNAME/>一起泡澡吧～♥\n", "speaker_jp": "ギンコ", "speaker_zh": "丽莎", "dup": null}, {"id": "script:285_8:diag13", "jp": "\n<SURNAME/>ママ…<pause:30/>\n<SURNAME/>ボク、ごはん食べてない…\n", "zh": "\n<SURNAME/>妈妈…<pause:30/>\n<SURNAME/>我，还没吃饭…\n", "speaker_jp": "黒いお面の男の子", "speaker_zh": "黑面具男孩", "dup": null}]