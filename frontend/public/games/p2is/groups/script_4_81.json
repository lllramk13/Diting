[{"id": "script:4_81:diag0", "jp": "\n<SURNAME/>我は、お前達人形を写す鏡…\n<SURNAME/>全てを無へ帰すのガ我ガ宿命…\n<SURNAME/>まずは貴様らからだ\n<unk7/>", "zh": "\n<SURNAME/>吾乃映照汝等人偶之镜…\n<SURNAME/>将一切化为虚无乃吾之宿命…\n<SURNAME/>就从你们开始\n<unk7/>", "speaker_jp": "デビル・ジヨーカー", "speaker_zh": "恶魔小丑", "dup": null}, {"id": "script:4_81:diag1", "jp": "\n<SURNAME/>なんだってんだ、ちくしょう!!\n<unk7/>", "zh": "\n<SURNAME/>搞什么鬼，可恶!!\n<unk7/>", "speaker_jp": "栄吉", "speaker_zh": "荣吉", "dup": null}, {"id": "script:4_81:diag2", "jp": "\n<SURNAME/>淳クン、やめて!!\n<SURNAME/>もうやめてー!!\n<unk7/>", "zh": "\n<SURNAME/>淳君，住手!!\n<SURNAME/>快住手ー!!\n<unk7/>", "speaker_jp": "舞耶", "speaker_zh": "舞耶", "dup": null}, {"id": "script:4_81:diag3", "jp": "\n<SURNAME/>もう助けられないの!?\n<SURNAME/>ねぇ、情人(チンヤン)!\n<unk7/>", "zh": "\n<SURNAME/>已经救不了他了吗!?\n<SURNAME/>喂，情人!\n<unk7/>", "speaker_jp": "ギンコ", "speaker_zh": "玲司", "dup": null}, {"id": "script:4_81:diag4", "jp": "\n<SURNAME/>………\n<unk7/>", "zh": "\n<SURNAME/>………\n<unk7/>", "speaker_jp": "<c13/>", "speaker_zh": "<c13/>", "dup": "dup:c0d0d120f293"}]