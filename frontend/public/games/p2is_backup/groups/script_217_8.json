[{"src":"script","id":"script:217_8:diag0","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>へイ、エブリバデ!\n<SURNAME/>ギンコの声だ!\n","zh":"\n<SURNAME/>嘿，大家好！\n<SURNAME/>是银次的声音！\n"},{"src":"script","id":"script:217_8:diag1","speaker_jp":"麻美の声","speaker_zh":"麻美的声音","jp":"\n<SURNAME/>ねえ、ウソなんでしょ?\n<SURNAME/>リサ…?\n","zh":"\n<SURNAME/>喂，是骗人的吧？\n<SURNAME/>丽莎…？\n"},{"src":"script","id":"script:217_8:diag2","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>今さらステージに戻っても、しゃーねぇだろ?\n<SURNAME/>早ぇとこ、ギンコ探そうぜ!!\n","zh":"\n<SURNAME/>现在回舞台也没用了吧？\n<SURNAME/>快点，去找银次吧!!\n"},{"src":"script","id":"script:217_8:diag3","speaker_jp":"ダンボール","speaker_zh":"纸箱","jp":"\n<SURNAME/><c1d:9/><c1d:1/>\n","zh":"\n<SURNAME/><c1d:9/><c1d:1/>\n"}]