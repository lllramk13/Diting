[{"id": "script:5396", "jp": "<c2e/>天誅軍兵士<c2e/>\\n<c31/>お早く…!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>天诛军士兵<c2e/>\\n<c31/>请快……！\\n<c7/><WAIT><PAGE>", "meta": "天誅軍兵士", "srcs": ["script:186_24:0x2f80"]}, {"id": "script:5397", "jp": "<c2e/>竜蔵<c2e/>\\n<c31/>うむ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>龙藏<c2e/>\\n<c31/>嗯……\\n<c7/><WAIT><PAGE>", "meta": "竜蔵", "srcs": ["script:186_24:0x2faa"]}, {"id": "script:5398", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>須藤…竜蔵だな…?<c5/>\\n", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>须藤……你就是龙藏吧……？<c5/>\\n", "meta": "<NAME/>", "srcs": ["script:186_24:0x2fca"]}, {"id": "script:5399", "jp": "<c31/>お前ガ信じているものは、まやかしだ…\\n<c31/>踊らされるな…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你所相信的东西，不过是虚妄……\\n<c31/>别被它摆布了……\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x2ff2"]}, {"id": "script:5400", "jp": "<c2e/>竜蔵<c2e/>\\n<c31/>馬鹿者ガ…\\n", "zh": "<c2e/>龙藏<c2e/>\\n<c31/>蠢货……\\n", "meta": "竜蔵", "srcs": ["script:186_24:0x3034"]}, {"id": "script:5401", "jp": "<c31/>理想無き、罪汚れた今の世界こそガまやかしよ。\\n", "zh": "<c31/>没有理想、沾满罪污的如今这世界，才是虚妄。\\n", "srcs": ["script:186_24:0x3052"]}, {"id": "script:5402", "jp": "<c31/>ゆえに罰を与えるのだ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>正因如此，才要降下惩罚。\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x3084"]}, {"id": "script:5403", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>違う…<c5/>\\n", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>不对……<c5/>\\n", "meta": "<NAME/>", "srcs": ["script:186_24:0x30a6"]}, {"id": "script:5404", "jp": "<c31/>罰を受けるのは、俺一人でたくさんだ…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>要受罚的，有我一个人就够了……\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x30c2"]}, {"id": "script:5405", "jp": "<c2e/>克哉<c31/>パオフゥ<c2e/>\\n<c31/>須藤…竜蔵!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c31/>报复<c2e/>\\n<c31/>须藤……龙藏!!\\n<c7/><WAIT><PAGE>", "meta": "克哉<c31/>パオフゥ", "srcs": ["script:186_24:0x30f2"]}, {"id": "script:5406", "jp": "<c2e/>竜蔵<c2e/>\\n<c31/>惜しい…実に惜しい。\\n", "zh": "<c2e/>龙藏<c2e/>\\n<c31/>可惜……实在可惜。\\n", "meta": "竜蔵", "srcs": ["script:186_24:0x3124"]}, {"id": "script:5407", "jp": "<c31/>今の世の中で、諸君のような目的意識を持った\\n<c31/>若人ガどれほどいよう…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>如今这世上，像诸君这般怀有明确志向的\\n<c31/>年轻人又有多少……\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x314c"]}, {"id": "script:5408", "jp": "<c2e/>竜蔵<c2e/>\\n<c31/>儂の元へ来い。\\n", "zh": "<c2e/>龙藏<c2e/>\\n<c31/>来老夫麾下吧。\\n", "meta": "竜蔵", "srcs": ["script:186_24:0x319c"]}, {"id": "script:5409", "jp": "<c31/>共に、無原罪の光り輝く王道楽土を打ち立てよう\\n<c31/>ではないか。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>与老夫一同，建立那无原罪、光辉灿烂的王道乐土\\n<c31/>不好吗。\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x31be"]}, {"id": "script:5410", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>なんだとお…<c5/>\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>你说什么……<c5/>\\n<c7/><WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["script:186_24:0x3206"]}, {"id": "script:5411", "jp": "<c2e/>エリー<c2e/>\\n<c31/>よく言えたものですわ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>亏你还说得出口……\\n<c7/><WAIT><PAGE>", "meta": "エリー", "srcs": ["script:186_24:0x3234"]}, {"id": "script:5412", "jp": "<c2e/>南条<c2e/>\\n<c31/>抜け抜けと…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>南条<c2e/>\\n<c31/>居然还能说得这么若无其事……\\n<c7/><WAIT><PAGE>", "meta": "南条", "srcs": ["script:186_24:0x3266"]}, {"id": "script:5413", "jp": "<c2e/>うらら<c2e/>\\n<c31/>冗談じゃないっての!\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>少开玩笑了!\\n", "meta": "うらら", "srcs": ["script:186_24:0x328c"]}, {"id": "script:5414", "jp": "<c31/>ジジィの妄想なんかに付き合ってられるか!\\n<c7/><WAIT><PAGE>", "zh": "<c31/>谁要陪个老头子的妄想胡闹啊!\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x32b6"]}, {"id": "script:5415", "jp": "<c2e/>克哉<c2e/>\\n<c31/>貴様の罪は内乱罪さえ適用される…\\n<c31/>刑の重さを知ってるか?\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>你的罪行连内乱罪都适用得上……\\n<c31/>你知道会判多重吗?\\n", "meta": "克哉", "srcs": ["script:186_24:0x32ea"]}, {"id": "script:5416", "jp": "<c31/>死刑又は無期禁錮だ!\\n<c7/><WAIT><PAGE>", "zh": "<c31/>死刑，或者无期监禁!\\n<c7/><WAIT><PAGE>", "srcs": ["script:186_24:0x3338"]}, {"id": "script:5417", "jp": "<c2e/>竜蔵<c2e/>\\n<c31/>そうか…残念だ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>龙藏<c2e/>\\n<c31/>这样吗……真遗憾。\\n<c7/><WAIT><PAGE>", "meta": "竜蔵", "srcs": ["script:186_24:0x3358"]}, {"id": "script:5418", "jp": "<c2e/>克哉<c2e/>\\n<c31/>待て!<c31/>竜蔵!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>站住!<c31/>龙藏!!\\n<c7/><WAIT><PAGE>", "meta": "克哉", "srcs": ["script:186_24:0x3382"]}, {"id": "script:5419", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>一機は俺ガやる…!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>一架由我来解决……!\\n<c7/><WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["script:186_24:0x33ac"]}, {"id": "script:5420", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>どけぇぇぇぇ!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>给我闪开啊啊啊啊!!\\n<c7/><WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["script:186_24:0x33d6"]}]