[{"id": "script:5166", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>鍵ガ開いてるぜ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>锁开着啊……\\n<c7/><WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["script:174_26:0x10f8"]}, {"id": "script:5167", "jp": "<c2e/>うらら<c2e/>\\n<c31/>この中入ったの…?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>进到这里面去了……？\\n<c7/><WAIT><PAGE>", "meta": "うらら", "srcs": ["script:174_26:0x1126"]}, {"id": "script:5168", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>ったく手間かけさせるぜ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>真是的，净给人添麻烦……\\n<c7/><WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["script:174_26:0x1154"]}]