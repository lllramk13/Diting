[{"id": "script:261_42:0x12cc", "jp": "<c2e/>麻希<c2e/>\\n<c31/>行っちゃったね…南条君。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>麻希<c2e/>\\n<c31/>走掉了呢……南条。\\n<c7/><WAIT><PAGE>", "speaker_jp": "麻希", "dup": null}, {"id": "script:261_42:0x12fe", "jp": "<c2e/>ピアスの少年<c2e/>\\n<c31/>実は、俺もしばらくみんなと会えなくなる。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>耳环少年<c2e/>\\n<c31/>其实，我也有一阵子见不到大家了。\\n<c7/><WAIT><PAGE>", "speaker_jp": "ピアスの少年", "dup": null}, {"id": "script:261_42:0x1348", "jp": "<c2e/>麻希<c2e/>\\n<c31/>ええっ!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>麻希<c2e/>\\n<c31/>哎哎!?\\n<c7/><WAIT><PAGE>", "speaker_jp": "麻希", "dup": null}, {"id": "script:261_42:0x136c", "jp": "<c2e/>エリー<c2e/>\\n<c31/>ど、どうしてですの!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>为、为什么呢!?\\n<c7/><WAIT><PAGE>", "speaker_jp": "エリー", "dup": null}, {"id": "script:261_42:0x139e", "jp": "<c2e/>エリー<c2e/>\\n<c31/>そうですの…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>这样啊……\\n<c7/><WAIT><PAGE>", "speaker_jp": "エリー", "dup": null}, {"id": "script:261_42:0x13c6", "jp": "<c2e/>麻希<c2e/>\\n<c31/>…あ、あのね!<c5/>\\n", "zh": "<c2e/>麻希<c2e/>\\n<c31/>……啊、那个！<c5/>\\n", "speaker_jp": "麻希", "dup": null}, {"id": "script:261_42:0x13ec", "jp": "<c31/>英理子、モデルのオーディシヨンに\\n<c31/>合格したんだよね!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>英理子，在模特的试镜里\\n<c31/>通过了对吧!?\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:261_42:0x1430", "jp": "<c2e/>麻希<c2e/>\\n<c31/>夢の一歩を踏み出したってわけ!!\\n", "zh": "<c2e/>麻希<c2e/>\\n<c31/>这就算是朝梦想迈出第一步啦!!\\n", "speaker_jp": "麻希", "dup": null}, {"id": "script:261_42:0x1464", "jp": "<c31/>いいなぁ〜\\n<c7/><WAIT><PAGE>", "zh": "<c31/>真好啊～\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:261_42:0x147a", "jp": "<c2e/>麻希<c2e/>\\n<c31/>ほら、英理子…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>麻希<c2e/>\\n<c31/>你看，英理子……\\n<c7/><WAIT><PAGE>", "speaker_jp": "麻希", "dup": null}, {"id": "script:261_42:0x14a2", "jp": "<c2e/>エリー<c2e/>\\n<c31/>あ、あの…<c5/>\\n", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>啊、那个……<c5/>\\n", "speaker_jp": "エリー", "dup": null}, {"id": "script:261_42:0x14c6", "jp": "<c31/>私もガんばるから…あなたもガんばって…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我也会加油的……你也要加油……\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:261_42:0x14f8", "jp": "<c2e/>エリー<c2e/>\\n<c31/>次に…次に会う時は…<c5/>\\n", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>下次……下次再见的时候……<c5/>\\n", "speaker_jp": "エリー", "dup": null}, {"id": "script:261_42:0x1526", "jp": "<c31/>あなたガ見間違えるような女性になってみせますわ\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我一定会变成让你认不出来的女人给你看\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:261_42:0x1560", "jp": "<c2e/>ピアスの少年<c2e/>\\n<c31/>じゃあ、指切りだ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>耳环少年<c2e/>\\n<c31/>那就来拉钩吧。\\n<c7/><WAIT><PAGE>", "speaker_jp": "ピアスの少年", "dup": null}, {"id": "script:261_42:0x1594", "jp": "<c2e/>エリー<c2e/>\\n<c31/>………\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>………\\n<c7/><WAIT><PAGE>", "speaker_jp": "エリー", "dup": null}]