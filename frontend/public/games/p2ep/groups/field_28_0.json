[{"id": "field:28_0:raw:0x2054", "jp": "これでよろしいですか?\\n", "zh": "这样可以吗？\\n", "dup": "dup:5be65767da37"}, {"id": "field:28_0:raw:0x23ac", "jp": "はい\\n", "zh": "是\\n", "dup": "dup:4347ad605ec3"}, {"id": "field:28_0:raw:0x23b4", "jp": "いいえ\\n", "zh": "否\\n", "dup": "dup:7ccb4e445149"}, {"id": "field:28_0:raw:0x2212", "jp": "これ以上所持できません\\n", "zh": "已经不能再持有更多了\\n", "dup": "dup:4948fad308d2"}, {"id": "field:28_0:raw:0x1ea2", "jp": "これ以上は、ストックできません\\n", "zh": "已经不能再存放更多了\\n", "dup": "dup:bd42036699f0"}, {"id": "field:28_0:raw:0x1ec4", "jp": "召喚できるレベルではありません\\n", "zh": "还没到能召唤的等级\\n", "dup": "dup:bba9d0142a96"}, {"id": "field:28_0:raw:0x1ee6", "jp": "タロットカードガ足りません\\n", "zh": "塔罗牌不够\\n", "dup": "dup:1f181a870228"}, {"id": "field:28_0:raw:0x1f04", "jp": "同じペルソナガすでにいます\\n", "zh": "已经有相同的人格面具了\\n", "dup": "dup:066018402009"}, {"id": "field:28_0:raw:0x1f22", "jp": "相性ガ悪くて使えません\\n", "zh": "相性太差，无法使用\\n", "dup": "dup:b90c38936a12"}, {"id": "field:28_0:raw:0x1f3c", "jp": "降魔しているペルソナは外せません\\n", "zh": "正在降魔的人格面具无法取下\\n", "dup": "dup:34026ded2015"}, {"id": "field:28_0:raw:0x1f60", "jp": "相性ガ悪く降魔できません\\n", "zh": "相性太差，无法降魔\\n", "dup": "dup:e1b4da1e5f4b"}, {"id": "field:28_0:raw:0x1f7c", "jp": "降魔しているペルソナは削除できません\\n", "zh": "正在降魔的人格面具无法删除\\n", "dup": "dup:9575e4f5f224"}, {"id": "field:28_0:raw:0x1fa4", "jp": "降魔しているペルソナは変異できません\\n", "zh": "正在降魔的人格面具无法变异\\n", "dup": "dup:b576e8c7eaa0"}, {"id": "field:28_0:raw:0x1fcc", "jp": "方向キーで枚数を指定してください\\n", "zh": "请用方向键指定张数\\n", "dup": "dup:02c219fcd4ce"}, {"id": "field:28_0:raw:0x1ff0", "jp": "種族を選択してください\\n", "zh": "请选择种族\\n", "dup": "dup:af589b67f139"}, {"id": "field:28_0:raw:0x200a", "jp": "召喚するペルソナを選択してください\\n", "zh": "请选择要召唤的人格面具\\n", "dup": "dup:3cedf79a9d47"}, {"id": "field:28_0:raw:0x2030", "jp": "加えたいカードを選択してください\\n", "zh": "请选择想加入的卡片\\n", "dup": "dup:3dd5105e1b3e"}, {"id": "field:28_0:raw:0x206e", "jp": "入れ替えるペルソナを選択してください\\n", "zh": "请选择要替换的人格面具\\n", "dup": "dup:d44ea209d95e"}, {"id": "field:28_0:raw:0x2096", "jp": "ペルソナを削除します\\n", "zh": "将删除人格面具\\n", "dup": "dup:d9c34a77fb11"}, {"id": "field:28_0:raw:0x20ae", "jp": "削除するペルソナを選択してください\\n", "zh": "请选择要删除的人格面具\\n", "dup": "dup:5c0266baf0e1"}, {"id": "field:28_0:raw:0x20d4", "jp": "削除してよろしいですか?\\n", "zh": "要删除吗?\\n", "dup": "dup:517dd4ab8857"}, {"id": "field:28_0:raw:0x20f0", "jp": "生まれ変わらせるペルソナを選択してください\\n", "zh": "请选择要使其转生的人格面具\\n", "dup": "dup:ce5450740ee3"}, {"id": "field:28_0:raw:0x211e", "jp": "このペルソナに変異します:○ボタンで決定\\n", "zh": "将变异为这个人格面具：按○键决定\\n", "dup": "dup:c9e4e20b1d35"}, {"id": "field:28_0:raw:0x214a", "jp": "方向キー左右で枚数指定 ○ボタンで決定\\n", "zh": "用方向键左右指定张数　按○键决定\\n", "dup": "dup:e82568156ee5"}, {"id": "field:28_0:raw:0x2174", "jp": "召喚されるペルソナです:○ボタンで決定\\n", "zh": "将要召唤的人格面具：按○键决定\\n", "dup": "dup:bb66a7f076b3"}, {"id": "field:28_0:raw:0x219e", "jp": "他のメンバーガ降魔しています\\n", "zh": "其他成员正在降魔\\n", "dup": "dup:dcb90135128c"}, {"id": "field:28_0:raw:0x21be", "jp": "フリータロットガありません\\n", "zh": "没有自由塔罗牌\\n", "dup": "dup:75d9caa8b7a1"}, {"id": "field:28_0:raw:0x21dc", "jp": "すでに降魔しています\\n", "zh": "已经降魔过了\\n", "dup": "dup:3506018f055d"}, {"id": "field:28_0:raw:0x21f4", "jp": "フリータロットガ足りません\\n", "zh": "自由塔罗牌不够\\n", "dup": "dup:137af9fb48b3"}, {"id": "field:28_0:raw:0x222c", "jp": "離脱した仲間ガ同じペルソナを降魔中です\\n", "zh": "离队的同伴正在降魔相同的人格面具\\n", "dup": "dup:f41c7a9b6fab"}]