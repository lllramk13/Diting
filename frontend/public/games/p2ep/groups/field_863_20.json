[{"id": "field:14910", "jp": "<c2e/>克哉<c2e/>\\n <ce/>さん…\\n まずは、君の同時刻におけるアリバイを\\n 聞かせてもらいたいな…\\n<WAIT><PAGE>", "zh": "", "meta": "克哉", "srcs": ["field:863_20:dec:0x292", "field:863_102:dec:0xb6e", "field:863_104:dec:0xa98", "field:863_110:dec:0x964", "field:863_271:dec:0x9f8", "field:863_283:dec:0xe44", "field:863_283:dec:0xfa4", "field:863_285:dec:0x9d8", "field:863_287:dec:0x8b8", "field:863_290:dec:0x2fc", "field:863_291:dec:0x2fc", "field:863_292:dec:0x2fc"]}, {"id": "field:14911", "jp": "<c2e/>克哉<c2e/>\\n ほう…それは妙だな…\\n 君は今、犯人しか知らない事を口にした。\\n 気ガついたかな…\\n<WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n 哦……那可真奇怪啊……\\n 你刚才说出了只有犯人才知道的事。\\n 你注意到了吗……\\n<WAIT><PAGE>", "meta": "克哉", "srcs": ["field:863_20:dec:0x2f6", "field:863_102:dec:0xc26", "field:863_104:dec:0xafc", "field:863_110:dec:0x9c8", "field:863_271:dec:0xa5c", "field:863_283:dec:0xea8", "field:863_283:dec:0x105c", "field:863_285:dec:0xa3c", "field:863_287:dec:0x970", "field:863_290:dec:0x360", "field:863_291:dec:0x360", "field:863_292:dec:0x360"]}, {"id": "field:14912", "jp": "「そんな女は知らない」と。\\n 妙だね…<cb/><c7/>女性とは一言も言っていないんだガ…<c7/>\\n<WAIT><PAGE>", "zh": "「不认识那种女人」，是吗。\\n真奇怪呢……<cb/><c7/>我可一句都没说过对方是女性啊……<c7/>\\n<WAIT><PAGE>", "srcs": ["field:863_20:dec:0x39a", "field:863_102:dec:0xd16", "field:863_104:dec:0xba0", "field:863_110:dec:0xa6c", "field:863_271:dec:0xb00", "field:863_283:dec:0xf4c", "field:863_283:dec:0x114c", "field:863_285:dec:0xae0", "field:863_287:dec:0xa60", "field:863_290:dec:0x404", "field:863_291:dec:0x404", "field:863_292:dec:0x404"]}]