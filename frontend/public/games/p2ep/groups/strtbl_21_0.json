[{"id": "strtbl:21_0:raw:0x2b2c#5", "jp": "これでよろしいですか?\\n", "zh": "这样可以吗？\\n", "dup": "dup:5be65767da37"}, {"id": "strtbl:21_0:raw:0x2b2c#1", "jp": "アイテムの種類を選択してください\\n", "zh": "请选择道具种类\\n", "dup": "dup:db500b6984f6"}, {"id": "strtbl:21_0:raw:0x2b2c#2", "jp": "この種類のアイテムはありません\\n", "zh": "没有这一类道具\\n", "dup": "dup:c228f2fa07db"}, {"id": "strtbl:21_0:raw:0x2b2c#3", "jp": "方向キー左右で個数指定 ○ボタンで決定\\n", "zh": "用方向键左右选择数量　按○键确定\\n", "dup": "dup:8d0dc5c90230"}, {"id": "strtbl:21_0:raw:0x2b2c#4", "jp": "そのアイテムは売却できません\\n", "zh": "该道具无法出售\\n", "dup": "dup:29d19f7460ce"}, {"id": "strtbl:21_0:raw:0x2b2c#6", "jp": "これ以上は所持していません\\n", "zh": "持有数量已经没有更多了\\n", "dup": "dup:b8d8d9bbe45d"}, {"id": "strtbl:21_0:raw:0x2b2c#7", "jp": "所持金制限を上回る売却はできません\\n", "zh": "无法出售超过持有金上限的金额\\n", "dup": "dup:731880b1f254"}, {"id": "strtbl:21_0:raw:0x2b2c#0", "jp": " \\n", "zh": "", "dup": "dup:172c6338055f"}]