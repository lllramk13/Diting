[{"id": "script:69_24:0x174c", "jp": "<c2e/>うらら<c2e/>\\n<c31/>あ、あそこあそこ!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>啊、在那边在那边！\\n<c7/><WAIT><PAGE>", "speaker_jp": "うらら", "dup": null}, {"id": "script:69_24:0x177a", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>レイディ、お前は俺の仲間だ。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>小姐，你是我的同伴。\\n", "speaker_jp": "JOKER", "dup": null}, {"id": "script:69_24:0x17b0", "jp": "<c31/>迎えに来たんだよ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我是来接你的。\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:69_24:0x17ce", "jp": "<c2e/>杏奈<c2e/>\\n<c31/>あんたなんか知らない…\\n", "zh": "<c2e/>杏奈<c2e/>\\n<c31/>我根本不认识你……\\n", "speaker_jp": "杏奈", "dup": null}, {"id": "script:69_24:0x17f8", "jp": "<c31/>私は、JOKER呪いなんかしてない…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我、我根本没下什么JOKER诅咒……\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:69_24:0x1828", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>心配するこたねぇ。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>别担心。\\n", "speaker_jp": "JOKER", "dup": null}, {"id": "script:69_24:0x18dc", "jp": "<c31/>悪いようにはしねぇ、一緒に来い。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>不会把你怎么样的，跟我来吧。\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:69_24:0x1908", "jp": "<c2e/>克哉<c2e/>\\n<c31/>501号、その子から離れろ!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>501号，离那孩子远点！\\n<c7/><WAIT><PAGE>", "speaker_jp": "克哉", "dup": null}, {"id": "script:69_24:0x193e", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>邪魔すんじゃねぇ!!\\n<c31/>てめぇらはそいつらの相手でもしてろお!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>少来碍事!!\\n<c31/>你们几个就去陪那些家伙玩玩吧!!\\n<c7/><WAIT><PAGE>", "speaker_jp": "JOKER", "dup": null}, {"id": "script:69_24:0x1854", "jp": "<c31/>俺の事も「向こう側」の事も、すぐにわかる。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我的事也好，“那一边”的事也好，你很快就会明白。\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:69_24:0x188a", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>そうすりゃお前も、\\n<c31/>「こっち側」ガ間違いだって気づく。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>到那时，你也会明白，\\n<c31/>“这一边”才是错的。\\n", "dup": null}]