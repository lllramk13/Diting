[{"id": "field:863_157:dec:0x524", "jp": "<c2e/><NAME/><c2e/>\\n この女には、指一本触れさせない…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我绝不会让你碰这女人一根手指……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:34839fba6793"}, {"id": "field:863_157:dec:0x55a", "jp": "<c2e/><NAME/><c2e/>\\n 俺は、あんたを守る為にここに来た…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我是为了保护你才来到这里的……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:0e2647a78a71"}, {"id": "field:863_157:dec:0x598", "jp": "<c2e/><NAME/><c2e/>\\n どうしてもやる気か…?\\n <cb/><c7/>なら…死ぬ気で来い。<c7/>\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你铁了心要动手吗……？\\n <cb/><c7/>那就……拼死来吧。<c7/>\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:9f8a3c5bc837"}, {"id": "field:863_157:dec:0x5e4", "jp": "<c2e/><NAME/><c2e/>\\n 貴様…よくも…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你这家伙…竟敢…\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:6865d3d472c4"}, {"id": "field:863_157:dec:0x608", "jp": "<c2e/><NAME/><c2e/>\\n 俺を怒らせたな…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你把我惹火了……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:1bb2e735eda9"}, {"id": "field:863_157:dec:0x62e", "jp": "<c2e/><NAME/><c2e/>\\n 貴様は殺す…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我要宰了你……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:aa244859a9bd"}]