[{"id": "script:13909", "jp": "<c2e/>扉のむこうの声<c2e/>\\n<c31/>「夢」の正体を暴きなさい。\\n<WAIT><PAGE>", "zh": "<c2e/>门另一侧的声音<c2e/>\\n<c31/>把“梦”的真面目揭穿吧。\\n<WAIT><PAGE>", "meta": "扉のむこうの声", "srcs": ["script:735_243:0x1bc"]}, {"id": "script:13910", "jp": "フィレモン\\n", "zh": "费列蒙\\n", "srcs": ["script:735_243:0x1f8", "field:835_0:raw:0x12754", "field:838_0:dec:0x12754", "field:857_0:raw:0x465c", "strtbl:835_0:raw:0x12304#57"]}]