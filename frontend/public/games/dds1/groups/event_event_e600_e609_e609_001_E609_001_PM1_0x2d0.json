[{"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0120", "jp": "来るな", "zh": "别过来", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NARU0150", "jp": "ハーリー\nこの力は一体何なの!?", "zh": "哈利 这力量到底是什么！？", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0130", "jp": "そんなことはどうでもいい\nあの女は一体何者だ ", "zh": "那种事无所谓 那个女人到底是什么人", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0090", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0140", "jp": "女? や やめてくれ\n俺は何も 何も知らねぇ", "zh": "女人？不，住手。我什么都不知道，什么都不知道。", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0100", "jp": "なぜ知らない", "zh": "为什么不知道？", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0150", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0111", "jp": "他にはお前たちしかいなかった\nあの娘は何者だ なぜあんな所にいた", "zh": "除了你们没有别人了。那女孩是什么人？为什么会在那种地方？", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0112", "jp": "答えろ ハーリー", "zh": "回答我，哈利。", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0113", "jp": "なんでこうも\nあの娘のことが気になるんだ!?", "zh": "为什么我这么在意那个女孩！？", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0160", "jp": "や やめ\n本当に何も知ら", "zh": "不，住手。我真的什么都不知道……", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHET0120", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0170", "jp": "そう か\nいっこだけ わかったぜ", "zh": "是吗？我只明白了一件事。", "dup": null}, {"id": "pm1:event/e600/e609/e609_001/E609_001.PM1@0x2d0#NHAR0180", "jp": "喰われる前に\n喰っちまえばいいんだよなぁ!", "zh": "在被吃掉之前，先吃掉对方不就好了吗！", "dup": null}]