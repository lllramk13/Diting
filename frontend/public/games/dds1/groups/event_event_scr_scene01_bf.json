[{"id": "bf:event/scr/scene01.bf#M01_01", "jp": "エーイチ、エーイチ…\n目を覚ますのだ…\nデビルハーツを持つ者として\n再びこの黒東京に覚醒するのだ…", "zh": "", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_02", "jp": "おお、気付いたか…\n我が名はアナト。\n栄えあるオリエントの地母神だ。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_03", "jp": "お前の噂は聞いておる。\nなかなか腕が立つそうじゃないか…\nその腕を見込んで、一つ頼みがある。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_04_01", "jp": "日本の主神、アマテラスのことだ。\n最近、アマテラスの周辺に\n不穏な動きがあると聞く。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_04_02", "jp": "なんでも…\n神器『草薙の剣』を探し出し\n黒東京を我が物にせんと企んでいるらしい", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_05", "jp": "そこで、だ。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_06", "jp": "上野動物園にいるアマテラスを捜し出し…", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_07", "jp": "その息の根を止めて欲しい!\nお前には易い仕事だろう。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene01.bf#M01_08", "jp": "では、頼んだぞ…", "zh": "", "speaker_jp": "アナト", "dup": null}]