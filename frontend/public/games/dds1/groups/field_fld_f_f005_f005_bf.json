[{"id": "bf:fld/f/f005/f005.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f005/f005.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f005/f005.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f005/f005.bf#heat_001_01", "jp": "ここじゃブルーティッシュに近すぎる\nセラはかくまえねぇぞ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_001_02a", "jp": "楽園ってな どんなところかだぁ?\nそら セラがいて…\n空も海も すげぇ青くて…\nお前も アルジラも シエロもいて…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_001_02b", "jp": "なんだ… 俺は何言ってる…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_001_03", "jp": "セラがいなけりゃ\nニルヴァーナもクソもねぇだろうが!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_01", "jp": "このクソ忙しい時に\nどこの馬鹿どもの仕業だ!?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f4b1fbd2c465"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_02a", "jp": "今さらどうこうしたって\n喰われちまった奴らは 帰っちゃこねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:eb45c87e6a49"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_02b", "jp": "早くセラを追いかけねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f03dd8984d82"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_03a", "jp": "この お人好しが…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:2332f206ba88"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_03b", "jp": "やるならとっととケリ着けるぞ!\n早く決めねぇか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:e4890539ec73"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_04", "jp": "セラ 早まるんじゃねぇぞ…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:7aba97c4d6ed"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_05a", "jp": "とんだ時間喰っちまった", "zh": "", "speaker_jp": "ヒート", "dup": "dup:960e30ba2bcf"}, {"id": "bf:fld/f/f005/f005.bf#heat_SISEI_05b", "jp": "もう こんなとこに用はねぇ\nさっさと行かねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:5ce583ea6c37"}, {"id": "bf:fld/f/f005/f005.bf#aljira_001_01", "jp": "ジナーナ もう雲に昇ったのかしら", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_001_02a", "jp": "ニルヴァーナか\n行けば何かが変わるよね", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_001_02b", "jp": "ジナーナ…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:f30e5564a1dd"}, {"id": "bf:fld/f/f005/f005.bf#aljira_001_03", "jp": "ニルヴァーナに行けば全て終わる\nそう思ってきたけど…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_01", "jp": "誰もいない まさか…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c2881842ab73"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_02", "jp": "早くセラを追いかけないといけないのに!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:622267581851"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_03a", "jp": "やっぱり こんな力必要ないわよね…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:af0c94b41bf4"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_03b", "jp": "こんなの欲しがる奴は\n最後の一人になるまで殺し合えばいいのよ!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:99c156c4dbc8"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_04a", "jp": "もう3人倒したけど\n残りの一箇所にボスがいるってこと?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:d1f4d197e98d"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_04b", "jp": "なんか ひっかからない?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:2a8c238aba58"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_05a", "jp": "もう一度あの塔を登ろう サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:b74bda12691b"}, {"id": "bf:fld/f/f005/f005.bf#aljira_SISEI_05b", "jp": "雲の上で見下ろしてる奴らの横っ面\nえぐってやらなきゃ 気がすまない", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:6fa61c0dc926"}, {"id": "bf:fld/f/f005/f005.bf#gale_001_01", "jp": "ここもか\nソリッドの戦力は\nあてにしていたのだがな", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_001_02", "jp": "ニルヴァーナを目指す事は掟だ\n理由など必要ない…はずだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_001_03a", "jp": "ニルヴァーナを目指す事は掟だった\n理由など必要ないはずだった\nだが 今は俺にも他の理由ができた", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_001_03b", "jp": "行けばわかるはずだ\nあの女が何者か 俺が何者なのかも", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_001_04", "jp": "終わりというやつは\n始まりに過ぎんのかもしれん", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_01a", "jp": "喰われたか 逃げたか", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8abd5136ee4f"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_01b", "jp": "いずれにせよ 報告は真実のようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:338c61978ffb"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_02a", "jp": "対処せずとも 大勢には影響あるまいが…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:842b66c0b5b3"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_02b", "jp": "斃されたやつらも\n一緒に戦ってきた仲間だ\nとむらい方 というものもある", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8a4c4390805a"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_03", "jp": "俺たちが勝てば 争いは無くなる\nいつからか\nどこかで そう期待していたのだがな…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:9197aba90fc1"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_04", "jp": "悠長にしている時間はない\nやるなら 一気に片付けろ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:b00dc20be6b4"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_05a", "jp": "この世界のこと 俺たちのこと\nセラがすべてを知っている", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:4eb7ee31b65e"}, {"id": "bf:fld/f/f005/f005.bf#gale_SISEI_05b", "jp": "教会へ向かうぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:07975510f563"}, {"id": "bf:fld/f/f005/f005.bf#ciero_001_01", "jp": "なんかオレ\nアイツらと気ぃ合いそうだわ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#ciero_001_02", "jp": "ニルヴァーナって\n一番殺したヤツが辿り着く場所なんだよな\nそれって 本当に楽園って言えんのか?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#ciero_001_03a", "jp": "ニルヴァーナか", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#ciero_001_03b", "jp": "きっと楽しい所なんだよな 兄貴…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#ciero_SISEI_01", "jp": "今ごろなんだってんだよ\nもうオレらの勝ちでケリ着いてんだぜ!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:b8c4e720f0aa"}, {"id": "bf:fld/f/f005/f005.bf#ciero_SISEI_02", "jp": "どうする 兄貴!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:c97266898618"}, {"id": "bf:fld/f/f005/f005.bf#ciero_SISEI_03", "jp": "教会とも戦わなくちゃいけないってのに\nたまんねっつーの", "zh": "", "speaker_jp": "シエロ", "dup": "dup:7a150d0de18a"}, {"id": "bf:fld/f/f005/f005.bf#ciero_SISEI_04", "jp": "襲われたの 4ヶ所だったよな\nあいつらのボスってな\n一体どこにいるんだ?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2d3abf68b6c5"}, {"id": "bf:fld/f/f005/f005.bf#ciero_SISEI_05", "jp": "せっかく 他の仲間も\nニルヴァーナ行けるとこだったのにな…", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2c2fa0440875"}, {"id": "bf:fld/f/f005/f005.bf#sera_001_01", "jp": "減びたものは雲に昇って雨になる\nそれがこの世界のルール\nだけど… 頭がいたい…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#sera_001_02", "jp": "私には みんながいるここが楽園\nここしか ないの…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc01_001_01", "jp": "諦めの悪いヤツらが\nまだ城砦の中でねばってるぜ\n気をつけなよ ブラザー", "zh": "", "speaker_jp": "元ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc02_001_01a", "jp": "ノリのいいトライブに従った方が\n得ってもんよね", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc02_001_01b", "jp": "よろしく ボス", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc02_001_02", "jp": "楽園ってさ どんな場所だと思う?\nなんかさ 変わらない気がしない?\n私らがこのまんまな限りさ", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc02_001_03a", "jp": "いよいよニルヴァーナ行きか\nついに来ちまったんだね…", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc02_001_03b", "jp": "アタシはいいや 遠慮しとく\n誰かが言うんだ ここに居とけって", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc03_001_01", "jp": "OK YO MEN\n降参 降参!", "zh": "", "speaker_jp": "元ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc03_001_02", "jp": "YO MEN\nどうしてニルヴァーナに行くんだい?", "zh": "", "speaker_jp": "元ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_01a", "jp": "どうも気にいらねぇ…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_01b", "jp": "理由? そんなもん知るかよ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_02", "jp": "やっぱり喰らってやりゃ良かったんだ\nもったいねぇ…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_03a", "jp": "起きちまったことを\n後からウダウダ考えても仕方ねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_03b", "jp": "あいつに そう言ってやれ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_05a", "jp": "直にあの城砦も お前のもんにしてやる", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#heat_05b", "jp": "だから今はセラのことだけ考えろ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_01", "jp": "ジナーナの作戦しかなさそうね\nサーフ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_02a", "jp": "ジナーナ…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:f30e5564a1dd"}, {"id": "bf:fld/f/f005/f005.bf#aljira_02b", "jp": "ごめんなさい 頭を切り替えなきゃね", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_03a", "jp": "バットを殺さなかったから\nジナーナと仲間になれた\nバットを殺してれば\nジナーナは死なずに済んだ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_03b", "jp": "一体 どっちがよかったの…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_04", "jp": "何グダグダ講釈たれてるのアンタたち!?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#aljira_05", "jp": "アナタ ここそんなに好きなの?\n意味ないと思うんだけど", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_01", "jp": "ミックはマニプラへ侵攻中だ\nここへ来る理由はない\n理解不能だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_02", "jp": "現在ここに来たところで\n戦略的にも戦術的にも何ら意味はない\nバットの陽動の目的は敵本隊がセラを\n奪取するまで我々を遅滞することにあった\nすなわち現在時間は敵に有利に作用する\nだけであり我々に利することは何一つない\nよって今は一刻も早くセラの安否とミック\nの動向に関する情報を掴むことが肝要であ\nりそのための迅速な行動が求められる\nとどのつまりは\n早くアジトに戻れということだ\n理解できたか サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_02_SEL", "jp": "理解できた理解不能だ", "zh": "", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_02_ans0", "jp": "では\n可及的速やかにアジトへ戻るべきだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_02_ans1", "jp": "そうか では再度進言する\n現在ここに来たところで\n戦略的にも戦術的にも なんら意味はない\nバットの陽動の目的は 敵本隊がセラを\n奪取するまで我々を遅滞することにあった\nすなわち現在時間は敵に有利に作用する\nだけであり我々に利することは何一つない\nよって今は一刻も早くセラの安否とミック\nの動向に関する情報を掴むことが肝要であ\nりそのための迅速な行動が求められる\nとどのつまりは\n早くアジトに戻れということだ\n理解できたかサーフ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_04", "jp": "今は可及的速やかにアジトに戻るべきだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_03", "jp": "再三に渡って進言しているが\n現在ここに来たところで意味はない\n意味がなければ行くところも変わってくる\n我々が行かねばならないのは 136\nお前が来たのは シタデルだ\n136とシタデル 136とシタデル\n理解しているか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_03_SEL", "jp": "理解している理解不能だ", "zh": "", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_03_ans0", "jp": "では\n可及的速やかに136へ向かうべきだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_03_ans1", "jp": "そうか では再度進言する\n現在ここに来たところで意味はない\n意味がなければ行くところも変わってくる\n我々が行かねばならないのは 136\nお前が来たのは シタデルだ\n136とシタデル 136とシタデル\n理解しているか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#gale_05", "jp": "今は可及的速やかに136に向かうべきだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#jinana_01", "jp": "ミックは お前たちとジナーナが\n組んだことを知らない\n警戒は正面に集中するはずだ", "zh": "", "speaker_jp": "ジナーナ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#npc_002_05_01", "jp": "ソリッドの中には\n一撃で敵を倒す技を得た者もいる\n侮るな", "zh": "", "speaker_jp": "ジナーナ", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f005/f005.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f005/f005.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f005/f005.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f005/f005.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f005/f005.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f005/f005.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f005/f005.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f005/f005.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f005/f005.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f005/f005.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f005/f005.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f005/f005.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f005/f005.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f005/f005.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f005/f005.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f005/f005.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f005/f005.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f005/f005.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f005/f005.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f005/f005.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f005/f005.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f005/f005.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f005/f005.bf#MISSILE", "jp": ">外部からの侵攻に備えた\n砲台が設えてある……。", "zh": "", "dup": null}, {"id": "bf:fld/f/f005/f005.bf#GATE_DONT_OPEN", "jp": ">門は固く閉ざされている。", "zh": "", "dup": null}]