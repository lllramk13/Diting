[{"id": "bf:fld/f/f004/f004.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#GAIL_JOIN", "jp": ">ゲイルが\nパーティに加わった。", "zh": "", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f004/f004.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f004/f004.bf#heat_02", "jp": "力を見せろか 上等だ\n嫌ってほど見せつけてやろうじゃねぇか", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_03", "jp": "ボスがいねぇうちに\nこいつら 喰っちまおうってのか?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_02", "jp": "ジナーナを説得しないと…\n戦いに来たんじゃないのに", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_03", "jp": "そんなことする気なら\nあたしはエンブリオンを抜けるわ!", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_01_02", "jp": "たった3人で乗り込んで来るとは\nメリーベルも舐められたものだ", "zh": "", "speaker_jp": "メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_01_03", "jp": "アタシ アンタに…\nジナーナを頼む…ぞ", "zh": "", "speaker_jp": "メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_02_02", "jp": "死にたくなければ立ち去れ", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_02_03", "jp": "ジナーナの本隊はシタデルに向かった\n早く行け", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_03_02", "jp": "お前を倒せば メリーベルは3つの\nエリアを手に入れることができる", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_03_03", "jp": "ジナーナが戻るまで\nこの門を開けることはできない", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_04", "jp": "ミックが死んでも 抵抗を続けるか\n厄介なことだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_05", "jp": "なんなのだこいつらは\n理解不能だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_06", "jp": "以前は理解できなかったが…\n今なら なんとなく理解可能だ\n連中は 歌の種類について主張している\nそして 俺があの歌を好ましく思うことも", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_07a", "jp": "別の何者か…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_07b", "jp": "俺は こいつらに近いというのか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_01a", "jp": "喰われたか 逃げたか", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8abd5136ee4f"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_01b", "jp": "いずれにせよ 報告は真実のようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:338c61978ffb"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_02a", "jp": "対処せずとも 大勢には影響あるまいが…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:842b66c0b5b3"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_02b", "jp": "斃されたやつらも\n一緒に戦ってきた仲間だ\nとむらい方 というものもある", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8a4c4390805a"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_03", "jp": "俺たちが勝てば 争いは無くなる\nいつからか\nどこかで そう期待していたのだがな…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:9197aba90fc1"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_04", "jp": "悠長にしている時間はない\nやるなら 一気に片付けろ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:b00dc20be6b4"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_05a", "jp": "この世界のこと 俺たちのこと\nセラがすべてを知っている", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:4eb7ee31b65e"}, {"id": "bf:fld/f/f004/f004.bf#gale_SISEI_05b", "jp": "教会へ向かうぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:07975510f563"}, {"id": "bf:fld/f/f004/f004.bf#ciero_01", "jp": "一人オッサン具いのいるのな\nなんとなく…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#ciero_02a", "jp": "やっぱラテン・ハウスっしょ!", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#ciero_02b", "jp": "って… 兄貴なんのことだか知らねぇ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#ciero_03", "jp": "やっぱアイツ オッサンだぜ\n見た目あんななのにな\nなんでわかんのか ナゾだけど", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#ciero_SISEI_01", "jp": "今ごろなんだってんだよ\nもうオレらの勝ちでケリ着いてんだぜ!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:b8c4e720f0aa"}, {"id": "bf:fld/f/f004/f004.bf#ciero_SISEI_02", "jp": "どうする 兄貴!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:c97266898618"}, {"id": "bf:fld/f/f004/f004.bf#ciero_SISEI_03", "jp": "教会とも戦わなくちゃいけないってのに\nたまんねっつーの", "zh": "", "speaker_jp": "シエロ", "dup": "dup:7a150d0de18a"}, {"id": "bf:fld/f/f004/f004.bf#ciero_SISEI_04", "jp": "襲われたの 4ヶ所だったよな\nあいつらのボスってな\n一体どこにいるんだ?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2d3abf68b6c5"}, {"id": "bf:fld/f/f004/f004.bf#ciero_SISEI_05", "jp": "せっかく 他の仲間も\nニルヴァーナ行けるとこだったのにな…", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2c2fa0440875"}, {"id": "bf:fld/f/f004/f004.bf#npc_02_04", "jp": "つーか ソリッドどうなのよ!?\nまだ中でデカイ顔してるしよォ\nマジキレるっつーの", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:b5e1fdd756ed"}, {"id": "bf:fld/f/f004/f004.bf#npc_02_05", "jp": "つーか ソリッドどうなのよ!?\nまだ中でデカイ顔してるしよォ\nマジキレるっつーの", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:b5e1fdd756ed"}, {"id": "bf:fld/f/f004/f004.bf#npc_02_06", "jp": "つーか ソリッドどうなのよ!?\nまだ中でデカイ顔してるしよォ\nマジキレるっつーの", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:b5e1fdd756ed"}, {"id": "bf:fld/f/f004/f004.bf#npc_02_07", "jp": "なに言ってんだオヤジ\nウチらはパンクスだっつーの\nマジキレるっつーの", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_02_08a", "jp": "ライブって言え オヤジ", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_02_08b", "jp": "マジキレるっつーの", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_03_04", "jp": "オレたちゃアンタに従うぜ\nそこんとこヨロシク", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:bc885fc52642"}, {"id": "bf:fld/f/f004/f004.bf#npc_03_05", "jp": "オレたちゃアンタに従うぜ\nそこんとこヨロシク", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:bc885fc52642"}, {"id": "bf:fld/f/f004/f004.bf#npc_03_06", "jp": "オレたちゃアンタに従うぜ\nそこんとこヨロシク", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": "dup:bc885fc52642"}, {"id": "bf:fld/f/f004/f004.bf#npc_03_07", "jp": "人生はロックよロック\n転がる石 わかる?\nそこんとこヨロシク", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_03_08", "jp": "ボスのコンサートチケット取るの\n大変なわけよ わかる?\n人生と同じよ バトルよバトル\nそこんとこ ヨロシク", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_05_01", "jp": "ボスがジナーナを殺ったってことは\nここもオレらの縄張りってことだ\nソリッドを追い出しましょうぜ!", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_002_05_01a", "jp": "ソリッドの中には\n一撃で敵を倒す技を得た者もいる", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_002_05_01b", "jp": "侮るな", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#sera_01", "jp": "ね サーフ\nアルジラ ヤキモチ焼いてるよ", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#sera_02", "jp": "私 あの歌しか知らないから…\nいつも 誰かが寂しそうに歌ってた…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_04", "jp": "シエロの奴で\nほんとに大丈夫なんだろうな", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_06a", "jp": "肉がなに考えてようが 知ったことか", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_06b", "jp": "力づくで取り返しゃいいんだよ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_07", "jp": "くだらねぇ…\n行くぞ お前ら", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_08a", "jp": "俺は ブルースしか聞かねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_08b", "jp": "って…\nブルースってのは…なんだ?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_09a", "jp": "こんなとこにセラがいるわけねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_09b", "jp": "とにかく教会だ 行くぞサーフ!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_01", "jp": "このクソ忙しい時に\nどこの馬鹿どもの仕業だ!?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f4b1fbd2c465"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_02a", "jp": "今さらどうこうしたって\n喰われちまった奴らは 帰っちゃこねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:eb45c87e6a49"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_02b", "jp": "早くセラを追いかけねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f03dd8984d82"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_03a", "jp": "この お人好しが…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:2332f206ba88"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_03b", "jp": "やるならとっととケリ着けるぞ!\n早く決めねぇか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:e4890539ec73"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_04", "jp": "セラ 早まるんじゃねぇぞ…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:7aba97c4d6ed"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_05a", "jp": "とんだ時間喰っちまった", "zh": "", "speaker_jp": "ヒート", "dup": "dup:960e30ba2bcf"}, {"id": "bf:fld/f/f004/f004.bf#heat_SISEI_05b", "jp": "もう こんなとこに用はねぇ\nさっさと行かねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:5ce583ea6c37"}, {"id": "bf:fld/f/f004/f004.bf#gale_01", "jp": "狙いはミック一人だ\n雑魚を相手に損害を出す必要はない", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_02a", "jp": "完全に後手に回ったな", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_02b", "jp": "奴もミックも\nただのバカではないようだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_03a", "jp": "今ミックがお前を斃せば\nソリッドは一気にナンバー1の勢力となる\nハウンズやブルーティッシュが知れば\n黙って見過ごすはずがない\nが 今彼らの干渉を招いても\n事態は複雑化するだけだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#gale_03b", "jp": "我々だけで 迅速に片付ける他はない", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_04", "jp": "サーフ 準備はいい?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_05", "jp": "どうしよう\nあたしのせいだ…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_06", "jp": "ねぇ サーフ…\nセラが ミックの言うこと聞くと思う?\n自分たちの力が奪われる可能性もあるって\nあいつら考えてないのかな", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_07a", "jp": "何? あの女", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_07b", "jp": "腹立つ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_08", "jp": "ガッコー?\nそんなトライブ 聞いたこと…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#arujila_09", "jp": "あたしたちとゲイルの違いって\n一体なんなの…?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_01", "jp": "誰もいない まさか…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c2881842ab73"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_02", "jp": "早くセラを追いかけないといけないのに!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:622267581851"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_03a", "jp": "やっぱり こんな力必要ないわよね…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:af0c94b41bf4"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_03b", "jp": "こんなの欲しがる奴は\n最後の一人になるまで殺し合えばいいのよ!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:99c156c4dbc8"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_04a", "jp": "もう3人倒したけど\n残りの一箇所にボスがいるってこと?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:d1f4d197e98d"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_04b", "jp": "なんか ひっかからない?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:2a8c238aba58"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_05a", "jp": "もう一度あの塔を登ろう サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:b74bda12691b"}, {"id": "bf:fld/f/f004/f004.bf#aljira_SISEI_05b", "jp": "雲の上で見下ろしてる奴らの横っ面\nえぐってやらなきゃ 気がすまない", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:6fa61c0dc926"}, {"id": "bf:fld/f/f004/f004.bf#npc_01_04", "jp": "ジナーナが死に…縄張りも失った…\n皆の様子も…おかしい…じゃん?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": "dup:7626321aadb2"}, {"id": "bf:fld/f/f004/f004.bf#npc_01_05", "jp": "ジナーナが死に…縄張りも失った…\n皆の様子も…おかしい…じゃん?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": "dup:7626321aadb2"}, {"id": "bf:fld/f/f004/f004.bf#npc_01_06a", "jp": "アタシ アンタの追っかけすんの", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_01_06b", "jp": "喰っちゃってもいいよ", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_01_07", "jp": "前いたトライブ メリーベルだよねぇ\nガッコーってトライブ…知ってる?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": "dup:ea260a0a61fc"}, {"id": "bf:fld/f/f004/f004.bf#npc_01_09", "jp": "前いたトライブ メリーベルだよねぇ\nガッコーってトライブ…知ってる?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": "dup:ea260a0a61fc"}, {"id": "bf:fld/f/f004/f004.bf#npc_01_08a", "jp": "アタシん中に 誰かがいるんだよぉ\nガッコー 行きたくないって…\n競争したくないって…", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_01_08b", "jp": "助けてよぉ!", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#npc_04_01", "jp": "シエロがセラをガードしている\n心配無い", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f004/f004.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f004/f004.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f004/f004.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f004/f004.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f004/f004.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f004/f004.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f004/f004.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f004/f004.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f004/f004.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f004/f004.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f004/f004.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f004/f004.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f004/f004.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f004/f004.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f004/f004.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f004/f004.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f004/f004.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f004/f004.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f004/f004.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f004/f004.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f004/f004.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f004/f004.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f004/f004.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f004/f004.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f004/f004.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}, {"id": "bf:fld/f/f004/f004.bf#DONT_OPEN", "jp": ">ゲートは固く閉ざされている。", "zh": "", "dup": null}]