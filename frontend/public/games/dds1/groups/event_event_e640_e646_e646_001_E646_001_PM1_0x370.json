[{"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0720", "jp": "用件は", "zh": "什么事？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0020", "jp": "バロン打倒に力を貸して頂きたい", "zh": "希望您能助我一臂之力，打倒巴隆。", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0730", "jp": "条件は", "zh": "条件呢？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0031", "jp": "私とバロンの音だ", "zh": "是我和巴隆的声音。", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0032", "jp": "その代わり 部下には寛大な\n処置を場りたい", "zh": "作为交换，我想对部下给予宽大处理。", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NARU1060", "jp": "ゲイル!?", "zh": "盖尔！？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0740", "jp": "お前がバロンに与していないという証は\nどう立てる", "zh": "你怎么证明你没有站在巴隆那边？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0040", "jp": "誇りに賭けて", "zh": "我以我的骄傲", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0750", "jp": "誇り…?\n誇りとは 何だ", "zh": "骄傲…？骄傲是什么？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0050", "jp": "君の胸の内にあるものだ", "zh": "是你内心深处的东西。", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0761", "jp": "理解できん", "zh": "无法理解。", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NGIL0762", "jp": "なぜそんなことがわかる", "zh": "为什么你会知道那种事？", "dup": null}, {"id": "pm1:event/e640/e646/e646_001/E646_001.PM1@0x370#NLUP0060", "jp": "目を見れば わかる", "zh": "看你的眼睛就知道了。", "dup": null}]