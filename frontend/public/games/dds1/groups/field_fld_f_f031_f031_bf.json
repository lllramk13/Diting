[{"id": "bf:fld/f/f031/f031.bf#SWITH_ORNOT", "jp": ">スイッチがある。\n押しますか?", "zh": ">スイッチがある。\n押しますか?？", "dup": "dup:322be00c517a"}, {"id": "bf:fld/f/f031/f031.bf#SWITH_ORNOTSEL", "jp": "スイッチを押す押さない", "zh": "按下开关不按开关", "dup": "dup:74c2ee1720b9"}, {"id": "bf:fld/f/f031/f031.bf#SWITH_NO", "jp": ">サーフは\nそのままにした。", "zh": ">瑟夫\n就这样放着。", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#SERA_ZAN_MIE", "jp": ">セラの残像が見える…。", "zh": ">看到了塞拉的残像……。", "dup": "dup:53be3e212690"}, {"id": "bf:fld/f/f031/f031.bf#SERA_ZAN_MIETA", "jp": ">哀しげなセラの残像は消えた…。", "zh": ">神色哀伤的塞拉残像消失了……。", "dup": "dup:62925cf3005e"}, {"id": "bf:fld/f/f031/f031.bf#GARU", "jp": ">ここでガルーダとの戦闘。\nフィールドイベントこみ", "zh": ">在这里与迦楼罗战斗。\n包含场地事件", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#JTY", "jp": "\"てくのしゃーまん\"ハ\n門ノ開放ヲ望ンデイナイ", "zh": "\"科技萨满\"\n不希望打开门", "speaker_jp": "ジャターユ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#JTY_01", "jp": "即刻退去セヨ\n繰リ返ス 即刻退去セヨ", "zh": "立即撤离\n重复，立即撤离", "speaker_jp": "ジャターユ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#ANANTA", "jp": "\"てくのしゃーまん\"ノ言葉ヲ再生スル\n「みんな ごめんなさい\n 私 全部思い出した…」\n「これ以上 来てはダメ\n みんなにはここに居て欲しいの」\n「それが みんなのためだから…\n さようなら…今まで ありがとう…」\n以上ダ 即時退去セヨ", "zh": "播放“技师萨满”的留言\n「大家，对不起\n 我全都想起来了……」\n「别再到这里来了\n 我希望大家都留在这里」\n「那才是为了大家好……\n 永别了……至今为止，谢谢你们……」\n以上，立即撤退", "speaker_jp": "アナンタ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#ANANTA_BT", "jp": "デハ 強制排除スル", "zh": "那么，强制排除", "speaker_jp": "アナンタ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#GO_ORNOTSEL", "jp": "わかった…答えはだ", "zh": "明白了…答案就是", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#KOURYU_01", "jp": "どうやら四聖獣を倒したようだな…\nなるほど最強のトライブだけの事はある", "zh": "看来你们打败了四圣兽啊……\n果然是最强部落，名不虚传", "speaker_jp": "コウリュウ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#KOURYU_02", "jp": "構成員が強いのか…\nリーダーが強いのか…\nいずれにしても戦えば分かること\nそして貴様等を喰らい\nゆるりとニルヴァーナへと登るとしよう\nいざ勝負!", "zh": "是成员强……\n还是领袖强……\n无论如何，一战便知\n然后吞食你们\n悠闲地前往涅槃", "speaker_jp": "コウリュウ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#GRD_DEAD", "jp": ">カルマ教会ガードが無残に\n殺されている。", "zh": ">卡尔玛教会的守卫被残忍地\n杀害了。", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#KOURYUUNO_BIT", "jp": "コウリュウと戦うビットをオンにした!\nしたった!", "zh": "已开启与黄龙交战的开关！\n已开启！", "speaker_jp": "ウダ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_040_01", "jp": "守りが目に見えて厳重になっている\nここより奥へ進めば\n恐らく後へは退けないだろう", "zh": "守卫明显变得严密了 如\n果从这里继续\n深入 恐怕就无法后", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_040_01_SEL", "jp": "…もう少し考えさせてくれ覚悟はできている", "zh": "…再让我考虑一下，我已经做好觉悟了", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_040_01_ans0", "jp": "俺もだ\nヒートもアルジラもシエロも\n皆 同じ覚悟のはずだ\n行くぞ サーフ", "zh": "我也是\n希特、阿尔吉拉、希埃罗\n大家都怀着同样的觉悟\n走吧，瑟夫", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_040_01_ans1", "jp": "何か思うところがあるのか\nそれとも怖気づいたか\n多くの人々の助力があったからこそ\n俺たちは今 この場所にいる\nそれだけは忘れるな", "zh": "是有什么想法\n还是胆怯了\n正是因为许多人的相助\n我们此刻才站在这里\n这一点……", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#heat_038_01", "jp": "今更 後へなんか退けるかよ\n早く行け サーフ", "zh": "事到如今，怎么可能后退\n快走，瑟夫", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#arujila_038_01a", "jp": "アナタ 苦しんでるのよね…?", "zh": "你，很痛苦吧…？", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#arujila_038_01b", "jp": "待ってなさい セラ\nどんなに邪魔したって追いついてあげるわ", "zh": "等着我，塞拉\n不管你怎么妨碍，我都会追上你的", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_038_01", "jp": "守りが目に見えて厳重になっている\nここより奥へ進めば\n恐らく後へは退けないだろう\n覚悟して踏み込め サーフ", "zh": "防御明显变得严密了\n再往深处前进的话\n恐怕就无法后退了\n做好觉悟再踏入吧，瑟夫", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#ciero_038_01a", "jp": "ここに来るまでに見た 残像みたいなセラ\n泣きそうだったぜ…", "zh": "来这里的路上看到的，那个像残像一样的塞拉\n看起来快哭了……", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#ciero_038_01b", "jp": "放っておけねぇよ", "zh": "不能放着不管啊", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#heat_039_01a", "jp": "セラが危ねぇ…", "zh": "塞拉有危险…", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#heat_039_01b", "jp": "お前にはわからねぇのか!", "zh": "你难道不明白吗！", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#arujila_039_01a", "jp": "ジャンクヤードが… 消える…\nそんな…", "zh": "垃圾场……在消失……\n怎么会……", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#arujila_039_01b", "jp": "下にはまだ大勢仲間がいるのよ!?", "zh": "下面还有好多同伴啊！？", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_039_01", "jp": "これも… セラの仕業か!?", "zh": "这也是…塞拉搞的鬼吗！？", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_039_01_SEL", "jp": "俺はセラを信じるまさか…", "zh": "我相信塞拉…怎么可能…", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_039_01_ans0", "jp": "しかし こんな大それたことができるのは\nセラしか考えられん…\n他に セラに匹敵する力を持った者が\n現れたとでも言うのか サーフ!?", "zh": "但是，能干出这种大事的，除了塞\n拉我想不出别人\n……难道你要说，出现了其他\n能与塞拉匹敌的人吗，瑟夫", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#gale_039_01_ans1", "jp": "他に こんな力を持った者がいるか!?\n何があったというのだ セラ", "zh": "还有别人拥有这种力量！？\n到底发生了什么，塞", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#ciero_039_01", "jp": "マジやばいすよ!\n早く上行かないと\nオレらも消されちまうに <1727>!", "zh": "这下真糟了！\n不快点上去的话\n我们也会被抹掉的 <1727>！", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f031/f031.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": ">要去其他区域吗？", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f031/f031.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": ">瑟夫", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f031/f031.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": ">異様な物体が浮いている。\n触れてみますか?？", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f031/f031.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "没有去碰它。", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f031/f031.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": ">放弃了接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f031/f031.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": ">获得了[ ]个。", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": ">一个奇妙的物体端坐在那里\n。 要触摸它吗", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": ">放弃了接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": ">什么也没有发生。", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": ">获得了[ ]个。", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": ">获得了 个。 \n>似乎是教会正在寻找的传闻中的物质\n。 应该可以和<1727>交换吧", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": ">获得了魔货。", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": ">瑟夫等人受到了伤害。", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": ">瑟夫等人受到了伤\n害，并且中了毒", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": ">瑟夫等人受到了伤害\n，并且肚子坏了", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": ">Surf一行人受到了伤\n害，并且魔法被封印了", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f031/f031.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": ">里面是空的。", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f031/f031.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": ">发现了什么。\n…\n…获得了>", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f031/f031.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": ">在这里无法使用。", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f031/f031.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": ">由于太阳噪声降低，S\nurf一行\n人身上的不良状态消失了", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f031/f031.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": ">光的效果消失了。", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f031/f031.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": ">封魔的效果消失了。", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f031/f031.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": ">集魔的效果消失了。", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f031/f031.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": ">浮足的效果消失了。", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": ">请选择楼层。", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "取消", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "取消", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "取消", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "取消", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "放弃", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f031/f031.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "“科技萨满”并", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f031/f031.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": ">有一面奇妙的蓝色墙壁。\n似乎能用蓝色冰之钥匙破坏。", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f031/f031.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": ">有一面奇妙的红色墙壁。\n似乎能用红色冰之钥匙破坏。", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f031/f031.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": ">有一面奇妙的黄色墙壁。\n似乎能用黄色冰之钥匙破坏。", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f031/f031.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的蓝色墙壁。\n…现在还无法通过。", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f031/f031.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的红色墙壁。\n…现在还无法通过。", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f031/f031.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的黄色墙壁。\n…现在还无法通过。", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f031/f031.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": ">要破坏吗？", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f031/f031.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "不希望打开门。", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f031/f031.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "是/否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f031/f031.bf#DOOR_NOT", "jp": ">扉は固く閉ざされている。", "zh": ">门紧闭着。", "dup": "dup:10d600dbff4f"}, {"id": "bf:fld/f/f031/f031.bf#AYASIIKEHAI", "jp": ">扉の向こうから\n威圧感を感じる。\n>中に入りますか?", "zh": ">从门对面\n感受到压迫\n感。>要进去", "dup": null}]