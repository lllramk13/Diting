[{"id": "bf:event/scr/scene03.bf#TAKE_01", "jp": "神器は見つかりましたかな!", "zh": "神器找到了吗！", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_01", "jp": "焦んなくていいぜ…", "zh": "不用着急……", "speaker_jp": "スサノオ", "dup": null}, {"id": "bf:event/scr/scene03.bf#TAKE_02", "jp": "悪魔なり、机なり、ゴミ箱なり…\n聞けるものには何でも聞く!\nこれ、物事の基本ですぞ!", "zh": "武御雷，遵命！\n请让属下与您同行！", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_02", "jp": "見たとこアンタも日本人だろ?\n姉貴のために一肌脱ぐなんて\nすっげー名誉なことだぜ…", "zh": "哦……你就是啊一吗。\n听阿娜特提起过你。\n果然气势不凡。", "speaker_jp": "スサノオ", "dup": null}, {"id": "bf:event/scr/scene03.bf#TAKE_03", "jp": "そうです、そうです!\n大変名誉なことですぞ!", "zh": "属下就在此等候！\n请务必平安归来！", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_03", "jp": "…というわけだ。がんばってくれ。", "zh": "……就是这么回事。加油吧。", "speaker_jp": "スサノオ", "dup": null}]