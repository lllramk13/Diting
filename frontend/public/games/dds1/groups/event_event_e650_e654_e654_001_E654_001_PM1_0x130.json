[{"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NSIE0460", "jp": "お前…", "zh": "你…", "dup": "dup:fa7534759193"}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NSIE0470a", "jp": "そうだよ おかしいと思ってたんだ…", "zh": "没错，我一直觉得不对劲…", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NSIE0470b", "jp": "今まで 猫なんて見たことなかったんだ\n教わったことだって!", "zh": "至今为止，我从来没见过猫这种东西！就连学到的知识也是！", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NGIL0910a", "jp": "猫だけじゃない\n俺たちは 子も親も知っている", "zh": "不只是猫。我们既知道孩子，也知道父母。", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NGIL0910b", "jp": "だが どちらも\nジャンクヤードには存在しないんだ", "zh": "但这两者，在垃圾场里都不存在。", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NARU1170a", "jp": "みんな\nニルヴァーナの記憶だって言うの?", "zh": "大家都说，那是涅槃的记忆？", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NARU1170b", "jp": "あたしたちは一回死んで\nこのジャンクヤードに来た", "zh": "我们死过一次，来到了这个垃圾场。", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NARU1170c", "jp": "こんな身体になって 喰らいあって\nジナーナやルーパや仲間が大勢死んで…", "zh": "变成这副身体，互相吞噬，吉娜娜、鲁帕和许多同伴都死了…", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NARU1170d", "jp": "その全てにセラが\n関わってるって言うの!?", "zh": "你是说，这一切都跟塞拉有关吗！？", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NARU1170e", "jp": "一体 何のためなのよ!!", "zh": "到底是为了什么啊！！", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#NSIE0480", "jp": "わかんねぇよ!\nオレ 頭悪ぃし…", "zh": "我不知道！我脑子又笨…", "dup": null}, {"id": "pm1:event/e650/e654/e654_001/E654_001.PM1@0x130#SERANITUITE_SEL", "jp": "それがどうしたわかるはずがない…", "zh": "那又怎样，根本不可能知道…", "dup": null}]