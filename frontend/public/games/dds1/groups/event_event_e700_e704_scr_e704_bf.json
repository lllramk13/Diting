[{"id": "bf:event/e700/e704/scr/e704.bf#MSG_A01", "jp": "……我が塔を登らんとする者よ。\n光の中へ入りたる者よ。\nおまえの心を見せよ……", "zh": "", "speaker_jp": "声", "dup": "dup:bcd15a09c7f0"}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_A02_S", "jp": "おお……おまえの内には\n乱れなく息づくコトワリがある……", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_A02_Y", "jp": "おお……おまえの内には\n炎の如きコトワリがある……", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_A02_M", "jp": "おお……おまえの内には\n珠の硬さのコトワリがある……", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_A03", "jp": "そのコトワリにて創世のかなうや……\n求めるなら、3つのタカラの珠を手に\n我が元まで来るがよい!", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_B01", "jp": "……我が塔を登らんとする者よ。\n光の中へ入りたる者よ。\nおまえの心を見せよ……", "zh": "", "speaker_jp": "声", "dup": "dup:bcd15a09c7f0"}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_B02", "jp": "おお……\nおまえの心の内や見えず……", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:event/e700/e704/scr/e704.bf#MSG_B03", "jp": "汝、何者なるか…\n我が意にかなう者なるか……\n…恐れ無くば、3つのタカラの珠を手に\n我が元まで来るがよい……", "zh": "", "speaker_jp": "声", "dup": null}]