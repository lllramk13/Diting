[{"id": "bf:fld/f/f028/f028.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#start_mes", "jp": ">この建物のどこかに、\nバロンが潜んでいるはずだ…。\n>建物全体に、\n憎悪が渦卷き、立ち込めている…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch01_01", "jp": ">奇怪な赤い物体が浮かんだ\n光の柱が立っている…。\n>触れてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch01_02", "jp": ">赤い光の輪が回りだした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch01_03", "jp": ">館の西方からだろうか…。\nウズくような敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch02_01", "jp": ">奇妙な緑の物体が浮かんだ\n光の柱が立っている…。\n>触れてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch02_02", "jp": ">緑の光の輪が回りだした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch02_03", "jp": ">館の東方からだろうか…。\nウズくような敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch03_01", "jp": ">妖しい青の物体が浮かんだ\n光の柱が立っている…。\n>触れてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch03_02", "jp": ">青い光の輪が回りだした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch03_03", "jp": ">館の北西からだろうか…。\nウズくような敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#CHANGE_STRUC", "jp": ">建物の構造に変化が生じたようだ…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch04_01", "jp": ">光の柱が立っている。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch04_02", "jp": ">広間中央の光の柱に、\n白い物体が現れた…。\n>建物に渦卷く憎悪が、\n一段と強さを増したようだ…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch04_03", "jp": ">白い物体が浮かんだ\n光の柱がある…。\n>光の柱に触れてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch04_04", "jp": ">白い光の輪が回りだした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#switch04_05", "jp": ">館の北方から、\n突き刺すような激しい憎悪を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#dng_not_change", "jp": ">何も起こらない。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#DOOR_HAZURE", "jp": ">視界が青い光に包まれた…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#DEBUG", "jp": ">中ボス1、2、3を倒しますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_FEEL_01", "jp": ">建物の中に、\n3つの大きな敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_FEEL_02", "jp": ">建物の中に、\n2つの大きな敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_FEEL_03", "jp": ">建物の中に、\n1つの大きな敵意を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_GONE_01", "jp": ">この場所で感じた敵意は、\nバロンのものではなかった…。\n>建物には依然として\n激しい憎悪が渦卷いている…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_GONE_02", "jp": ">この場所で感じた敵意も、\nバロンのものではなかった…。\n>建物には依然として\n激しい憎悪が渦卷いている…。", "zh": "", "dup": "dup:6837dbe8163a"}, {"id": "bf:fld/f/f028/f028.bf#KEHAI_GONE_03", "jp": ">この場所で感じた敵意も、\nバロンのものではなかった…。\n>建物には依然として\n激しい憎悪が渦卷いている…。", "zh": "", "dup": "dup:6837dbe8163a"}, {"id": "bf:fld/f/f028/f028.bf#DOOR_HAJIKI", "jp": ">扉は固く閉ざされている。", "zh": "", "dup": "dup:10d600dbff4f"}, {"id": "bf:fld/f/f028/f028.bf#BOSS_01", "jp": "エ エンブリオン… 奇襲だと!?\n占領地域外周の警備は万全のはずだ\nどこから来たか!", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BOSS_02", "jp": "よくもずけずけ敵陣に入る\nエンブリオンの大将って言っても\nハエの類と変わりはしないのかい!", "zh": "", "speaker_jp": "ブルーティッシュ構成員 女", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BOSS_03", "jp": "お前たちを殺れば こんなバカげた\n悪夢から抜け出せるんだ\n出たいのは大佐だけじゃないんだよッ!", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#DOOR_HEAT", "jp": "セラが消えちまったってのに\nどこ行く気だ!?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#DOOR_GEIRU", "jp": "待て サーフ\nバロン… ベックの言葉が気になる\nセラを探せ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BATTLE_META", "jp": "そ そのタグリング…!\n貴様… まさか彼女を…\nローラを喰ったのか!?", "zh": "", "speaker_jp": "ニュービー 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BATTLE_META_SEL", "jp": "そうだ待て 俺じゃない", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BATTLE_META_YES", "jp": "ようやく… ようやくまた会えたのに…\n今度こそ 二人で生きていけると…\n…彼女の血の代価\n貴様の命で払ってもらうぞ!!", "zh": "", "speaker_jp": "ニュービー 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BATTLE_META_NO", "jp": "問答無用!\n彼女の血の代価\n貴様の命で払ってもらうぞ!!", "zh": "", "speaker_jp": "ニュービー 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#DAITENSI_GET", "jp": ">“大天使の羽\"を手に入れた。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#AOTAMA_GET", "jp": ">“蒼色の龍玉\"を手に入れた。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#SITAI", "jp": ">美しい女だ。\n>息がない…。\n死んでいるようだ。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#SITAI_SEL", "jp": ">手に何か握っている…。\n>取り上げますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#SITAI_YES", "jp": ">“赤いタグリング\"を手に入れた。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#PIC_MSG01", "jp": ">城の絵が立て掛けてある…。\n>絵は無残に切り裂かれている。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#PIC_MSG02", "jp": ">眩しいくらい青い、\n空と海の絵が飾ってある…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#PIC_MSG03", "jp": ">夕日にたたずむ親子の絵が飾ってある…。\n>絵は無残に切り裂かれている。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#TABLE_ITEM_01", "jp": ">テーブルの下になにかある…。\n>手を入れてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#TABLE_ITEM_02", "jp": ">………\n>ミステリーフードを1個手に入れた!\n>………\n>まだ、なにかありそうだ…。\n>手を伸ばしてみますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#TABLE_ITEM_03", "jp": ">………\n>ソーマを1個手に入れた!", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#heat_002_01a", "jp": "セラ…?\nどこだセラ!?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#heat_002_01b", "jp": "セラがいねぇ 探せサーフ!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#arujila_002_01a", "jp": "この中の 誰かに…\nあたしが喰われた…?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#arujila_002_01b", "jp": "一体誰に…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#gale_002_01a", "jp": "ベックだと…?", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#gale_002_01b", "jp": "どういう事だ\n奴は一体 何を知ったというのだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#ciero_002_01a", "jp": "あ 兄貴…\nオレら一回死んだって…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#ciero_002_01b", "jp": "どういうことなんだよ!?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f028/f028.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f028/f028.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f028/f028.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f028/f028.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f028/f028.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f028/f028.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f028/f028.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f028/f028.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f028/f028.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f028/f028.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f028/f028.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f028/f028.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f028/f028.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f028/f028.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f028/f028.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f028/f028.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f028/f028.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f028/f028.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f028/f028.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f028/f028.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#DOOR_CLOSE", "jp": ">扉は固く閉ざされている。", "zh": "", "dup": "dup:10d600dbff4f"}, {"id": "bf:fld/f/f028/f028.bf#BOSS_DOOR", "jp": ">扉の向こうから敵意を感じる…。\n>中に入りますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#BARON_DOOR", "jp": ">扉の向こうから激しい憎悪を感じる…。\n>中に入りますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#EX_BOSS_DOOR", "jp": ">扉の向こうから怪しい気配がする…。\n>中に入りますか?", "zh": "", "dup": "dup:dd9e36dde776"}, {"id": "bf:fld/f/f028/f028.bf#DOOR_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f028/f028.bf#KOWARE_DOOR", "jp": ">壊れて開きそうにない…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#HINT_01", "jp": "この部屋にある扉は 街と大カルマ端末に\n続くもの以外 全て施錠されている\n奥へ進むことさえ出来れば 憎きバロンに\n一矢を報いることもできようが…", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#HINT_02", "jp": "いかな仕組みかは不明だが その物体\nこの建物の構造と連動しているようだ\nこの建物といい その物体といい\n我らの及びもつかぬ力を感じる\n注意されよ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#HINT_03", "jp": "この光の柱…\nアートマと一緒に現れた不思議な壁や\n教会が集めているセルと似た感じがする\nいずれにせよ この世のものではあるまい", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#AREA016_NPC01_01", "jp": "変な男に…\n小隊まるごとやられた…\n奴は… 指揮官を探している…\n撤退を…\nその壁すら… 歯牙にもかけない男だ…\n気をつけろ…", "zh": "", "speaker_jp": "元ブルーティッシュ構成員 女", "dup": null}, {"id": "bf:fld/f/f028/f028.bf#AREA016_NPC01_02", "jp": "変な男に…\n小隊まるごとやられた…\n奴は… 指揮官を探している…\n撤退を…", "zh": "", "speaker_jp": "元ブルーティッシュ構成員 女", "dup": null}]