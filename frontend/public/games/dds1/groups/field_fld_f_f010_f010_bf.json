[{"id": "bf:fld/f/f010/f010.bf#YES_NO", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": ">瑟夫等人的心中掠过一阵饥饿感……。", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f010/f010.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": ">饥饿稍稍夺走了瑟夫一行人的体力……。", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f010/f010.bf#sera_01", "jp": "わぁ～ スゴイねサーフ\nねぇ… 登って…いい?", "zh": "哇～ 好厉害啊，瑟夫\n那个……可以爬……上去吗？", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_SEL", "jp": "ああ いいよ後にしよう", "zh": "啊，好吧，之后再说", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_ans0", "jp": "ありがとう!\n私 この船知ってる気がするの\n船はね 本当は海にあるんだよ\n海って 広くてとっても綺麗なの…\nね 早く行こう!", "zh": "谢谢！我\n好像认识这艘船 船呢\n 本来是在海上的 海\n呢 又宽广又非常漂亮…\n 喂 快点", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_ans1", "jp": "そう…\nじゃあ がまんするね…", "zh": "是吗… 那我就忍着吧…", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_02", "jp": "行きたいな… 海", "zh": "好想去啊……大海", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01", "jp": "おいサーフ この鉄クズ…\nどっかで見た気しねぇか?", "zh": "喂，瑟夫，这堆废铁…\n…是不是在哪儿见过？", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_SEL", "jp": "そう言われれば…バカな…初めて見たはずだ", "zh": "这么说来……不可能……明明是第一次见到", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_ans0", "jp": "やっぱり お前もか…\n俺 お前 セラ アルジラ シエロ…\n5人で 乗った気がしねぇか…?", "zh": "果然，你也是……我\n、你、塞拉、阿尔吉拉、西罗……\n五个人乘坐的感觉，没有吗…", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_ans1", "jp": "俺だってそうだ\nなんだってんだ…スッキリしねぇ", "zh": "我也一样\n。搞什么啊……真不爽", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#arujila_01", "jp": "あれ\"船\"よね…\n船って\n\"海\"に浮かんでるんじゃないの…?", "zh": "那是“船”吧\n……\n船不是应该浮在“海”上吗…", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01", "jp": "なんだこれは…", "zh": "这是什么……", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_SEL", "jp": "船…だと思うああ…なんなんだこいつは", "zh": "是船……吧，啊……这家伙到底是什么", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_ans0", "jp": "そんなことはわかっている\n初めて見たが これは艦艇の類だ\n理解不能なのは なぜここにあるかだ\nいや それ以前に…", "zh": "那种事我知道。虽然是第\n一次见，但这是舰艇一类的东\n西。无法理解的是它为什么会在这\n里。不，在那之前", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_ans1", "jp": "初めて見たが これは艦艇の類だ\nそれは理解できる\n理解不能なのは なぜここにあるかだ\nいや それ以前に…", "zh": "虽然是第一次见，但这是舰艇一类\n的东西。这点可\n以理解。无法理解的是它为什么会在这\n里。不，在那之前…", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#ciero_01a", "jp": "見ろよ兄貴\nセラ あんなに喜んでるぜ", "zh": "快看，老大\n塞拉高兴成那样", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#ciero_01b", "jp": "泣くってんだっけ? あんな顔よりさ\nあっちの方があってるな", "zh": "你是说要哭吗？比起那种表\n情，那边更合适吧", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01", "jp": "ボス ここで罠を張るんですよね?\n補給はしっかりしてって下さいよ\nたぶん 途中で仕入れに戻ってる暇なんか\nないでしょうから", "zh": "老大，是要在这里设\n陷阱吧？请务必做好\n补给。因为大概没空中途\n回去采购", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_SEL", "jp": "心配ないそうだな…", "zh": "不用担心……是吗……", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_ans0", "jp": "相手はブルーティッシュです\n死ぬ気でいかなきゃ勝てないでしょうけど\n…死なないで下さいよ", "zh": "对手是布鲁蒂什。\n不拼命的话恐怕赢不了…\n…但请别死啊", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_ans1", "jp": "そうでしょう?\n早く準備してきて下さいよ!\n奴ら いつ攻めて来るかわかりませんから", "zh": "是吧？\n快去做准备吧！\n因为不知道那些家伙什么时候会攻过来", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": ">要去其他区域吗？", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f010/f010.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": ">異様な物体が浮いている。\n触れてみますか?？", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": ">放弃了接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": ">获得了[物品]个。", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": ">有个奇异的物体\n静置在那里", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": ">放弃了接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": ">什么也没发生。", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": ">获得了[物品]个。", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": ">获得了×个。\n>似乎是教会正在寻找的传闻中的物质。\n应该会愿意用<1727>交换吧。", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": ">获得了魔货。", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": ">Surf们受到了伤害。", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": ">瑟夫们受到了伤害，\n并且中了毒。", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": ">瑟夫们受到了伤害，\n并且吃坏了肚子。", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": ">瑟夫一行人受到了伤害，\n魔法也被封印了。", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": ">里面是空的。", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f010/f010.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": ">找到了什么。\n………\n>获得了×个。", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f010/f010.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": ">此处无法使用。", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f010/f010.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": ">由于太阳噪音降低，\n瑟夫一行人身上的\n异常状态消失了。", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f010/f010.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": ">光的效果消失了。", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f010/f010.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": ">封魔的效果消失了。", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f010/f010.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": ">集魔的效果消失了。", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f010/f010.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": ">浮足的效果消失了。", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": " - ", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "取消", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "取消", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "取消", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "取消", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "取消", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "取消", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f010/f010.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": ">有一面神秘的蓝色墙壁。\n似乎可以用蓝冰钥匙破坏。", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f010/f010.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": ">有一面神秘的红色墙壁。\n似乎可以用红冰钥匙破坏。", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f010/f010.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": ">有一面奇妙的黄色墙壁。\n好像可以用黄色冰之钥破坏。", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f010/f010.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的蓝色墙壁。\n…现在还无法通过。", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f010/f010.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的红色墙壁。\n…现在还无法通过。", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f010/f010.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的黄色墙壁。\n…现在还无法通过。", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f010/f010.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": ">要破坏吗？", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f010/f010.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": ">消息测试\n首先是基础……。", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": ">消息测试\n接下来是选项。", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "是…吗？", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "否…吗？", "dup": "dup:cd5619bdd771"}]