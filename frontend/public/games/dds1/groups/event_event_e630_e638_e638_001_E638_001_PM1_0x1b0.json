[{"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NBRN0030", "jp": "そうだ", "zh": "没错", "dup": "dup:3b62237eb52b"}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NBRN0031", "jp": "私はお前の本当の姿も知っている", "zh": "我也知道你的真实面目", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NBRN0032", "jp": "早く私をここから出せ!", "zh": "快放我出去！", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0111", "jp": "興味深い事実だが", "zh": "有趣的是，", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0112", "jp": "本当に大佐なら\nそれが不可能なことをご存知のはず", "zh": "如果你真的是大佐，你应该知道那是不可能的。", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0113", "jp": "余人の干渉が及ばぬよう\n施錠を求めたのは他ならぬ貴方だ", "zh": "正是你本人要求上锁，以免他人干涉。", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0114", "jp": "ご自身で扉を開かれるしかありますまい", "zh": "只能由您亲自开门了。", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NBRN0040", "jp": "何がニルヴァーナか\nいつから私に向かって…", "zh": "什么涅槃？你什么时候开始对我…", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0121", "jp": "変わったのですよ あの日から", "zh": "从那天起就变了呢", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0122", "jp": "今は人の業が裁かれる時代", "zh": "现在是人类业障被审判的时代", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0123", "jp": "ですが その姿はあまりにも哀れだ", "zh": "但是，那副模样实在太过悲哀了", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0124", "jp": "力を貸して差し上げましょう\n私にも コツが掴めて来ましたのでね", "zh": "让我来助你一臂之力吧，因为我也渐渐掌握诀窍了呢", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0131", "jp": "まどろみを破る鐘が鳴るぞ", "zh": "打破假寐的钟声敲响了", "dup": null}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0133", "jp": "セラフィータ", "zh": "塞拉菲塔", "dup": "dup:1a5f3479c8ed"}, {"id": "pm1:event/e630/e638/e638_001/E638_001.PM1@0x1b0#NANG0132", "jp": "いつまで 目を閉じていられるかな", "zh": "你还能闭着眼睛到什么时候呢", "dup": null}]