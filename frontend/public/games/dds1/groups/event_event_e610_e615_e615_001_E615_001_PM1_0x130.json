[{"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0130", "jp": "知っての通り\nニルヴァーナに行く方法はひとつだ", "zh": "如你所知\n前往涅槃的方法只有一个", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0140a", "jp": "6つのエリアを治める\n全てのトライブを撃破し", "zh": "擊敗統治六個區域的所有部落。", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0140b", "jp": "教会に力を示さなければならない", "zh": "必须向教会展示力量", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0150", "jp": "目下 最大勢力のブルーティッシュは\n2のハウンズと抗争中だ", "zh": "你这个混蛋……\n竟敢戏弄我！", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0160", "jp": "第3のソリッドは\n同規模のメリーベルと争っている", "zh": "第三的索利德正在與同等規模的梅麗貝爾爭鬥。", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0170", "jp": "転じて我々は アサインメンツを\n撃破したが人員面では遥かに劣勢だ", "zh": "你这个混蛋……\n我一定会杀了你！", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NHET0210a", "jp": "何を今更", "zh": "現在說這個有什麼用？", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NHET0210b", "jp": "端から喰らって行きゃ\n済むことだろうが", "zh": "從頭開始幹掉不就行了？", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NARU0230a", "jp": "簡単に言わないで", "zh": "别说得那么简单", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NARU0230b", "jp": "作戦は?", "zh": "作战计划呢？", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0180a", "jp": "第3勢力のいずれかと共闘して\n一方を叩き", "zh": "与第三势力中的某一方联手，击溃一方。", "dup": null}, {"id": "pm1:event/e610/e615/e615_001/E615_001.PM1@0x130#NGIL0180b", "jp": "然る後 もう一方を叩く", "zh": "随后，再击溃另一方。", "dup": null}]