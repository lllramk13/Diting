[{"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NSER0300", "jp": "この船を壊しちゃうの…?", "zh": "要毁掉这艘船吗……？", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NGIL0531", "jp": "ここにお前を匿ったとの情報を流し\nバットとバロンの手勢を誘き出す", "zh": "据传，那个男人\n正在寻找什么东西。", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NGIL0532", "jp": "無論 この情報はオトリだ", "zh": "当然，这消息是诱饵", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NARU0880", "jp": "のこのこ現れたら\n船もろとも ボン!よ", "zh": "要是他们傻乎乎地出现", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NSIE0300", "jp": "ちょっと待った\nやっぱ違うとこにしよーぜ な?", "zh": "等等。\n先别急着走。", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NGIL0540", "jp": "構造材と内部構造が適している\nここならよく焼ける", "zh": "结构材料和内部结构都很合适，这里能烧得很好。", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NSIE0311", "jp": "そんな上手く行くのかよ", "zh": "真能那么顺利吗？", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NSIE0312", "jp": "セラがいなけりゃ\nどうせすぐバレちまうぜ", "zh": "要是没有塞拉，反正很快就会被发现。", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NGIL0550", "jp": "セラにはいてもらう", "zh": "让塞拉留下来。", "dup": null}, {"id": "pm1:event/e630/e636/e636_001/E636_001.PM1@0x2b0#NSIE0321", "jp": "はぁ?", "zh": "哈？", "dup": null}]