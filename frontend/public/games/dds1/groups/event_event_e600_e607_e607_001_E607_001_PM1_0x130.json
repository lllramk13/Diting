[{"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0030", "jp": "くるな 近づくな", "zh": "别过来 别靠近", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0040", "jp": "喰うな 喰わないで\n喰わないで くれ", "zh": "你们……要杀\n就尽管来试试看啊！", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#ARU0080", "jp": "何を 言っている", "zh": "你在说什么", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0050", "jp": "だってお前ら 喰ったじゃねえか!", "zh": "可你们不是吃了吗！", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0060", "jp": "どいつもこいつも\n化けもんみたいな姿になってよう", "zh": "——闪开！\n否则我连你一起杀了！", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0061", "jp": "俺の兵隊\n皆喰っちまったじゃねえか", "zh": "我的士兵们……\n拜托了。\n一定要追随春告大人到最后。", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0070", "jp": "光だ 光だよ\n光が飛んできて", "zh": "是光 是光啊", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0071", "jp": "あの場所にいた全員\n化物みたいな格好になっちまって", "zh": "你们醒醒啊！\n没有必要再战斗下去了！", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#ARU0090", "jp": "やめろ", "zh": "住手", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0080", "jp": "敵も味方もわからねぇ乱戦で", "zh": "在敌我不分的混战中", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0080a", "jp": "負けた奴ら\nてんでに素手で引き裂いて", "zh": "感谢你们……\n但这份恩情我不会忘记。\n不过，我们就在这里告别吧。", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0081", "jp": "それで それから", "zh": "然后 接着", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#ARU0100", "jp": "黙れ 黙って", "zh": "闭嘴 安静", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#HAR0090", "jp": "それから", "zh": "接着", "dup": null}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#ARU0110", "jp": "やめて!!", "zh": "住手！！", "dup": "dup:a9219dcc2d0c"}, {"id": "pm1:event/e600/e607/e607_001/E607_001.PM1@0x130#XRLD0010", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id":