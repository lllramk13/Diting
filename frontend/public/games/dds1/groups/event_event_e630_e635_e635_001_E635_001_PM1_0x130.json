[{"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSIE0240", "jp": "はいよ 兄貴", "zh": "来了，大哥。", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NARU0810", "jp": "ダメ バットの奴\n逃げたみたいだわ", "zh": "不行，那个叫巴特的家伙好像逃走了", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NGIL0490", "jp": "タフな男だ うちに欲しい\nシエロより役に立ちそうだ", "zh": "你在这里……\n真是帮了大忙了。", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSIE0250", "jp": "ひでぇな\n役に立ったじゃねぇかよ", "zh": "真过分啊，他不是挺有用的吗？", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NARU0820", "jp": "冗談でしょ\nあんな奴", "zh": "那种家伙", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSIE0260", "jp": "そうだそうだ", "zh": "就是就是。", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NGIL0500", "jp": "冗談 とはなんだ", "zh": "开玩笑是什么意思？", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NARU0830", "jp": "よくわからないけど\n本気じゃないってことよ", "zh": "虽然不太明白，但就是说不是认真的意思。", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NGIL0510", "jp": "理解不能だ", "zh": "无法理解。", "dup": "dup:4fd3e2007688"}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSER0200", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSER0210", "jp": "サーフ…", "zh": "瑟夫", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSER0220", "jp": "サーフ!", "zh": "瑟夫！", "dup": "dup:0cf31d99e19c"}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSER0230", "jp": "ごめんなさい", "zh": "对不起", "dup": "dup:a4b6ee78a8b9"}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSER0240", "jp": "こんなに…", "zh": "这么…", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NSIE0270", "jp": "ヒートは手加減知らないからな", "zh": "希特不知道手下留情啊", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/E635_001.PM1@0x130#NARU0840", "jp": "でも よかったわ\nみんな無事で", "zh": "但是，太好了", "dup": null}, {"id": "pm1:event/e630/e635/e635_001/