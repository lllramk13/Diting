[{"id": "bf:event/scr/scene07.bf#KIKU_01_01", "jp": "そこにおるんは…\n人間かいの?", "zh": "", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_02", "jp": "ホッホッホッホッホッホ…\n驚かせてしもうたかのぉ?", "zh": "", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_03", "jp": "人間に会うのは久方ぶりじゃ…", "zh": "", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_04", "jp": "それも若い男となると\n千年は会うとらん…", "zh": "", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_05", "jp": "互いを許し合うには儀式が必要じゃ…\nでは、始めるぞ…", "zh": "", "speaker_jp": "キクリヒメ", "dup": null}]