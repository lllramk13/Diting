[{"id": "bf:event/scr/scene07.bf#KIKU_01_01", "jp": "そこにおるんは…\n人間かいの?", "zh": "在那里的是…", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_02", "jp": "ホッホッホッホッホッホ…\n驚かせてしもうたかのぉ?", "zh": "菊水在此！\n一直在等您！\n这边请！", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_03", "jp": "人間に会うのは久方ぶりじゃ…", "zh": "好久没见到人类了…", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_04", "jp": "それも若い男となると\n千年は会うとらん…", "zh": "就在这里……\n那位大人正在等待。", "speaker_jp": "キクリヒメ", "dup": null}, {"id": "bf:event/scr/scene07.bf#KIKU_01_05", "jp": "互いを許し合うには儀式が必要じゃ…\nでは、始めるぞ…", "zh": "请进。\n那位大人就在里面。", "speaker_jp": "キクリヒメ", "dup": null}]