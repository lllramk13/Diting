[{"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NSIE0410", "jp": "テクノシャーマン?", "zh": "科技萨满？", "dup": "dup:6eda02756d20"}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0071", "jp": "バロンがそう呼ぶのを 聞いた者がいる", "zh": "有人听到巴伦这么称呼她。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0072", "jp": "この世界すら易々と減ぼすことのできる\n魔性の娘だと", "zh": "一个能轻易毁灭这个世界的魔性之女。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NSER0380", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NHET0650", "jp": "大丈夫か", "zh": "你没事吧？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NARU1070", "jp": "この娘は 自分のこともわからないのよ\nどこにそんな力があるって…", "zh": "这个女孩连自己都不了解。她哪来那种力量……", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0080", "jp": "君たちは 自分のことがわかるのか", "zh": "你们了解自己吗？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NARU1080", "jp": "え…?", "zh": "诶……？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0090", "jp": "私は最近 子供の夢を見る\nその子は 私を父と呼ぶ", "zh": "我最近梦见一个孩子。那个孩子叫我父亲。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NGIL0770", "jp": "夢?", "zh": "梦？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0101", "jp": "私は その子に伝えねば\nならないことがあるらしいのだ", "zh": "我似乎有必须告诉那个孩子的事情。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0102", "jp": "だが 伝えることは私でなくてもできる", "zh": "但传达这件事不一定非得是我。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NGIL0781", "jp": "伝えること…", "zh": "传达……", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NGIL0782", "jp": "わからないな\n生き延びて 自分で会えばいい", "zh": "不明白啊。活下去，自己去见他就好了。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0110", "jp": "子供を見たことがあるかね\nこのジャンクヤードで", "zh": "你在这个垃圾场见过一个孩子吗？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NGIL0790", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0120", "jp": "吞みこめてきたようだな", "zh": "看来你已经理解了", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0131", "jp": "なぜ 我々は戦い続けなければ\nならないのか", "zh": "为何我们必须不断战斗？", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0132", "jp": "この世界は何のために存在するのか\n我々は何者なのか…", "zh": "你说什么呢……\n谁会听你的。", "dup": null}, {"id": "pm1:event/e640/e647/e647_001/E647_001.PM1@0x350#NLUP0133", "jp": "バロンを倒せば 君たちだけが\nそれを知ることができる", "zh": "如果打倒巴隆，只有你们能知道那个答案。", "dup": null}]