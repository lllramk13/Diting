[{"id": "bf:fld/f/f033/f033.bf#modori_01", "jp": ">大量の水流が押し寄せてくる!", "zh": "大量水流汹涌而来！", "dup": "dup:7ff9f0ba26be"}, {"id": "bf:fld/f/f033/f033.bf#AREA_07MODOSARE", "jp": ">元の位置に戻されてしまった。", "zh": "被送回了原来的位置。", "dup": "dup:e44e48f55881"}, {"id": "bf:fld/f/f033/f033.bf#AKUMAKA_SURU", "jp": ">小型ボンベがないと\nこの先は進めないようだ。\n>小型ボンベを使いますか?", "zh": ">没有小型气瓶的话\n似乎无法继续前进。\n>要使用小型气瓶吗？", "dup": "dup:1f38c6901c90"}, {"id": "bf:fld/f/f033/f033.bf#AKUMAKA_SURU_SEL", "jp": "はいいいえ", "zh": "是/否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f033/f033.bf#AKUMAKA_OK", "jp": ">小型ボンベを装着した。", "zh": "安装了小型气瓶。", "dup": "dup:9dd1657ec94a"}, {"id": "bf:fld/f/f033/f033.bf#COUNT_03", "jp": ">水の流れが速くなったような気がする…。", "zh": "感觉水流变快了…。", "dup": "dup:b8365bceebc7"}, {"id": "bf:fld/f/f033/f033.bf#COUNT_02", "jp": ">だんだん流れが速くなってきた…。", "zh": "水流逐渐加快…。", "dup": "dup:41d6fe7b9425"}, {"id": "bf:fld/f/f033/f033.bf#COUNT_01", "jp": ">嫌な予感がする…!", "zh": "有种不祥的预感…！", "dup": "dup:a200dd6dd403"}, {"id": "bf:fld/f/f033/f033.bf#AREA16_BERU_01", "jp": "来タカ 何モ知ラヌマガイモノ\n我ハ 魔王ベルゼブブ\n今コソ仮初ノ煉獄ヲ這イ上ガリ\n現世ヲ恐怖ト腐敗デ覆イ尽クシテクレル", "zh": "来者何人，不知何物\n吾乃魔王别西卜\n此刻正从暂时的炼狱中爬升而上\n将以恐怖与腐败覆盖现世", "speaker_jp": "ベルゼブブ", "dup": null}, {"id": "bf:fld/f/f033/f033.bf#AREA16_BERU_02", "jp": "ヒザマズケ にえドモヨ!\n自ラソノ音 魔王ニ捧ゲヨ!!", "zh": "跪下吧，蝼蚁们！\n亲自将那声音献给魔王！！", "speaker_jp": "ベルゼブブ", "dup": null}, {"id": "bf:fld/f/f033/f033.bf#noisefullornot", "jp": "ノイズをレベルにするノイズをレベルにするノイズをレベルにするノイズをレベルにする何もしない", "zh": "将噪音转化为等级 将噪音转化为等级 将噪音转化为等级 将噪音转化为等级 什么都不做", "dup": "dup:d9850656e739"}, {"id": "bf:fld/f/f033/f033.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "要去其他区域吗？", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f033/f033.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "是/否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f033/f033.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "漂浮着一个诡\n异的物体", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f033/f033.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "是/否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f033/f033.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "放弃接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f033/f033.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "获得了1个", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": ">奇妙な物体が鎮座している。\n触れてみますか?？", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "是否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": ">放弃了接触。", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": ">什么也没有发生。", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": ">获得了[ ]个。", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": ">获得了 个。 \n>似乎是教会正在寻找的传闻中的物质\n。 应该可以和<1727>交换吧", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "获得了玛卡。", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "Surf一行人受到了伤害。", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "Surf一行人受到了\n伤害，并且中了毒", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "Surf一行人受到了伤\n害，并且肚子坏了", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "Surf一行人受到了伤害\n，并且被封印了魔法", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f033/f033.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "里面是空的。", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f033/f033.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": ">发现了什么东西。\n………\n>获得了×个。", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f033/f033.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": ">这里无法使用。", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f033/f033.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": ">由于太阳噪音降低，\n瑟夫一行人身上的\n异常状态消失了。", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f033/f033.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": ">光的效果消失了。", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f033/f033.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": ">封魔的效果消失了。", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f033/f033.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": ">集魔的效果消失了。", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f033/f033.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "浮空效果已消失", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": ">请选择楼层。", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "取消", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "取消", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "取消", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "取消", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "取消", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f033/f033.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "放弃", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f033/f033.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": ">有一面奇妙的蓝色墙壁。\n似乎能用蓝色冰之钥匙破坏。", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f033/f033.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": ">有一面奇妙的红色墙壁。\n似乎能用红色冰之钥匙破坏。", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f033/f033.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": ">有一面奇妙的黄色墙壁。\n似乎能用黄色冰之钥匙破坏。", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f033/f033.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的蓝色墙壁。\n…现在还无法通过。", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f033/f033.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的红色墙壁。\n…现在还无法通过。", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f033/f033.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": ">有一面奇妙的黄色墙壁。\n…现在还无法通过。", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f033/f033.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": ">要破坏吗？", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f033/f033.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f033/f033.bf#BEL_DOOR", "jp": ">扉の先から強い妖気を感じる。\n>中に入りますか?", "zh": ">感觉到门后传来强烈的妖气。\n>要进去吗？", "dup": null}, {"id": "bf:fld/f/f033/f033.bf#BELDOOR_SEL", "jp": "はいいいえ", "zh": "是 否", "dup": "dup:794ae24722fa"}]