[{"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSIE0450", "jp": "上にも誰も…", "zh": "上面也没有人…", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSER0460", "jp": "シエロ!", "zh": "希埃罗!", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0060", "jp": "久しぶりだな サーフ", "zh": "好久不见啊，瑟夫", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0070", "jp": "ああ その顔だ\n忘れたくても 忘れられん顔だ", "zh": "啊，就是那张脸。想忘也忘不掉的脸。", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSER0470", "jp": "サーフ!", "zh": "瑟夫!", "dup": "dup:0cf31d99e19c"}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0080", "jp": "お前は知らんな", "zh": "你不知道吧", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0090a", "jp": "お前のことも覚えている", "zh": "我还记得你的事", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0090b", "jp": "よく自分を喰らった男と\n一緒にいられるな", "zh": "你居然能跟那个吃了你的男人待在一起", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NARU1130", "jp": "なに… 言ってるの\nあたしは アンタなんか", "zh": "哦……来了吗。\n等你很久了。", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0100", "jp": "お前はいの一番に喰われたろう\n思い出せ", "zh": "你第一个就被吃掉了", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0110", "jp": "お前には 同情を禁じえない\n何度そんな女のために死ねば気が済む", "zh": "哼……\n我可不会手下留情。\n准备好了吗？", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NHET0700", "jp": "なんだと", "zh": "你说什么", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0120", "jp": "あまり 私の力を見くびらんことだ", "zh": "别太小看我的力量了", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NHET0710", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0130a", "jp": "腹が減ったろう", "zh": "饿了吧", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0130b", "jp": "喰らいたければ 喰らうがいい\n活きのいい餌はたんまりいるぞ", "zh": "你要来帮忙吗？\n那就跟上来吧。", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0140a", "jp": "トライブ? 仲間?", "zh": "部落？同伴？", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0140b", "jp": "お為ごかしもこれまでだ", "zh": "假惺惺的好意到此为止了", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0140c", "jp": "私がお前たちの本当の業を\n思い出させてやろう", "zh": "那家伙逃跑了。\n我们追上去。", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSER0480", "jp": "やめなさい!", "zh": "住手！", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSER0490a", "jp": "それだけは許さない…", "zh": "唯独那件事我绝不原谅…", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NSER0490b", "jp": "皆を 仲間を傷つけることだけは\n私が許さない", "zh": "伤害大家、伤害同伴的事", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0150a", "jp": "許さないだと?", "zh": "不允许？", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0150b", "jp": "お前が言えた義理か!", "zh": "你哪有资格说这种话！", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0150c", "jp": "なんの因果か知らんが\nもうこんな糞ったれな所はたくさんだ!", "zh": "你在干什么？\n快点跟上来！", "dup": null}, {"id": "pm1:event/e650/e652/e652_001/E652_001.PM1@0x130#NBRN0150d", "jp": "お前の大事なあの小僧を人つ裂きにして\n抜け出してやる", "zh": "我要把你珍视的那个小鬼撕成碎片，然后逃出去。", "dup": null}]