[{"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0330", "jp": "って…\nこりゃどう見てもムリがあんだろ", "zh": "喂……这怎么看都太勉强了吧。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0560", "jp": "そうか?", "zh": "是吗？", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0340a", "jp": "ったりめぇだろ!", "zh": "废话！", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0340b", "jp": "セラはこんなタッパねぇし", "zh": "塞拉没这么矮。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0340c", "jp": "髪だってサラサラだし", "zh": "而且头发也是顺滑的。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0340d", "jp": "腕だってこんな太く…", "zh": "胳膊也没这么粗……", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NARU0900", "jp": "悪かったわね", "zh": "真是抱歉啊。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0575", "jp": "遠目を欺ければ十分だ", "zh": "能骗过远处的人就够了。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#XRLD0070", "jp": "ボス\nブルーティッシュのヤツらです", "zh": "老大，是布鲁蒂什那帮人。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0350", "jp": "なんですと!?", "zh": "什么！？", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0580", "jp": "セラとヒートは", "zh": "塞拉和希特……", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#XRLD0081", "jp": "ついさっき\n新しいアジトへ向かいました", "zh": "刚才去了新的据点。\n那边的情况……很复杂。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#XRLD0082", "jp": "気付かれてなきゃ いいんですが", "zh": "希望没被发现。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0591", "jp": "流石に動きが速い", "zh": "果然动作很快。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0592", "jp": "ぐずぐずしていると\n俺たちが喰われることになる", "zh": "要是磨磨蹭蹭的，我们就会被干掉。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0361", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NSIE0362", "jp": "わかったよ\nやりゃいいんだろ やりゃあ", "zh": "既然如此……\n那就没办法了。\n我们走吧。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0600", "jp": "お前はここでバットを迎撃しろ\n奴は必ず そこから来る", "zh": "那家伙一直在……\n监视着我们。", "dup": null}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NARU0910", "jp": "了解", "zh": "明白", "dup": "dup:dcd61f0cb20f"}, {"id": "pm1:event/e630/e636/e636_002/E636_002.PM1@0x290#NGIL0610", "jp": "いくぞ\n罠を掛け 連中を奥まで誘い込む", "zh": "设下陷阱，把那些家伙引到深处", "dup": null}]