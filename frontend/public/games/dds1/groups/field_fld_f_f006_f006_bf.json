[{"id": "bf:fld/f/f006/f006.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f006/f006.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f006/f006.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f006/f006.bf#sera_01a", "jp": "神の情報に干渉するなんて…\n本当は…誰にもできっこない…\n私にできるのは…祈ることだけ…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#sera_01b", "jp": "あの人は…ウイルスに侵されすぎて…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#heat_01a", "jp": "今さら もう何も驚きゃしねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#heat_01b", "jp": "見てこいよ この先の建物\n見たことあるって思うだろうぜ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#heat_02", "jp": "考えたって仕方ねぇことは考えるな\nセラを…仲間を一人にしねぇ\nそんだけわかってりゃ 十分だ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_01", "jp": "このクソ忙しい時に\nどこの馬鹿どもの仕業だ!?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f4b1fbd2c465"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_02a", "jp": "今さらどうこうしたって\n喰われちまった奴らは 帰っちゃこねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:eb45c87e6a49"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_02b", "jp": "早くセラを追いかけねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f03dd8984d82"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_03a", "jp": "この お人好しが…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:2332f206ba88"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_03b", "jp": "やるならとっととケリ着けるぞ!\n早く決めねぇか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:e4890539ec73"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_04", "jp": "セラ 早まるんじゃねぇぞ…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:7aba97c4d6ed"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_05a", "jp": "とんだ時間喰っちまった", "zh": "", "speaker_jp": "ヒート", "dup": "dup:960e30ba2bcf"}, {"id": "bf:fld/f/f006/f006.bf#heat_SISEI_05b", "jp": "もう こんなとこに用はねぇ\nさっさと行かねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:5ce583ea6c37"}, {"id": "bf:fld/f/f006/f006.bf#arujila_01a", "jp": "あれが…バロンのアジトなの?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#arujila_01b", "jp": "サーフ あれって…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#arujila_02a", "jp": "そうよ ここセラの家だったんだ…\nあたしたち 何度もここへ来た…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#arujila_02b", "jp": "ダメ… これ以上思い出せないよ!", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_01", "jp": "誰もいない まさか…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c2881842ab73"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_02", "jp": "早くセラを追いかけないといけないのに!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:622267581851"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_03a", "jp": "やっぱり こんな力必要ないわよね…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:af0c94b41bf4"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_03b", "jp": "こんなの欲しがる奴は\n最後の一人になるまで殺し合えばいいのよ!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:99c156c4dbc8"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_04a", "jp": "もう3人倒したけど\n残りの一箇所にボスがいるってこと?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:d1f4d197e98d"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_04b", "jp": "なんか ひっかからない?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:2a8c238aba58"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_05a", "jp": "もう一度あの塔を登ろう サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:b74bda12691b"}, {"id": "bf:fld/f/f006/f006.bf#aljira_SISEI_05b", "jp": "雲の上で見下ろしてる奴らの横っ面\nえぐってやらなきゃ 気がすまない", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:6fa61c0dc926"}, {"id": "bf:fld/f/f006/f006.bf#npc_01_01", "jp": "バロン・オメガは危険な男だ\n奴をニルヴァーナに上げてはならん", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_07_01", "jp": "俺たちは大佐に従っただけなんだ\n頼む 俺たちも連れていってくれ!\n妻と娘に…会いたいんだ!", "zh": "", "speaker_jp": "元ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_06_01", "jp": "捕虜の扱いは ジュネーブ条約に\n従ってくれるんだろうな?\nそう何度も戦死してられるかよ…", "zh": "", "speaker_jp": "元ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_05_01a", "jp": "バロンの残党の中から\nぼちぼち投降する奴も出てきてるよ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_05_01b", "jp": "わけわからないこと言ってるけど", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_02_01", "jp": "お前とバロンの間には因縁がある\nあの日死んだ俺には わかるのだ…", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01a", "jp": "おつかれぇ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01b", "jp": "ね ね!\nボスは\nあん中に入ったことあるんでしょ?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_SEL", "jp": "あの建物か…あるにはあるが無いな", "zh": "", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans0a", "jp": "\"銀ピカで綺麗な翼のアクマ\"って見た?\nかなりイケメンなんだって", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans0b", "jp": "かなり会いたいんだけどぉ\nでも怖くて中に入れないんだけどぉ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans0c", "jp": "あーもう! せっかく\nメアド教えてもらおうと思ってたのに!", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans0d", "jp": "…?\n言ってる意味 わかんないんだけどぉ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans1a", "jp": "なんでウソつくわけ?\nウチら 知ってて聞いたんだけど?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_01_ans1b", "jp": "ありえないんだけどぉ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_02a", "jp": "イケメン アクマ君に\nカノジョいたなんて…\nダメ ヤバすぎ\nとーぶん立ち直んの ムリ…", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_02b", "jp": "元気出しなよぉ\nまたゴーコンやったげるからさぁ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_002_03_02c", "jp": "…?\nなに言っちゃってるわけ?", "zh": "", "speaker_jp": "元メリーベル構成員 女", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_01a", "jp": "なんか あの建物\n処理落ちした画が\n重なってるつーか なんつーか…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_01b", "jp": "よく見るとおかしくね?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_02a", "jp": "ああ なんとなくわかるぜ\nここはセラの家だった…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_02b", "jp": "でもさ オレらニルヴァーナで\n死んだんだろ…?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_02c", "jp": "なんで セラの家がここにあるんだよ?\nここがニルヴァーナじゃなきゃ\nおかしい話になっちまうじゃんか…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#ciero_SISEI_01", "jp": "今ごろなんだってんだよ\nもうオレらの勝ちでケリ着いてんだぜ!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:b8c4e720f0aa"}, {"id": "bf:fld/f/f006/f006.bf#ciero_SISEI_02", "jp": "どうする 兄貴!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:c97266898618"}, {"id": "bf:fld/f/f006/f006.bf#ciero_SISEI_03", "jp": "教会とも戦わなくちゃいけないってのに\nたまんねっつーの", "zh": "", "speaker_jp": "シエロ", "dup": "dup:7a150d0de18a"}, {"id": "bf:fld/f/f006/f006.bf#ciero_SISEI_04", "jp": "襲われたの 4ヶ所だったよな\nあいつらのボスってな\n一体どこにいるんだ?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2d3abf68b6c5"}, {"id": "bf:fld/f/f006/f006.bf#ciero_SISEI_05", "jp": "せっかく 他の仲間も\nニルヴァーナ行けるとこだったのにな…", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2c2fa0440875"}, {"id": "bf:fld/f/f006/f006.bf#npc_03_01", "jp": "ハァ ハァ…サーフさん\n僕 思い出したんですよ!\n僕が前にいたトライブは\nカイシャっていうんです\nそこも生き残りの競争が激しくて…\n上手くいかなくて…それで…\n僕 音を吊って死んだんです\nねぇ 僕は一体誰なんですか!?", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_01a", "jp": "力の支配 理屈としては正しかろう\nだが 力に屈さぬものもある", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_01b", "jp": "教会よ お前たちは\nもっとも厄介な敵を鍛えたぞ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02", "jp": "少なくとも\n俺とお前たちが違うことははっきりした\nお前たち自身とバロンの記憶の断片に\n俺はいない\nお前たちは特別なんだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02_SEL", "jp": "どういうことだ?そうだな…そんな気がする", "zh": "", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02_ans0a", "jp": "俺が推測するに 今ジャンクヤードには\n二種類の人間が存在する\nお前 ヒート アルジラ シエロと同じく\nセラに関する共通の過去を持つ者と…\n俺やルーパ その他大勢の様に\n何がしか失った過去を持ってはいるが\nセラとは直接関係のない者だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02_ans0b", "jp": "しかし 皆が皆 バロンが言ったように\nニルヴァーナで一度死んだかは疑問が残る\nこの建物が ここにあるからだ…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02_ans1a", "jp": "お前が\n正しく推測を進めていることを期待しよう", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_02_ans1b", "jp": "俺の考えが 的を射ているとは限らん…\nまだ何か裏があるはずだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_01a", "jp": "喰われたか 逃げたか", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8abd5136ee4f"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_01b", "jp": "いずれにせよ 報告は真実のようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:338c61978ffb"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_02a", "jp": "対処せずとも 大勢には影響あるまいが…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:842b66c0b5b3"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_02b", "jp": "斃されたやつらも\n一緒に戦ってきた仲間だ\nとむらい方 というものもある", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8a4c4390805a"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_03", "jp": "俺たちが勝てば 争いは無くなる\nいつからか\nどこかで そう期待していたのだがな…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:9197aba90fc1"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_04", "jp": "悠長にしている時間はない\nやるなら 一気に片付けろ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:b00dc20be6b4"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_05a", "jp": "この世界のこと 俺たちのこと\nセラがすべてを知っている", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:4eb7ee31b65e"}, {"id": "bf:fld/f/f006/f006.bf#gale_SISEI_05b", "jp": "教会へ向かうぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:07975510f563"}, {"id": "bf:fld/f/f006/f006.bf#npc_04_01a", "jp": "雨が止んじまった…", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_04_01b", "jp": "一体何が始まるんすか ボス!", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_04_01", "jp": "こんな子供だましの奇襲\nこのバカげた戦場でしか通用せんだろうよ\nもっと早く 頭がすっきりしてりゃ\n捕虜になってたのはお前の方だ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#npc_05_01", "jp": "前は あんな建物なかったんだ\nある日 突然地面からせり出して…\n大佐自ら偵察して\n今じゃキャンプに使ってる\n大佐 なんか知ってる風だったな\n一番奥の部屋に入った時の荒れ様ったら\n凄まじかったよ\nなぁ 素直に嘘ってるんだ\n喰うのだけは勘弁してくれよ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f006/f006.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f006/f006.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f006/f006.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f006/f006.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f006/f006.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f006/f006.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f006/f006.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f006/f006.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f006/f006.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f006/f006.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f006/f006.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f006/f006.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f006/f006.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f006/f006.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f006/f006.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f006/f006.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f006/f006.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f006/f006.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f006/f006.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f006/f006.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f006/f006.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f006/f006.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f006/f006.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f006/f006.bf#DONT_OPEN", "jp": ">扉は固く閉ざされている。", "zh": "", "dup": "dup:10d600dbff4f"}]