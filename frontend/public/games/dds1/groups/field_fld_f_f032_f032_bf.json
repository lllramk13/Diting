[{"id": "bf:fld/f/f032/f032.bf#s_tarminal", "jp": "小ターミナルです。\nセーブ/大ターミナルへの復帰を\n行うことができます。", "zh": "", "dup": null}, {"id": "bf:fld/f/f032/f032.bf#AKUMAKA_SURU", "jp": ">小型ボンベがないと\nこの先は進めないようだ。\n>小型ボンベを使いますか?", "zh": "", "dup": "dup:1f38c6901c90"}, {"id": "bf:fld/f/f032/f032.bf#AKUMAKA_SURU_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f032/f032.bf#AKUMAKA_OK", "jp": ">小型ボンベを装着した。", "zh": "", "dup": "dup:9dd1657ec94a"}, {"id": "bf:fld/f/f032/f032.bf#modori_01", "jp": ">大量の水流が押し寄せてくる!", "zh": "", "dup": "dup:7ff9f0ba26be"}, {"id": "bf:fld/f/f032/f032.bf#waterhalf", "jp": ">水流の音が強くなってきている…。", "zh": "", "dup": "dup:555f7b1f8fc8"}, {"id": "bf:fld/f/f032/f032.bf#AREA_07MODOSARE", "jp": ">元の位置に戻されてしまった。", "zh": "", "dup": "dup:e44e48f55881"}, {"id": "bf:fld/f/f032/f032.bf#AREA_10_NPC02", "jp": "ボス、この下にも水であふれた\n通路があるんだが、\nどうにもこうにも・・・\n東で南になんかあるようだが\n俺にはお手上げだ。\n後はボスに任せるよ。", "zh": "", "speaker_jp": "エンブリオン構成員", "dup": null}, {"id": "bf:fld/f/f032/f032.bf#AREA_16_YAMATA_01", "jp": "あと一息まで追い詰めた獲物を\n逃しはしたが これはまたなんたるぎょう幸\n汝がごとき 格別の獲物に鉢合わせとは\n我が王道の吉兆であろう", "zh": "", "speaker_jp": "ヤマタノオロチ", "dup": null}, {"id": "bf:fld/f/f032/f032.bf#AREA_16_YAMATA_02", "jp": "早速 縁起物として喰ろうてくれる", "zh": "", "speaker_jp": "ヤマタノオロチ", "dup": null}, {"id": "bf:fld/f/f032/f032.bf#COUNT_03", "jp": ">水の流れが速くなったような気がする…。", "zh": "", "dup": "dup:b8365bceebc7"}, {"id": "bf:fld/f/f032/f032.bf#COUNT_02", "jp": ">だんだん流れが速くなってきた…。", "zh": "", "dup": "dup:41d6fe7b9425"}, {"id": "bf:fld/f/f032/f032.bf#COUNT_01", "jp": ">嫌な予感がする…!", "zh": "", "dup": "dup:a200dd6dd403"}, {"id": "bf:fld/f/f032/f032.bf#noisefullornot", "jp": "ノイズをレベルにするノイズをレベルにするノイズをレベルにするノイズをレベルにする何もしない", "zh": "", "dup": "dup:d9850656e739"}, {"id": "bf:fld/f/f032/f032.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f032/f032.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f032/f032.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f032/f032.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f032/f032.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f032/f032.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f032/f032.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f032/f032.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f032/f032.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f032/f032.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f032/f032.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f032/f032.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f032/f032.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f032/f032.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f032/f032.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f032/f032.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f032/f032.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f032/f032.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f032/f032.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f032/f032.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f032/f032.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f032/f032.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f032/f032.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f032/f032.bf#BROKEN_DOOR", "jp": ">歪んだ扉は開きそうにない…。", "zh": "", "dup": null}]