[{"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NSER0500", "jp": "エンジェル\n見てるんでしょう", "zh": "天使，你在看着吧", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0141", "jp": "彼らのおかげで\nようやく卵の殻が割れた", "zh": "多亏了他们，蛋壳终于裂开了", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0142", "jp": "まったく いらぬ手間をかけさせる", "zh": "真是的，净给我添不必要的麻烦", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NSER0510", "jp": "私が帰れば\nもうジャンクヤードに手出ししない?", "zh": "如果我回去，就不再对垃圾场出手了吗？", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0151", "jp": "私は無駄なことは嫌いだ", "zh": "我讨厌做无用功", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0152", "jp": "お前に何をさせたいか知っていながら\n戻るだけで済むと思うのか", "zh": "明明知道我想让你做什么，却以为只要回去就能了事吗？", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NSER0520", "jp": "もう\nあんなひどいことしたくないの…", "zh": "已经不想再做那种过分的事了…", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NSER0530", "jp": "帰って!", "zh": "回来！", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0161", "jp": "流石 ただ一人生き残った\nテクノシャーマン", "zh": "不愧是唯一幸存下来的科技萨满", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0162", "jp": "構成に5年もかかったウイルスを\nもう自在に使ってみせる", "zh": "花费五年时间构成的病毒，我现在就自如地使用给你看", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0163", "jp": "だが…", "zh": "但是…", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NSER0540", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0170", "jp": "無駄はしないと言った\n探すのに苦労したよ", "zh": "我说过不会做无用功，找起来可费劲了", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0181", "jp": "大切なんだろう?", "zh": "很重要吧？", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0182", "jp": "外の世界に未練もない\n至ってシンプルな取引だよ", "zh": "啊……\n被摆了一道。\n不过还没完。", "dup": null}, {"id": "pm1:event/e650/e655/e655_001/E655_001.PM1@0x130#NANG0183", "jp": "セラフィータ", "zh": "塞拉菲塔", "dup": "dup:1a5f3479c8ed"}]