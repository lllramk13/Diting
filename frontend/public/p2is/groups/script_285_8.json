[{"src":"script","id":"script:285_8:diag0","speaker_jp":"黒いお面の男の子","speaker_zh":"黑面具男孩","jp":"\n<SURNAME/>ジャーン!!\n","zh":"\n<SURNAME/>锵—!!\n"},{"src":"script","id":"script:285_8:diag1","speaker_jp":"ギンコ","speaker_zh":"丽莎","jp":"\n<SURNAME/>ケーン!!\n","zh":"\n<SURNAME/>铿—!!\n"},{"src":"script","id":"script:285_8:diag2","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>ポ、ポーン!!\n","zh":"\n<SURNAME/>砰、砰—!!\n"},{"src":"script","id":"script:285_8:diag3","speaker_jp":"<c13/>","speaker_zh":"<c13/>","jp":"\n<SURNAME/>………\n","zh":"\n<SURNAME/>………\n"},{"src":"script","id":"script:285_8:diag4","speaker_jp":"ギンコ","speaker_zh":"丽莎","jp":"\n<SURNAME/>わーい!!\n<SURNAME/>かったかったー!!\n","zh":"\n<SURNAME/>哇—!!\n<SURNAME/>赢啦赢啦—!!\n"},{"src":"script","id":"script:285_8:diag5","speaker_jp":"ギンコ","speaker_zh":"丽莎","jp":"\n<SURNAME/>じゃあ、きょうはぁ…<pause:30/>\n<SURNAME/>オママゴトにきーめたっ!!\n","zh":"\n<SURNAME/>那么，今天呢…<pause:30/>\n<SURNAME/>就玩过家家吧!!\n"},{"src":"script","id":"script:285_8:diag6","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>え、え〜!?\n<SURNAME/>き、きょうは、お、お絵かきしようよお。\n<SURNAME/>せ、せっかく、クレヨン持ってきたのに…\n","zh":"\n<SURNAME/>咦，咦～!?\n<SURNAME/>今、今天，画、画画吧～。\n<SURNAME/>好、好不容易，把蜡笔带来了…\n"},{"src":"script","id":"script:285_8:diag7","speaker_jp":"黒いお面の男の子","speaker_zh":"黑面具男孩","jp":"\n<SURNAME/>だめだよ、イエロー。\n<SURNAME/>ボスの言うことは、ぜったい聞かなきゃダメって、\n<SURNAME/>オキテじゃないか。\n","zh":"\n<SURNAME/>不行啦，黄仔～\n<SURNAME/>老大的话，绝对要听才行，\n<SURNAME/>不是规矩吗～\n"},{"src":"script","id":"script:285_8:diag8","speaker_jp":"ギンコ","speaker_zh":"丽莎","jp":"\n<SURNAME/>えーとお、お父さんはレッドでぇ、\n<SURNAME/>お母さんは、とうぜんリサでしょお?\n<SURNAME/>でぇ、ブラックはお兄ちゃん!\n","zh":"\n<SURNAME/>嗯～，爸爸是红仔，\n<SURNAME/>妈妈当然是丽莎吧～?\n<SURNAME/>然后，黑仔是哥哥!\n"},{"src":"script","id":"script:285_8:diag9","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>ま、またぼく、赤ちゃん…?\n","zh":"\n<SURNAME/>又、又是我，当婴儿…?\n"},{"src":"script","id":"script:285_8:diag10","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>わ、わかったよお…\n","zh":"\n<SURNAME/>好、好吧…\n"},{"src":"script","id":"script:285_8:diag11","speaker_jp":"栄吉","speaker_zh":"荣吉","jp":"\n<SURNAME/>バ、バブバブー\n<SURNAME/>バ、バブバブー\n","zh":"\n<SURNAME/>吧、吧吧吧～\n<SURNAME/>吧、吧吧吧～\n"},{"src":"script","id":"script:285_8:diag12","speaker_jp":"ギンコ","speaker_zh":"丽莎","jp":"\n<SURNAME/>ねぇアナタ〜♥\n<SURNAME/>もう、子供たちもねたことだしい〜♥\n<SURNAME/>いっしょにおフロにはいりましょ〜♥\n","zh":"\n<SURNAME/>喂，老公～♥\n<SURNAME/>孩子们也睡了，\n<SURNAME/>一起泡澡吧～♥\n"},{"src":"script","id":"script:285_8:diag13","speaker_jp":"黒いお面の男の子","speaker_zh":"黑面具男孩","jp":"\n<SURNAME/>ママ…<pause:30/>\n<SURNAME/>ボク、ごはん食べてない…\n","zh":"\n<SURNAME/>妈妈…<pause:30/>\n<SURNAME/>我，还没吃饭…\n"}]