[{"src":"script","id":"script:4_48:diag0","speaker_jp":"シャドウ舞耶","speaker_zh":"影子舞耶","jp":"\n<SURNAME/>なぜだ…\n<SURNAME/>お前は、死にたガっているはずなのに…\n<unk7/>","zh":"\n<SURNAME/>为什么…\n<SURNAME/>你，明明想死才对…\n<unk7/>"},{"src":"script","id":"script:4_48:diag1","speaker_jp":"舞耶","speaker_zh":"舞耶","jp":"\n<SURNAME/>私は、死にたガってなんかいないわ…\n<SURNAME/>バイ、偽者さん…\n<unk7/>","zh":"\n<SURNAME/>我，才不想死呢…\n<SURNAME/>拜拜，冒牌货…\n<unk7/>"}]