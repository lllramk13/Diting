[{"id": "field:1:0x58380", "jp": "四「$「0「8「@「N「X「_「j「アトラス\\n", "zh": "四「$「0「8「@「N「X「_「j「阿特拉斯\n", "dup": null}, {"id": "field:1:0x583f2", "jp": "「い「D「¥「t「〜「ら「ラ「紅「無「彼「他「始「僕「ず「夢「持「直「敵に不意をつかれた!\\n", "zh": "「い「D「¥「t「〜「ら「ラ「红「无「彼「他「始「仆「ず「梦「持「直「被敌人偷袭了！\n", "dup": null}, {"id": "field:1:0x58450", "jp": "先制攻撃のチャンス!\\n", "zh": "先制攻击的机会！\n", "dup": null}, {"id": "field:1:0x58468", "jp": "の魔法を習得した\\n", "zh": "学会了魔法\n", "dup": null}, {"id": "field:1:0x5847c", "jp": "2ランクレベルアップ\\n", "zh": "等级提升了2级\n", "dup": null}, {"id": "field:1:0x58494", "jp": "パラメータガ上昇した\\n", "zh": "参数上升了\n", "dup": null}, {"id": "field:1:0x584ac", "jp": "変異能力を身につけた\\n", "zh": "掌握了变异能力\n", "dup": null}, {"id": "field:1:0x584de", "jp": "潜在的な能力ガ発動!\\n", "zh": "潜在能力发动了！\n", "dup": null}, {"id": "field:1:0x584fe", "jp": "達は全滅した\\n", "zh": "全员被全灭了\n", "dup": null}, {"id": "field:1:0x5850e", "jp": "舞耶「火ガ・・火ガ怖い!!」\\n", "zh": "舞耶「火・・火好可怕!!」\n", "dup": null}, {"id": "field:1:0x58546", "jp": "逃げ出した\\n", "zh": "逃跑了\n", "dup": null}, {"id": "field:1:0x58554", "jp": "こけた\\n", "zh": "摔倒了\n", "dup": null}, {"id": "field:1:0x5855e", "jp": "「,「公「退「俺「や「ペ「少「玉「賞「応「子「契「忘「贈「勇「嗜「科「記「際「白「癒「躊「札「荒「由「内「帯「済「寡「詳「虫「亜「空「雪「霧「費「隕「焔「珍「毎「織「謹「銅「査「節「行動を選択して下さい\\n", "zh": "「,「公「退「俺「や「ペ「少「玉「赏「应「子「契「忘「赠「勇「嗜「科「记「际「白「愈「踌「札「荒「由「内「带「济「寡「详「虫「亚「空「雪「雾「费「陨「焰「珍「每「织「谨「铜「查「节「请选择行动\n", "dup": null}, {"id": "field:1:0x5862c", "jp": "行動を変更するメンバーを選択して下さい\\n", "zh": "请选择要更改行动的成员\n", "dup": null}, {"id": "field:1:0x58656", "jp": "の行動を選択して下さい\\n", "zh": "请选择[某人]的行动\n", "dup": null}, {"id": "field:1:0x58670", "jp": "対象を選択して下さい\\n", "zh": "请选择目标\n", "dup": null}, {"id": "field:1:0x58688", "jp": "使用する魔法を選択して下さい\\n", "zh": "请选择要使用的魔法\\n", "dup": "dup:3ca048539151"}, {"id": "field:1:0x586a8", "jp": "使用するアイテムを選択して下さい\\n", "zh": "请选择要使用的物品\n", "dup": null}, {"id": "field:1:0x586cc", "jp": "変更するペルソナを選択して下さい\\n", "zh": "请选择要更改的人格面具\n", "dup": null}, {"id": "field:1:0x586f0", "jp": "アナライズする悪魔を選択して下さい\\n", "zh": "请选择要分析的恶魔\n", "dup": null}, {"id": "field:1:0x58716", "jp": "3ポイントを振り分けて下さい\\n", "zh": "请分配3点\\n", "dup": null}, {"id": "field:1:0x58736", "jp": "行動順を入れ替えるメンバーを選択して下さい\\n", "zh": "请选择要交换行动顺序的成员\\n", "dup": null}, {"id": "field:1:0x58764", "jp": "条件設定する合体魔法を選択して下さい\\n", "zh": "请选择要设置条件的合体魔法\\n", "dup": null}, {"id": "field:1:0x5878c", "jp": "戦闘モードを選択して下さい\\n", "zh": "请选择战斗模式\\n", "dup": null}, {"id": "field:1:0x587aa", "jp": "作戦内容を選択して下さい\\n", "zh": "请选择作战内容\\n", "dup": null}, {"id": "field:1:0x587c6", "jp": "発動条件を選択して下さい\\n", "zh": "请选择发动条件\\n", "dup": null}, {"id": "field:1:0x587e2", "jp": "組み合わせ成立時に自動的に発動します\\n", "zh": "当组合成立时自动发动\\n", "dup": "dup:ae4e22f81a78"}, {"id": "field:1:0x5880a", "jp": "組み合わせ成立時に待機します\\n", "zh": "当组合成立时待机\\n", "dup": "dup:2bd8e3baa416"}, {"id": "field:1:0x5882a", "jp": "組み合わせガ成立しても発動しません\\n", "zh": "即使组合成立也不发动\\n", "dup": "dup:829e9620142d"}, {"id": "field:1:0x58850", "jp": "各種設定をしてください\\n", "zh": "请进行各种设置\\n", "dup": null}, {"id": "field:1:0x5886a", "jp": "戦闘を開始します\\n", "zh": "开始战斗\\n", "dup": null}, {"id": "field:1:0x5887e", "jp": "戦闘行動の変更や<c20/>情報の確認等を行います\\n", "zh": "进行战斗行动的更改和<c20/>信息的确认等\\n", "dup": null}, {"id": "field:1:0x588aa", "jp": "敵悪魔とのコンタクトを試みます\\n", "zh": "尝试与恶魔接触\\n", "dup": null}, {"id": "field:1:0x588cc", "jp": "敵悪魔の詳細データを確認します\\n", "zh": "确认敌恶魔的详细数据\\n", "dup": null}, {"id": "field:1:0x588ee", "jp": "戦闘に関する環境を設定します\\n", "zh": "设置战斗相关的环境\\n", "dup": null}, {"id": "field:1:0x5890e", "jp": "戦闘から退却します\\n", "zh": "从战斗中撤退\\n", "dup": null}, {"id": "field:1:0x58924", "jp": "個人の戦闘行動を設定します\\n", "zh": "设置个人的战斗行动\\n", "dup": null}, {"id": "field:1:0x58942", "jp": "行動順序を入れ替えます\\n", "zh": "交换行动顺序\\n", "dup": null}, {"id": "field:1:0x5895c", "jp": "発見した合体魔法の確認と<c20/>発動条件を設定します\\n", "zh": "确认发现的合体魔法和<c20/>设置发动条件\\n", "dup": null}, {"id": "field:1:0x5898e", "jp": "ノーマル/シングルの切替えを行います\\n", "zh": "进行普通/单体的切换\\n", "dup": null}, {"id": "field:1:0x589b6", "jp": "装備された武器で攻撃します\\n", "zh": "使用装备的武器进行攻击\\n", "dup": null}, {"id": "field:1:0x589d4", "jp": "ペルソナの能力を使用します\\n", "zh": "使用Persona的能力\\n", "dup": null}, {"id": "field:1:0x589f2", "jp": "アイテムを使用します\\n", "zh": "使用物品\\n", "dup": null}, {"id": "field:1:0x58a0a", "jp": "ペルソナの付け替えを行います\\n", "zh": "进行Persona的更换\\n", "dup": null}, {"id": "field:1:0x58a2a", "jp": "のステータスを確認します\\n", "zh": "确认状态\\n", "dup": null}, {"id": "field:1:0x58a46", "jp": "攻撃せず防御に専念します\\n", "zh": "不攻击，专心防御\\n", "dup": null}, {"id": "field:1:0x58a62", "jp": "行動設定を終了します\\n", "zh": "结束行动设置\\n", "dup": null}, {"id": "field:1:0x58a7a", "jp": "すべてのメンバーの行動を「攻撃」にします\\n", "zh": "将所有成员的行动设置为「攻击」\\n", "dup": null}, {"id": "field:1:0x58aa6", "jp": "この行動順で決定します\\n", "zh": "以此行动顺序决定\\n", "dup": null}, {"id": "field:1:0x58ac0", "jp": "素早さ順に戻します\\n", "zh": "恢复为速度顺序\\n", "dup": null}, {"id": "field:1:0x58ad6", "jp": "キャンセルされない限り戦闘を継続します\\n", "zh": "除非取消，否则继续战斗\\n", "dup": null}, {"id": "field:1:0x58b00", "jp": "敵・味方全員ガ一回ずつ行動後<c20/>戦闘を中断します\\n", "zh": "敌我双方全员各行动一次后<c20/>中断战斗\\n", "dup": null}, {"id": "field:1:0x58b32", "jp": "設定を終了し<c20/>「戦闘開始」に戻ります\\n", "zh": "结束设置<c20/>返回「战斗开始」\\n", "dup": null}, {"id": "field:1:0x58b5a", "jp": "ステータス:人間+ペルソナ\\n", "zh": "状态：人类+Persona\\n", "dup": "dup:1c09fa160a3d"}, {"id": "field:1:0x58b78", "jp": "ステータス:人間\\n", "zh": "状态：人类\\n", "dup": "dup:b697a17fb4a8"}, {"id": "field:1:0x58b8c", "jp": "ステータス:ペルソナ\\n", "zh": "状态：Persona\\n", "dup": "dup:81a82944c813"}, {"id": "field:1:0x58ba4", "jp": "九「8「L「'「￣「飲「れ「嬉「俺「設「今「句「返「銀「にかかっています\\n", "zh": "取决于九、8、L、'、￣、飲、れ、嬉、俺、設、今、句、返、銀\\n", "dup": null}, {"id": "field:1:0x63a42", "jp": "答えられる状態ではありません\\n", "zh": "无法回答\\n", "dup": null}]