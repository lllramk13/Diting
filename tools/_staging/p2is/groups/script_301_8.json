[{"id": "script:301_8:diag0", "jp": "\n<SURNAME/>あわわわ…<pause:30/>\n<SURNAME/>も、もうだめですう〜\n", "zh": "\n<SURNAME/>哇哇哇…<pause:30/>\n<SURNAME/>不、已经不行了啦〜\n", "speaker_jp": "小坊主", "speaker_zh": "小坊主", "dup": null}, {"id": "script:301_8:diag1", "jp": "\n<SURNAME/>勝ぁーつっ!!\n", "zh": "\n<SURNAME/>赢啦ー!!\n", "speaker_jp": "住職", "speaker_zh": "住職", "dup": null}, {"id": "script:301_8:diag2", "jp": "\n<SURNAME/>不屈!\n<SURNAME/>不眠!!\n<SURNAME/>不倒!!!\n", "zh": "\n<SURNAME/>不屈!\n<SURNAME/>不眠!!\n<SURNAME/>不倒!!!\n", "speaker_jp": "住職", "speaker_zh": "住職", "dup": null}, {"id": "script:301_8:diag3", "jp": "\n<SURNAME/>我ガ伝えし、豪傑流古武術!!\n<SURNAME/>ゆめゆめ、飛び道具なぞに退けは取らん!!!\n<SURNAME/>戦えぇぇぇぇぇい!!!!\n", "zh": "\n<SURNAME/>吾所传授的豪杰流古武术!!\n<SURNAME/>绝不让步于飞来之器!!!\n<SURNAME/>战吧啊啊啊啊啊!!!!\n", "speaker_jp": "住職", "speaker_zh": "住職", "dup": null}, {"id": "script:301_8:diag4", "jp": "\n<SURNAME/>オッケェェェェイ!!\n", "zh": "\n<SURNAME/>Okayyyyyy!!\n", "speaker_jp": "栄吉の声", "speaker_zh": "栄吉の声", "dup": null}]