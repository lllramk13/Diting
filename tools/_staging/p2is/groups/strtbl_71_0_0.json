[{"id": "strtbl:71_0_0:1", "jp": "これ以上は、ストックできません\n", "zh": "库存已满", "dup": "dup:cff0e17ee3ad"}, {"id": "strtbl:71_0_0:2", "jp": "召喚できるレベルではありません\n", "zh": "等级不足", "dup": "dup:281f1a77e168"}, {"id": "strtbl:71_0_0:3", "jp": "タロットカードガ足りません\n", "zh": "塔罗牌不足", "dup": "dup:3ddcec0f7a92"}, {"id": "strtbl:71_0_0:4", "jp": "同じペルソナガすでにいます\n", "zh": "已持有该Persona", "dup": "dup:dee3ad39c90e"}, {"id": "strtbl:71_0_0:5", "jp": "相性ガ悪くて使えません\n", "zh": "相性不佳无法使用", "dup": "dup:363a98ddc0ca"}, {"id": "strtbl:71_0_0:6", "jp": "降魔しているペルソナは外せません\n", "zh": "装备中Persona无法卸下", "dup": "dup:c36ea6fd6e2b"}, {"id": "strtbl:71_0_0:7", "jp": "相性ガ悪く降魔できません\n", "zh": "相性不佳无法装备", "dup": "dup:7e3fb013b376"}, {"id": "strtbl:71_0_0:8", "jp": "降魔しているペルソナは削除できません\n", "zh": "无法删除装备中的Persona", "dup": "dup:6a07c0420a11"}, {"id": "strtbl:71_0_0:9", "jp": "降魔しているペルソナは変異できません\n", "zh": "无法变异装备中的Persona", "dup": "dup:c7579ac0085f"}, {"id": "strtbl:71_0_0:10", "jp": "左右キーで枚数を選択してください\n", "zh": "方向键左右选择数量", "dup": "dup:f1f4293f47b7"}, {"id": "strtbl:71_0_0:11", "jp": "種族を選択してください\n", "zh": "请选择种族", "dup": "dup:18e824331d6d"}, {"id": "strtbl:71_0_0:12", "jp": "召喚するペルソナを選択してください\n", "zh": "请选择召唤的Persona", "dup": "dup:c4721479b316"}, {"id": "strtbl:71_0_0:13", "jp": "加えたいカードを選択してください\n", "zh": "请选择要添加的卡片", "dup": "dup:0a0349420b3a"}, {"id": "strtbl:71_0_0:14", "jp": "これでよろしいですか?\n", "zh": "确定吗？", "dup": "dup:f0bfe28bfded"}, {"id": "strtbl:71_0_0:15", "jp": "入れ替えるペルソナを選択してください\n", "zh": "请选择要替换的Persona", "dup": "dup:bb5f380a1f78"}, {"id": "strtbl:71_0_0:16", "jp": "ペルソナを削除します\n", "zh": "删除Persona", "dup": "dup:26512aa1b014"}, {"id": "strtbl:71_0_0:17", "jp": "削除するペルソナを選択してください\n", "zh": "请选择要删除的Persona", "dup": "dup:e8a54fdadc6c"}, {"id": "strtbl:71_0_0:18", "jp": "削除してよろしいですか?\n", "zh": "确定删除吗?", "dup": "dup:2ca7faeb7292"}, {"id": "strtbl:71_0_0:19", "jp": "生まれ変わらせるペルソナを選択してください\n", "zh": "请选择要变异的Persona", "dup": "dup:c264bf3d8966"}, {"id": "strtbl:71_0_0:20", "jp": "このペルソナに変異します:○ボタンで決定\n", "zh": "将变异为此Persona:○键确定", "dup": "dup:c6581517fe23"}, {"id": "strtbl:71_0_0:21", "jp": "方向キー左右で枚数選択 ○ボタンで決定\n", "zh": "方向键左右选择数量 ○键确定", "dup": "dup:c08577fb2e45"}, {"id": "strtbl:71_0_0:22", "jp": "召喚されるペルソナです:○ボタンで決定\n", "zh": "将召唤的Persona:○键确定", "dup": "dup:0345aa8a48cb"}, {"id": "strtbl:71_0_0:23", "jp": "他のメンバーガ降魔しています\n", "zh": "其他成员正在装备", "dup": "dup:e70d4b8b9f52"}, {"id": "strtbl:71_0_0:24", "jp": "フリータロットガありません\n", "zh": "没有自由塔罗牌", "dup": "dup:001a13c042c6"}, {"id": "strtbl:71_0_0:25", "jp": "すでに降魔しています\n", "zh": "已经装备", "dup": "dup:b6b76ffbc62e"}, {"id": "strtbl:71_0_0:26", "jp": "フリータロットガ足りません\n", "zh": "自由塔罗牌不足", "dup": "dup:91ac8361a02b"}, {"id": "strtbl:71_0_0:27", "jp": "これ以上所持できません\n", "zh": "无法携带更多", "dup": "dup:2fb668cb9081"}]