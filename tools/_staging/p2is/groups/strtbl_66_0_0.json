[{"id": "strtbl:66_0_0:1", "jp": "食事するメンバーを選択してください\n", "zh": "请选择用餐成员", "dup": null}, {"id": "strtbl:66_0_0:2", "jp": "このメンバーは、今は満腹です\n", "zh": "该成员已饱腹", "dup": null}, {"id": "strtbl:66_0_0:3", "jp": "メニューから料理を選択してください\n", "zh": "请从菜单选择料理", "dup": null}, {"id": "strtbl:66_0_0:4", "jp": "所持金ガ足りません\n", "zh": "所持金不足", "dup": "dup:fe3e5226d235"}, {"id": "strtbl:66_0_0:5", "jp": "これでよろしいですか?\n", "zh": "确定吗？", "dup": "dup:f0bfe28bfded"}]