[{"id": "script:143_26:0xf98", "jp": "<c2e/>エリーの声<c2e/>\\n<c31/>Wanglong千鶴さん。\\n<c31/>少しお伺いしたい事ガありますの。\\n<c31/>失礼致しますわ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉的声音<c2e/>\\n<c31/>Wanglong千鹤小姐。\\n<c31/>我有些事想向您请教。\\n<c31/>失礼了。\\n<c7/><WAIT><PAGE>", "speaker_jp": "エリーの声", "dup": null}, {"id": "script:143_26:0x100a", "jp": "<c2e/>克哉<c2e/>\\n<c31/>いないな…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>不在啊……\\n<c7/><WAIT><PAGE>", "speaker_jp": "克哉", "dup": null}, {"id": "script:143_26:0x102e", "jp": "<c2e/>うらら<c2e/>\\n<c31/>あれ…この猫…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>咦……这只猫……\\n<c7/><WAIT><PAGE>", "speaker_jp": "うらら", "dup": null}, {"id": "script:143_26:0x1058", "jp": "<c2e/>黒猫<c2e/>\\n<c31/>ナ〜ゴ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>黑猫<c2e/>\\n<c31/>喵呜～。\\n<c7/><WAIT><PAGE>", "speaker_jp": "黒猫", "dup": null}]