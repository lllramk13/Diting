[{"id": "strtbl:30_0:raw:0x1cd8#5", "jp": "これでよろしいですか?\\n", "zh": "这样可以吗？\\n", "dup": "dup:5be65767da37"}, {"id": "strtbl:30_0:raw:0x1cd8#1", "jp": "方向キー左右でカードを指定 ○ボタンで決定\\n", "zh": "用方向键左右选择卡片　○键确定\\n", "dup": "dup:a07ed43e2577"}, {"id": "strtbl:30_0:raw:0x1cd8#2", "jp": "登録するカードを選択してください\\n", "zh": "请选择要登记的卡片\\n", "dup": "dup:df2571593709"}, {"id": "strtbl:30_0:raw:0x1cd8#3", "jp": "所持していないカードは登録できません\\n", "zh": "未持有的卡片无法登记\\n", "dup": "dup:42ee882b4582"}, {"id": "strtbl:30_0:raw:0x1cd8#4", "jp": "すでに登録済みのカードです\\n", "zh": "这张卡片已经登记过了\\n", "dup": "dup:689cfeae5d37"}, {"id": "strtbl:30_0:raw:0x1dac#0", "jp": "必要な材料\\n", "zh": "所需材料\\n", "dup": "dup:9a945292a844"}, {"id": "strtbl:30_0:raw:0x1dac#3", "jp": "<c5/><c2f/> カードを一枚ずつ消費するガ、\\n それでも登録するかね?\\n<WAIT><PAGE>", "zh": "<c5/><c2f/>每张卡都会消耗一张，\\n即便如此也要登记吗？\\n<WAIT><PAGE>", "dup": "dup:c92408f0c3c9"}, {"id": "strtbl:30_0:raw:0x1cd8#0", "jp": " \\n", "zh": "", "dup": "dup:172c6338055f"}, {"id": "strtbl:30_0:raw:0x1dac#1", "jp": "必要数/所持数\\n", "zh": "所需数／持有数\\n", "dup": "dup:1a9caa97a6fb"}, {"id": "strtbl:30_0:raw:0x1dac#2", "jp": "開発費\\n", "zh": "开发费\\n", "dup": "dup:aeca8dbe9b23"}]