[{"id": "field:863_169:dec:0x566", "jp": "<c2e/><NAME/><c2e/>\\n 目をそらすな…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n 别把视线移开…\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:d1980d8ed805"}, {"id": "field:863_169:dec:0x5ae", "jp": "<c2e/><NAME/><c2e/>\\n <cb/><c7/>言華はいらない…<c7/>\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n <cb/><c7/>我不需花言巧语…<c7/>\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:8d7573f8d3bc"}, {"id": "field:863_169:dec:0x5dc", "jp": "<c2e/><NAME/><c2e/>\\n 俺一人で充分だ…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我一个人就够了……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:13d929f6f52b"}, {"id": "field:863_169:dec:0x64a", "jp": "<c2e/><NAME/><c2e/>\\n あんたに会えてよかった…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n 能遇见你，真是太好了……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:aa8878b48915"}, {"id": "field:863_169:dec:0x678", "jp": "<c2e/><NAME/><c2e/>\\n あんたは十分強かった…\\n ただ、運ガ悪かっただけだ…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n 你已经够坚强了……\\n 只是运气不好而已……\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:df5dd80e9276"}, {"id": "field:863_169:dec:0x6c2", "jp": "<c2e/><NAME/><c2e/>\\n 俺も…あんたみたいな大人に…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n 我也想…成为像你这样的大人…\\n<WAIT><PAGE>", "speaker_jp": "<NAME/>", "dup": "dup:237818731444"}, {"id": "field:863_169:dec:0x602", "jp": "<c2e/>エリー<c2e/>\\n Okay!\\n でも、無理をしてはいけませんわ。\\n<WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n Okay!\\n 不过，可不能太勉强自己哦。\\n<WAIT><PAGE>", "speaker_jp": "エリー", "dup": null}]