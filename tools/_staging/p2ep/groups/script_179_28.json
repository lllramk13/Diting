[{"id": "script:179_28:0x4468", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>………\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>………\\n<c7/><WAIT><PAGE>", "speaker_jp": "パオフゥ", "dup": "dup:a93fa19a971f"}, {"id": "script:179_28:0x448c", "jp": "<c2e/>うらら<c2e/>\\n<c31/>ねぇ…<c5/>\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>喂……<c5/>\\n", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x44ac", "jp": "<c31/>どうしてそんなに憎むの…?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你为什么会那么恨呢……?\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:179_28:0x44f2", "jp": "<c2e/>うらら<c2e/>\\n<c31/>あっ…!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>啊……!?\\n<c7/><WAIT><PAGE>", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x4518", "jp": "<c2e/>うらら<c2e/>\\n<c31/>わわっ…!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>哇哇……!?\\n<c7/><WAIT><PAGE>", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x4540", "jp": "<c2e/>克哉<c2e/>\\n<c31/>奴を追うぞ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>追上那家伙。\\n<c7/><WAIT><PAGE>", "speaker_jp": "克哉", "dup": null}, {"id": "script:179_28:0x4566", "jp": "<c2e/>うらら<c2e/>\\n<c31/>なんなのよう!?\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>这到底是怎么回事啊!?\\n", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x458c", "jp": "<c31/>なにガどうなってんの!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>这、这到底是怎么搞的!?\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:179_28:0x45b0", "jp": "<c2e/>克哉<c2e/>\\n<c31/>盗聴ガバレていたんだ。\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>窃听已经暴露了。\\n", "speaker_jp": "克哉", "dup": null}, {"id": "script:179_28:0x45da", "jp": "<c31/>あの電話は、マフィア共々僕らを抹殺する\\n<c31/>ための罠だったんだ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>那通电话，是为了把我们连同黑手党一起抹杀的\\n<c31/>陷阱。\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:179_28:0x4624", "jp": "<c2e/>うらら<c2e/>\\n<c31/>えぇ!?\\n<c31/>じゃあ、パオの奴ガ…\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>欸!?\\n<c31/>那、那报复那家伙……\\n", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x465a", "jp": "<c31/>ヤバイよ、教えてやんなきゃ!\\n<c7/><WAIT><PAGE>", "zh": "<c31/>糟了，得快告诉他才行！\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:179_28:0x4682", "jp": "<c2e/>克哉<c2e/>\\n<c31/>自分の身を心配しろ。\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>先担心你自己吧。\\n", "speaker_jp": "克哉", "dup": null}, {"id": "script:179_28:0x46aa", "jp": "<c31/>奴も、知っていることだ…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>那件事，他自己也知道……\\n<c7/><WAIT><PAGE>", "dup": null}, {"id": "script:179_28:0x46ce", "jp": "<c2e/>うらら<c2e/>\\n<c31/>え…?\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>欸……?\\n", "speaker_jp": "うらら", "dup": null}, {"id": "script:179_28:0x46ea", "jp": "<c31/>なんて言ったの?<c31/>ねぇ!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你说什么？<c31/>喂!?\\n<c7/><WAIT><PAGE>", "dup": null}]