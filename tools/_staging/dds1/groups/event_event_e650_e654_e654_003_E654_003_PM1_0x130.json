[{"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0750", "jp": "それがどうした", "zh": "那又如何？", "dup": null}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NARU1180b", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0760", "jp": "それで 俺たちの何が変わるってんだ", "zh": "那又能改变我们什么呢？", "dup": null}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0770a", "jp": "この世界がどうだ\n一回死んでるだ 死んでないだ", "zh": "你这混蛋……\n给我站住！", "dup": "dup:af68beddbd4e"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0770b", "jp": "んなことより 俺たちは\nアイツが来て どうなったんだ?", "zh": "那家伙来了之后变成什么样了", "dup": "dup:961cafe70ec1"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NSIE0490", "jp": "仲間…", "zh": "同伴…", "dup": "dup:bfa582b46ad2"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0780a", "jp": "だったら やるこた一つだろう", "zh": "既然如此，要做的事只有一件吧。", "dup": "dup:515438adafb2"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0780b", "jp": "なんだ その…\n一人じゃ 仲間にならねぇだろうが", "zh": "什么啊，那个……\n一个人可没法成为同伴吧", "dup": "dup:3a6e2e69e51a"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NARU1200", "jp": "…どう?", "zh": "……怎么样?", "dup": "dup:2bb18b3b8df5"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NSIE0500a", "jp": "鐘三つくらいじゃねーの", "zh": "大概就三下钟吧", "dup": "dup:57046677a43d"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NSIE0500b", "jp": "すぐピーッとくるヤカンみたいな\n頭にしちゃ 上出来じゃん", "zh": "那种一烧开就哔哔响的水壶似的脑袋\n还算挺像样的嘛", "dup": "dup:dd865a1becd4"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0790a", "jp": "お前が嘘らなさすぎっから…", "zh": "因为你太不会撒谎了…", "dup": "dup:d02c55773431"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NHET0790b", "jp": "なんだ", "zh": "什么", "dup": "dup:681863b449b7"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NSIE0510", "jp": "雨が 止んだ", "zh": "雨停了", "dup": "dup:5dccd9ba52bd"}, {"id": "pm1:event/e650/e654/e654_003/E654_003.PM1@0x130#NGIL0920a", "jp": "俺たちは勝ち\nニルヴァーナ