[{"id": "bf:fld/f/f003/f003.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#BLUE_GET_KARI", "jp": "ブルーパスラマのスキルを\n入手しました。\n本来はアートマを成長させて\n入手するスキルですが、\n仮に入手したことにします。\nまた、今回に限って、\nスキルをセットしなくても\n使用できるようにします。", "zh": "", "speaker_jp": "アルファロム用メッセージ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f003/f003.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f003/f003.bf#sera_01a", "jp": "私は大丈夫", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_01b", "jp": "それより 危ないことはしないで", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_02a", "jp": "ルーパって人 たぶんこの建物を抜けた\n街の反対側だと思う", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_02b", "jp": "なんでわかるって 聞かれても困るけど…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_03", "jp": "サーフ\nルーパって人 大丈夫…だよね?", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_04a", "jp": "助けられなかった…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_04b", "jp": "サーフ\nやっぱり私 なにもできないよ…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_00", "jp": "奴らは俺たちを 怖れている", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_00_SEL", "jp": "なぜだ怖れ とはなんだ", "zh": "", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_00_ans0", "jp": "じきにわかる", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_00_ans1", "jp": "その目で確かめろ\n言葉では説明し難い", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_13", "jp": "怖れ がわかったか", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_01a", "jp": "ったく手間のかかる女だ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_01b", "jp": "大人しく喰うってんなら\nそこの奴 ぶっ殺してやるぜ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_02", "jp": "負け犬どもが\n俺はこうはならねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:d9e15d2bc04a"}, {"id": "bf:fld/f/f003/f003.bf#heat_03", "jp": "負け犬どもが\n俺はこうはならねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:d9e15d2bc04a"}, {"id": "bf:fld/f/f003/f003.bf#heat_04", "jp": "ひよっ子どもが いい度胸じゃねぇか\n腹ごしらえでもしていくか", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_05", "jp": "腹が減ってるのはわかるけどよ\n後でもいいんじゃねぇのか?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:558c41c2167c"}, {"id": "bf:fld/f/f003/f003.bf#heat_06", "jp": "腹が減ってるのはわかるけどよ\n後でもいいんじゃねぇのか?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:558c41c2167c"}, {"id": "bf:fld/f/f003/f003.bf#heat_08a", "jp": "あの肉団子野郎\nセラになにかしてみやがれ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_08b", "jp": "腸引きずり出して\n教会にぶら下げてやる!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_09", "jp": "セラ 腹は減ってねぇか?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_10", "jp": "しかし 負け犬の大将が\n今更なんの用だってんだ?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_11", "jp": "ゲイルでも 熱くなることがあるとはな\n会わなきゃならねぇ奴がいる\nとか言ってたが 誰のことだ?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_12a", "jp": "セラが何者かなんて関係ねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_12b", "jp": "俺は守らなきゃならねぇんだ!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_01", "jp": "このクソ忙しい時に\nどこの馬鹿どもの仕業だ!?", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f4b1fbd2c465"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_02a", "jp": "今さらどうこうしたって\n喰われちまった奴らは 帰っちゃこねぇ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:eb45c87e6a49"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_02b", "jp": "早くセラを追いかけねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:f03dd8984d82"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_03a", "jp": "この お人好しが…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:2332f206ba88"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_03b", "jp": "やるならとっととケリ着けるぞ!\n早く決めねぇか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:e4890539ec73"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_04", "jp": "セラ 早まるんじゃねぇぞ…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:7aba97c4d6ed"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_05a", "jp": "とんだ時間喰っちまった", "zh": "", "speaker_jp": "ヒート", "dup": "dup:960e30ba2bcf"}, {"id": "bf:fld/f/f003/f003.bf#heat_SISEI_05b", "jp": "もう こんなとこに用はねぇ\nさっさと行かねぇか!", "zh": "", "speaker_jp": "ヒート", "dup": "dup:5ce583ea6c37"}, {"id": "bf:fld/f/f003/f003.bf#aljira_01a", "jp": "この無防備さ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_01b", "jp": "アサインメンツに何があった", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_15a", "jp": "どこ行くの… サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_15b", "jp": "ハーリーはアジトの奥へ逃げたわ…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_03", "jp": "ボスが倒されたトライブは\n倒したトライブの長に従う\n当たり前の掟でしょ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:4708961f86a4"}, {"id": "bf:fld/f/f003/f003.bf#aljira_04", "jp": "ボスが倒されたトライブは\n倒したトライブの長に従う\n当たり前の掟でしょ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:4708961f86a4"}, {"id": "bf:fld/f/f003/f003.bf#aljira_05a", "jp": "よりによって なんでここで…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_05b", "jp": "戦闘は必要最低限にして サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_06a", "jp": "仲間…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:bfa582b46ad2"}, {"id": "bf:fld/f/f003/f003.bf#aljira_06b", "jp": "あたしたち\nその仲間ってやつなのかな…?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:dbae932356cb"}, {"id": "bf:fld/f/f003/f003.bf#aljira_07a", "jp": "仲間…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:bfa582b46ad2"}, {"id": "bf:fld/f/f003/f003.bf#aljira_07b", "jp": "あたしたち\nその仲間ってやつなのかな…?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:dbae932356cb"}, {"id": "bf:fld/f/f003/f003.bf#aljira_08", "jp": "サーフ 今はセラの事を考えて", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_09", "jp": "あいつら セラを盾にアナタを狙ってくる\nアナタは残ってて…\nって 聞くわけ無いわよね…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_10", "jp": "そういえばセラ…\n出会ってから何も食べてない?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_11", "jp": "ここじゃないみたいね\nスワディスターナったって 広いからね", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_12", "jp": "そういえば…\n女はどんな時に泣くのかって\nゲイルに聞かれたことあったわ\nそりゃ 哀しいときでしょって答えたけど\n気になる女でも いるってこと…?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c120e54a42bf"}, {"id": "bf:fld/f/f003/f003.bf#aljira_13", "jp": "そういえば…\n女はどんな時に泣くのかって\nゲイルに聞かれたことあったわ\nそりゃ 哀しいときでしょって答えたけど\n気になる女でも いるってこと…?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c120e54a42bf"}, {"id": "bf:fld/f/f003/f003.bf#aljira_14", "jp": "誰かに喰われたなら\n今のあたしは なんだっていうのよ!?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_01", "jp": "誰もいない まさか…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:c2881842ab73"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_02", "jp": "早くセラを追いかけないといけないのに!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:622267581851"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_03a", "jp": "やっぱり こんな力必要ないわよね…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:af0c94b41bf4"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_03b", "jp": "こんなの欲しがる奴は\n最後の一人になるまで殺し合えばいいのよ!", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:99c156c4dbc8"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_04a", "jp": "もう3人倒したけど\n残りの一箇所にボスがいるってこと?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:d1f4d197e98d"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_04b", "jp": "なんか ひっかからない?", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:2a8c238aba58"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_05a", "jp": "もう一度あの塔を登ろう サーフ", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:b74bda12691b"}, {"id": "bf:fld/f/f003/f003.bf#aljira_SISEI_05b", "jp": "雲の上で見下ろしてる奴らの横っ面\nえぐってやらなきゃ 気がすまない", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:6fa61c0dc926"}, {"id": "bf:fld/f/f003/f003.bf#gale_01", "jp": "仲間 とは何だ?\n理解不能だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_02", "jp": "ニュービーは差し迫った脅威ではない\n速やかにアジトへ帰還すべきだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_03a", "jp": "ミックの目的はわかった", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_03b", "jp": "セラの身に危険は無いはずだが\n敵の作戦に対する対抗策が無いのも事実だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_03c", "jp": "今は 多少でも戦闘力を上げておく程度の\n事前策しかとりようがない", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_04", "jp": "エネルギー摂取の必要もないか\nますますもって理解不能だ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_05", "jp": "ルーパの真意が知りたい\n急ぐぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_06", "jp": "ルーパの時間稼ぎを無駄にする気か?\n早くバロンの拠点を強襲するべきだ\nお前が乗れないなら\n俺に先遣隊の指揮権を与えてくれ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_07a", "jp": "ルーパの死を無駄にする気か?", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_07b", "jp": "早くバロンの拠点を強襲するべきだ\nお前が乗れないなら\n俺に先遣隊の指揮権を与えてくれ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08a", "jp": "俺はこれまで\nこの力をなんの疑問もなく受け入れてきた\nそしてルーパを殺し 痛みを知った", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08b", "jp": "サーフ\nなぜ教会は 俺たちにこんな力を与えた", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_SEL", "jp": "試されている気がするわからないな", "zh": "", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_ans0", "jp": "一体 何を試していると?", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_0_SEL", "jp": "アートマをだ俺たちそのものだそこまではわからない…", "zh": "", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_0_ans0", "jp": "アートマ… 悪魔の力をか…\n俺たちを喰らい合わせ データを採る…\n目的はわからんが\n可能性としては在り得るか…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_0_ans1", "jp": "確かに 皮肉のようなものは感じるが…\n俺たちを試すことで 何か利があるのか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_08_0_ans2", "jp": "確かに それがわかれば苦労はしないな\n直接 連中に聞けばいいことだ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:f089a3fd5048"}, {"id": "bf:fld/f/f003/f003.bf#gale_08_ans1", "jp": "確かに それがわかれば苦労はしないな\n直接 連中に聞けばいいことだ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:f089a3fd5048"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_01a", "jp": "喰われたか 逃げたか", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8abd5136ee4f"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_01b", "jp": "いずれにせよ 報告は真実のようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:338c61978ffb"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_02a", "jp": "対処せずとも 大勢には影響あるまいが…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:842b66c0b5b3"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_02b", "jp": "斃されたやつらも\n一緒に戦ってきた仲間だ\nとむらい方 というものもある", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:8a4c4390805a"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_03", "jp": "俺たちが勝てば 争いは無くなる\nいつからか\nどこかで そう期待していたのだがな…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:9197aba90fc1"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_04", "jp": "悠長にしている時間はない\nやるなら 一気に片付けろ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:b00dc20be6b4"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_05a", "jp": "この世界のこと 俺たちのこと\nセラがすべてを知っている", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:4eb7ee31b65e"}, {"id": "bf:fld/f/f003/f003.bf#gale_SISEI_05b", "jp": "教会へ向かうぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:07975510f563"}, {"id": "bf:fld/f/f003/f003.bf#ciero_01", "jp": "ヒートの喰い方 下品だからなぁ\n女の子にゃキツイって", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_02", "jp": "オレもわかるぜ\nセラは兄貴に惚れてるな\nなんでわかるって聞かれても 困るけど", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_03", "jp": "珍しくゲイルがイライラしてんぜ\n早く行こうぜ 兄貴", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2f0aeecd8e7b"}, {"id": "bf:fld/f/f003/f003.bf#ciero_04", "jp": "珍しくゲイルがイライラしてんぜ\n早く行こうぜ 兄貴", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2f0aeecd8e7b"}, {"id": "bf:fld/f/f003/f003.bf#ciero_05a", "jp": "アルジラが喰われたって…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_05b", "jp": "仮にマジだとしたらさ ニルヴァーナにも\nオレらと同じような悪魔がいるってことか", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_SISEI_01", "jp": "今ごろなんだってんだよ\nもうオレらの勝ちでケリ着いてんだぜ!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:b8c4e720f0aa"}, {"id": "bf:fld/f/f003/f003.bf#ciero_SISEI_02", "jp": "どうする 兄貴!?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:c97266898618"}, {"id": "bf:fld/f/f003/f003.bf#ciero_SISEI_03", "jp": "教会とも戦わなくちゃいけないってのに\nたまんねっつーの", "zh": "", "speaker_jp": "シエロ", "dup": "dup:7a150d0de18a"}, {"id": "bf:fld/f/f003/f003.bf#ciero_SISEI_04", "jp": "襲われたの 4ヶ所だったよな\nあいつらのボスってな\n一体どこにいるんだ?", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2d3abf68b6c5"}, {"id": "bf:fld/f/f003/f003.bf#ciero_SISEI_05", "jp": "せっかく 他の仲間も\nニルヴァーナ行けるとこだったのにな…", "zh": "", "speaker_jp": "シエロ", "dup": "dup:2c2fa0440875"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_00", "jp": "ハーリーは死んだ\n我々はエンブリオンに従う", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": "dup:b5f7ff63c596"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_01", "jp": "ハーリーは死んだ\n我々はエンブリオンに従う", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": "dup:b5f7ff63c596"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_01b", "jp": "ハーリーは死んだ\n我々はエンブリオンに従う", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": "dup:b5f7ff63c596"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_02", "jp": "ニュービー連中が ここを根城に\n新しいトライブを築こうとしている", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_01_03", "jp": "ニュービーども 喰っても喰っても\nもくもくと襲いかかって来やがる\nあれじゃ まるで機械だぜ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": "dup:e7f0442e9fe5"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_04a", "jp": "その女が黒髪の娘か", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_01_04b", "jp": "そいつが言ってる通り\nルーパなら向こう側にいるよ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_01_05", "jp": "ニュービーども 喰っても喰っても\nもくもくと襲いかかって来やがる\nあれじゃ まるで機械だぜ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": "dup:e7f0442e9fe5"}, {"id": "bf:fld/f/f003/f003.bf#npc_01_06", "jp": "ワ ワシが前にいた国も\n生まれた時から戦争しとったよ…\nな なんだ…オレぁ何言ってる…", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_02_01", "jp": "我々はジャンクヤードの掟に従う\nお前が新しいボスだ", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": "dup:ac4d7d7ba9d5"}, {"id": "bf:fld/f/f003/f003.bf#npc_02_01b", "jp": "我々はジャンクヤードの掟に従う\nお前が新しいボスだ", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": "dup:ac4d7d7ba9d5"}, {"id": "bf:fld/f/f003/f003.bf#npc_02_02", "jp": "数がまとまると厄介だ\nボス直々に討伐するのか?", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_02_03", "jp": "まだがんばってるのよ ひよっ子連中\nいい加減 お腹一杯なんだけど\nお頭直々に討伐してくれるの?", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": "dup:680839507f75"}, {"id": "bf:fld/f/f003/f003.bf#npc_02_04", "jp": "まだがんばってるのよ ひよっ子連中\nいい加減 お腹一杯なんだけど\nお頭直々に討伐してくれるの?", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": "dup:680839507f75"}, {"id": "bf:fld/f/f003/f003.bf#npc_02_05", "jp": "まだがんばってるのよ ひよっ子連中\nいい加減 お腹一杯なんだけど\nお頭直々に討伐してくれるの?", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": "dup:680839507f75"}, {"id": "bf:fld/f/f003/f003.bf#npc_02_06", "jp": "今さらニュービー相手にしても\n意味ないんじゃない お頭", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_08_01", "jp": "新しいボス 補給は怠りないか\n補給の軽視は死に直結する\nベンダーを有効的に活用しろ", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_08_02", "jp": "ボス セルの交換比率は変動するそうだ\n交換の時期を見計らえば\nより高ポイントの<1727>を得られる", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_09_01", "jp": "ハーリーは死んだ\n大事にしていたアレを部屋に残して\nハーリーは死んだ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_001_10_01", "jp": "ボス\n我々の縄張りにニュービーが出現したぞ", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_001_10_01_SEL", "jp": "気にする必要は無いニュービー とは", "zh": "", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_001_10_01_ans0", "jp": "そうか 了解した", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_001_10_01_ans1", "jp": "まだ記憶が回復していないのか\nそんなことでエンブリオンは大丈夫か\nニュービーとは新参者のことだ\nかつては我々もニュービーだった\nニュービーが集まりトライブとなる\nそして掟に従いニルヴァーナを目指す", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#aljira_02", "jp": "早く…アジトに", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_003_01a", "jp": "そうだよ! どっかへ流れていかなきゃ\n街が雨でいっぱいになっちまう", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_003_01b", "jp": "そんなこと なんで今まで\n気づかなかったんだ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_003_02", "jp": "そのホコリっての\nオレの中にもあんのかな?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_003_03a", "jp": "掟 掟ってうるさいゲイルがねぇ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#ciero_003_03b", "jp": "ルーパって すげぇヤツだったんだな", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_003_01", "jp": "なるほど 盲点だった\n地下に雨の道筋がある ということか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_003_02", "jp": "俺の中にも 誇りがある…?", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#gale_003_03", "jp": "もうトライブの色に意味などない\n器をみせろよ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_07_01", "jp": "惚れ惚れするほど堂々とした男\n敗北から何かを拾える男よ きっと", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_07_02a", "jp": "あの男たちを屈服させることはできないよ\n味方になれば こんな心強い奴らはいない\nでも 敵対したら皆殺しにするしかない", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_07_02b", "jp": "消すことはできるけど\n絶対に負かすことはできない連中よ", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_07_03a", "jp": "彼の言ってること わかるよ…\n魂は不減 想いは永遠…\n母さんが 同じようなこと言ってた", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_07_03b", "jp": "いたんだ 母さんが…確かに", "zh": "", "speaker_jp": "元アサインメンツ構成員 女", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_06_01a", "jp": "ハウンズのルーパ\nアートマラヴァフローをもつ男…\n相当の使い手だ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_06_01b", "jp": "問答無用で打ちかかった仲間が\n1秒で伸されたぞ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_06_02", "jp": "あの蹴りの鋭さ…\n前から聞いちゃいたが\n流石は\"ツイスター\"のゲイルだな", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_03_01", "jp": "誇り高き狼 直々の出向きだ\n礼を持って迎えられよ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#rupa_01", "jp": "こうしてまみえるのは二度目だが\n改めて名乗らせて頂く\n私はハウンズの長 ルーパ\n君を道理のわかる男と見込み\n恥を忍んで会いに来た\n突然の非礼は容敵願いたい", "zh": "", "speaker_jp": "ルーパ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_04_01", "jp": "我々はルーパの供の者だ\nエンブリオンの頭目に目通り場りたい", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_01a", "jp": "あいつがルーパか\nいい面構えしてんじゃねぇか", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_01b", "jp": "殺り合や 最後に立ってるのは俺だがな", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_02a", "jp": "バロンの野郎\nセラのことを何か知ってやがるのか…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_02b", "jp": "行くぞ サーフ", "zh": "", "speaker_jp": "ヒート", "dup": "dup:af40e2689c2d"}, {"id": "bf:fld/f/f003/f003.bf#heat_003_04a", "jp": "何言ってやがる\n死んだらそれで終わりだろうが", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_04b", "jp": "オレは誰の踏み台にもならねぇ\n生き残って この手に全部を…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#heat_003_03", "jp": "魂だの情報だの\nんなこたぁ どうでもいい\nセラを探せ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_05_01", "jp": "あいつら\nそこの穴から 急に出てきたんだ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_05_02", "jp": "あんな強そうな連中を\n1人で斃したのか!?\nバロンってな 一体どんな奴なんだ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_05_03a", "jp": "地下にそんな場所が…", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_05_03b", "jp": "雨があたりまえで 気づかなかったな", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_003_01a", "jp": "死者の雨が流れる輪廻の川…\n閉じた卵の中で…\n哀れな魂は永遠に循環を繰り返す…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_003_01b", "jp": "違う… こんなはずじゃ…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_003_02", "jp": "私…\nこの先 行きたくない…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#sera_003_03", "jp": "神は なぜ輪廻なんてものを定めたの…\n哀しみだけが 増えていく…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#arujila_003_01a", "jp": "死んだり壊れたりしたものは\n雲で浄化されて雨になる\nそうしてカルマ教会で新たな生を受ける…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#arujila_003_01b", "jp": "そうか だから…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#arujila_003_02", "jp": "なんでバロンは セラのこと知ってるの?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#arujila_003_03", "jp": "あたしも ジナーナに何かを\nもらったから…わかる気がする", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_03_02", "jp": "大海をたゆたう 小船にも似た人間よ\n荒風を受ける帆の如く胸を張れ\n命の航路を示す針先は 己の内にあり", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_03_03", "jp": "我々は一度 ルーパに忠誠を誓った\nハウンズの色は捨てられん 許されよ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_04_02", "jp": "義を重んじ 己を信じよ\nこれがハウンズの掟だ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#npc_04_03", "jp": "魂というものを知っているか\n人の想いの 情報のようなものだ\nそれを継ぐ者がいればルーパは死なん\nあの男のようにな", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f003/f003.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f003/f003.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f003/f003.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f003/f003.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f003/f003.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f003/f003.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f003/f003.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f003/f003.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f003/f003.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f003/f003.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f003/f003.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f003/f003.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f003/f003.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f003/f003.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f003/f003.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f003/f003.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f003/f003.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f003/f003.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f003/f003.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f003/f003.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f003/f003.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f003/f003.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f003/f003.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f003/f003.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f003/f003.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}]