[{"id": "bf:event/e500/e503/scr/e503.bf#LILITH_001", "jp": "よくここまでたどりついたな。", "zh": "", "speaker_jp": "リリス", "dup": "dup:96cc375c79d5"}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_002", "jp": "・・・神でも悪魔でもない男。\n人である事を捨てたデビルハーツの所有者。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_003", "jp": "お前がここに来る事は解っていた。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_004", "jp": "・・・この世界が産まれた理由、\n・・・お前自身の存在する意味、", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_005", "jp": "・・・そして、この世界の行く末", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_006", "jp": "全ての疑問はモナドに会えば\nわかる・・・、そう信じてるのだろう。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_007", "jp": "・・・全てを知る事がお前にとって\n幸せとは限らぬがな・・・", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_008", "jp": "この道を抜ければ\nモナドに会う事が出来る。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_009", "jp": "ただし、\n通り抜けれればの話だが・・・", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_010", "jp": "それでもお前は\nモナドの地に行く事を望むのか?", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#KAIWA", "jp": "どうしますか?", "zh": "", "speaker_jp": " ", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#KAIWA_SEL", "jp": "それでも進む・・・引き返す", "zh": "", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_011", "jp": "・・・よかろう。\nモナドへとつながる扉を開いてやる。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#LILITH_012", "jp": "・・・そうか。だが気がかわったら\nここに来るんだな。待っているぞ。", "zh": "", "speaker_jp": "リリス", "dup": null}, {"id": "bf:event/e500/e503/scr/e503.bf#ERROR", "jp": "スクリプトのエラーだっちゃ!", "zh": "", "speaker_jp": "リリス", "dup": "dup:e99dfa72fc2f"}, {"id": "bf:event/e500/e503/scr/e503.bf#MODE", "jp": "どのテストにしますか?", "zh": "", "speaker_jp": " ", "dup": "dup:f148273c880f"}, {"id": "bf:event/e500/e503/scr/e503.bf#MODE_SEL", "jp": "テストイベント1 スクリプト2リリスイベントテストイベント2 じっきムービーイベント2のかんせいよてい(ムービー)", "zh": "", "dup": null}]