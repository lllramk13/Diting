[{"id": "bf:event/scr/scene05.bf#ANATO_01", "jp": "エーイチ、その光に触れるな!", "zh": "", "dup": null}, {"id": "bf:event/scr/scene05.bf#ANATO_02", "jp": "これは結界…\nあの女のやりそうなことだ。\nそれにしても古めかしい…\nこもってばかりおるから\n今様のものを知る術がないのだろう。", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene05.bf#ANATO_03", "jp": "さて…\nかような子供だまし、\n私が一息に解いて見せよう!\nエーイチ!\nしかと見ておけ…\nこれがオリエントの神、アナトの力だ!!", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene05.bf#ANATO_04", "jp": "ここから先は私も共に行こう。\nあの女に無沙汰を詫びねばならんのでな…\nフフフフフ…", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene05.bf#AMA_01", "jp": "アナト!\nよくもこの場へぬけぬけと…", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene05.bf#AMA_02", "jp": "そなたによって汚されたのは\n我が容姿ばかりでない!", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene05.bf#AMA_03", "jp": "我が名と…\nそして大和人百万の神々が\n汚されたのだ!", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene05.bf#AMA_04", "jp": "耐えがたきに耐え、忍びがたきを忍び、\n我々日本は再び日の出ずる時を待った。\nそして機は満ちた…", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene05.bf#AMA_05", "jp": "この恥辱を今こそ晴らさん!!\n人百万の怒りと悲しみを\n黄泉の底にて思い知るがいいわーっ!!", "zh": "", "speaker_jp": "アマテラス", "dup": null}]