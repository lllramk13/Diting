[{"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes01", "jp": "お願い やめて", "zh": "求求你，住手", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes02", "jp": "今更後戻りはできない\n私は見つけてしまった", "zh": "事到如今已经无法回头了", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes03", "jp": "人は原点に帰り\n真理へと飛躍するべきだ", "zh": "你应该回到原来的地方去。\n这里不是你该来的地方。", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes04", "jp": "嘘よ", "zh": "骗人", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes05", "jp": "お前も私と同じ\n無くしたものしか必要としていない", "zh": "那就这样吧。\n不要忘记我们的约定。", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes06", "jp": "やめて", "zh": "别这样", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes07", "jp": "私は修羅を解き放つ\n奴らの中に潜む終末の獣", "zh": "我释放修罗，潜伏于他们之中的末世之兽。", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes08", "jp": "悪魔を", "zh": "恶魔。", "dup": null}, {"id": "pm1:event/e600/e601/e601_001/E601_001.PM1@0x130#mes09", "jp": "やめて!!", "zh": "住手", "dup": "dup:a9219dcc2d0c"}]