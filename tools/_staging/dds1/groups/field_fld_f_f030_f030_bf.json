[{"id": "bf:fld/f/f030/f030.bf#SWITH_ORNOT", "jp": ">スイッチがある。\n押しますか?", "zh": "", "dup": "dup:322be00c517a"}, {"id": "bf:fld/f/f030/f030.bf#SWITH_ORNOTSEL", "jp": "スイッチを押す。押さない。", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#SWITH_NO", "jp": ">は、\nそのままにした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#BITON", "jp": ">フラグをオンにしる?", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#YES_OR_NO", "jp": "セラが上に行ったのを見たの洋館をクリアしたの", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#BITON_ON", "jp": ">は、\n「セラが上がるフィールドイベントを見た」\nフラグをオンにした。", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#KAIHUKU", "jp": ">小ターミナルを\n配置予定", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#SERA_ZAN_MIE", "jp": ">セラの残像が見える…。", "zh": "", "dup": "dup:53be3e212690"}, {"id": "bf:fld/f/f030/f030.bf#SERA_ZAN_MIETA", "jp": ">哀しげなセラの残像は消えた…。", "zh": "", "dup": "dup:62925cf3005e"}, {"id": "bf:fld/f/f030/f030.bf#BIKKURI", "jp": ">巨大な気配を感じた!", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#VASKI", "jp": "かるまヲ持ツ\"あすら\"ガ\n乳海ニ侵入スルコトハ許サレナイ\n\"てくのしゃーまん\"ノ命デアル\n退去セヨ 退去セヨ", "zh": "", "speaker_jp": "ヴァスキ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#CONSOLE", "jp": "情報循環しすてむ\n\"さんさーら\"へ ヨウコソ\n当しすてむハ すてーじ1ニオケル\n廃棄情報ノ再精製ヲ行ッテイマス\n破壊サレタ\"あすら\"ノ情報ハ\nコノ乳海デりさいくるサレテイマス", "zh": "", "speaker_jp": "コンソール", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#AREA12_SYSTEM_HELP", "jp": ">カルマ教会から\"曼斗羅\"と呼ばれる\n戦闘技能因子の提供が開始された。\n>\"曼斗羅\"は各地の\"カルマ端末\"から\nダウンロードすることで取得出来ます。", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#GARD_01", "jp": "現在 教会ヘノ出入リハ\nとらいぶノ長ニシカ許可サレテイナイ\n参堂スルカ?", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#GARDY_OR_N", "jp": "参堂する後にする", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON", "jp": "ドノ情報ノ閲覧ヲ求メルカ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMONNSEL", "jp": "悪魔についてカルマについて喰らうについてソーラーノイズについて聞きたいことはない", "zh": "", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON_AKUMA", "jp": "悪魔ハ オ前ノ\"あーとま=本性\"デアル\n\"神\"カラ生マレタスベテノものハ\n元カラ悪魔ノ情報因子ヲ持ッテイル\n\"ういるす\"ハ 起爆剤ニ過ギナイ\n他ニ 情報ノ閲覧ヲ求メルカ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON_KARMA", "jp": "\"かるま(業)\"トハ\nオ前ノ成シタ行為 ソノモノデアル\n悪魔ヲ狩リ 喰ラエバ喰ラウホド\n業ガ貯マリ オ前ハ強クナルダロウ\n他ニ 情報ノ閲覧ヲ求メルカ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON_NOISE", "jp": "悪魔ハ \"情報雑音\"ノ影響ヲ受ケル\n\"そーらーのいず\"ノ増減ガ\nオ前ノ\"狩リ\"ニモ影響ヲ与エルダロウ\n他ニ 情報ノ閲覧ヲ求メルカ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON_KURAU", "jp": "悪魔ハ 多量ノ\"生体まぐねたいと\"ヲ\n摂取シナケレバ生キラレナイ\nソレハ アラユル存在ノ構成情報ニ\n微量ナガラ含マレテイルガ\n悪魔ト人ガ宿ス\"えなじー\"ハ膨大デアル\n敵ヲ喰ラウコトデシカ\nオ前トイウ情報ノ存在ハ維持デキナイ\n他ニ 情報ノ閲覧ヲ求メルカ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#TYOUMON_NOTHNG", "jp": "他ノ悪魔ヲ喰ライ \"かるま\"ヲ積ミ\n最強ノ存在トナレ 煉獄ノ子 喰奴ヨ", "zh": "", "speaker_jp": "聴聞機", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_010_001", "jp": "ボス 曼斗羅の提供が始まったぞ\n曼斗羅は \"ハントスキル\"を使えば\n効率良くマスターできるようだ\n早速 ここの端末から\nダウンロードしてみるといい", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#GARD_BATTLE", "jp": "オ前タチノ立チ入リハ 許可サレナイ\n立チ去ラナケレバ排除スル", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": "dup:c872f52ec236"}, {"id": "bf:fld/f/f030/f030.bf#GARDBT_OR_N", "jp": "そこをどけ!わかった", "zh": "", "dup": "dup:232f7de1e0a4"}, {"id": "bf:fld/f/f030/f030.bf#GARD_SERA", "jp": "コード不明者ノ侵入ハ許サレナイ\n警告ニ従ワナケレバ破壊スル", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#GARD_SERA_01", "jp": "すーぱーばいざーこーる確認\nすーぱーばいざーこーる確認\nこーど不明者ヲ\n\"てくのしゃーまん\"ト認識シタ", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#SERAVSGARD1", "jp": "下がりなさい", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#SERAVSGARD2", "jp": "サーフたちが来るわ\n先へ行かせてはダメ!", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#SERAVSGARD3", "jp": "でも 絶対殺さないで", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ARG_01", "jp": "おわわわわ!?\nこれ 落っこちてんじゃねーの?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#heat_002_01", "jp": "セラは死ぬ気で何かをするつもりだ\n多分 俺たちのためにな…\nこのままでいいわきゃねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#arujila_002_01", "jp": "これみんな… 作りかけの人間だわ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_002_01", "jp": "俺たちはこうやって\n最初からこの姿で作られたわけか\n子供など 見たことがないはずだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_002_01", "jp": "アスラってなんだ…\nステージ1って 何のことだよ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_01a", "jp": "さっきは危機一髪だったなぁ\nどうよ兄貴 オレも役に立つだろ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_01b", "jp": "へへ 相棒がいたからなんだけどさ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_02", "jp": "なんか深刻な空気だけど\nこれだけは確かだと思うわけよ 兄貴\n人生には潤いが必要よ\n辛いときもSmile Smileってさ", "zh": "", "speaker_jp": "シエロ", "dup": "dup:67c802002602"}, {"id": "bf:fld/f/f030/f030.bf#ciero_03", "jp": "なんか深刻な空気だけど\nこれだけは確かだと思うわけよ 兄貴\n人生には潤いが必要よ\n辛いときもSmile Smileってさ", "zh": "", "speaker_jp": "シエロ", "dup": "dup:67c802002602"}, {"id": "bf:fld/f/f030/f030.bf#ciero_04a", "jp": "バロンを殺れば ニルヴァーナか", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_04b", "jp": "ようやっとここまで来たんだな 兄貴", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#ciero_05", "jp": "話が違うじゃねーか!\nオレたちゃこの街のキングだぞ\nキング! 控えおろうってんだ!", "zh": "", "speaker_jp": "シエロ", "dup": "dup:77a91ec7fbde"}, {"id": "bf:fld/f/f030/f030.bf#ciero_06", "jp": "話が違うじゃねーか!\nオレたちゃこの街のキングだぞ\nキング! 控えおろうってんだ!", "zh": "", "speaker_jp": "シエロ", "dup": "dup:77a91ec7fbde"}, {"id": "bf:fld/f/f030/f030.bf#npc_02_01", "jp": "当えりあハ カルマ教会ガ治メル\n不可侵区域デアル", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_03_01", "jp": "当えりあデノ戦闘行為ハ\n一切禁止サレテイル", "zh": "", "speaker_jp": "カルマ教会ガード", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_01", "jp": "いくら縄張りを拡大しようと\n我がブルーティッシュがナンバー1だ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_02", "jp": "いくら戦い方が変わろうと\n我がブルーティッシュがナンバーだ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_03", "jp": "いくらメリーベルのボスが強かろうと\n我がブルーティッシュがナンバー1だ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:d09daedd1fd0"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_04", "jp": "いくらメリーベルのボスが強かろうと\n我がブルーティッシュがナンバー1だ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:d09daedd1fd0"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_05", "jp": "いくらソリッドの壁が厚かろうと\nいずれは我々が落とす", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_06", "jp": "たとえお前がジナーナを倒そうと\n我がブルーティッシュがナンバーだ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:c6b947fb0e52"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_07", "jp": "たとえお前がジナーナを倒そうと\n我がブルーティッシュがナンバーだ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:c6b947fb0e52"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_08", "jp": "弱小同士 せいぜい潰し合え\nニルヴァーナに行くのは我々だ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_09", "jp": "ハウンズを潰した次はお前たちだ\n音を洗って待っていろ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_10", "jp": "お前たちがアジトを移すなどと\nいうことは知らん 早く去れ", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_04_11", "jp": "姑息な手段で戦力を削いだつもりか\nブルーティッシュはまだ十分戦える", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:e24e85b9ef00"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_12", "jp": "姑息な手段で戦力を削いだつもりか\nブルーティッシュはまだ十分戦える", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": "dup:e24e85b9ef00"}, {"id": "bf:fld/f/f030/f030.bf#npc_04_13", "jp": "貴様の手下どもは 貴様に牙を向き\n貴様は バロンの姿を捉えることすらなく\n人つ裂きにされるだろう", "zh": "", "speaker_jp": "ブルーティッシュ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_01a", "jp": "ミックを討つには\n奴がシタデルから出ている今しかない", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_01b", "jp": "急ぐぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_02a", "jp": "アルジラはずっとあの調子か", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_02b", "jp": "このままでは戦力として不安が残る", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_03", "jp": "策はない 付け入る隙を探ることだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_04a", "jp": "ハウンズはまだ持ちこたえているか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_04b", "jp": "今のうちだな\n急ぐぞ サーフ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_05a", "jp": "生存と闘争に疑問を感じる生物か", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:1ec636d2cc41"}, {"id": "bf:fld/f/f030/f030.bf#gale_05b", "jp": "論理矛盾だ 理解…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:2320edccf0ad"}, {"id": "bf:fld/f/f030/f030.bf#gale_06a", "jp": "生存と闘争に疑問を感じる生物か", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:1ec636d2cc41"}, {"id": "bf:fld/f/f030/f030.bf#gale_06b", "jp": "論理矛盾だ 理解…", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:2320edccf0ad"}, {"id": "bf:fld/f/f030/f030.bf#gale_07", "jp": "サーフ いよいよ決戦だ\nこの一戦 是が非でも負けられん\nルーパの遺志を子に伝えるためにも な…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#gale_08a", "jp": "よほど ニルヴァーナに\n行かせたくないようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:73551484a01f"}, {"id": "bf:fld/f/f030/f030.bf#gale_08b", "jp": "恐らく 教会の意思じゃない\nセラの力を見たはずだ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:612ec70ef30f"}, {"id": "bf:fld/f/f030/f030.bf#gale_09a", "jp": "よほど ニルヴァーナに\n行かせたくないようだな", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:73551484a01f"}, {"id": "bf:fld/f/f030/f030.bf#gale_09b", "jp": "恐らく 教会の意思じゃない\nセラの力を見たはずだ", "zh": "", "speaker_jp": "ゲイル", "dup": "dup:612ec70ef30f"}, {"id": "bf:fld/f/f030/f030.bf#npc_01_01", "jp": "エンブリオンのリーダーか\nだがルーパには敵うまい", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_02", "jp": "戦い方が変わるぞ\nエンブリオンのリーダーよ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_03", "jp": "ジナーナのアートマは\n\"アウローラ\"というそうだ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": "dup:10cbea75a722"}, {"id": "bf:fld/f/f030/f030.bf#npc_01_04", "jp": "ジナーナのアートマは\n\"アウローラ\"というそうだ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": "dup:10cbea75a722"}, {"id": "bf:fld/f/f030/f030.bf#npc_01_05", "jp": "ミック・ザ・ニックのアートマは\n\"ソーラエクリプス\"というそうだ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_06", "jp": "アートマによって…世界が動き出した\n俺も…変わる…お前も…", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": "dup:f5c5387b3a6b"}, {"id": "bf:fld/f/f030/f030.bf#npc_01_07", "jp": "アートマによって…世界が動き出した\n俺も…変わる…お前も…", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": "dup:f5c5387b3a6b"}, {"id": "bf:fld/f/f030/f030.bf#npc_01_08", "jp": "裏切りなど 最も恥ずべき行為だ\nハウンズに裏切りなどありえん", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_09a", "jp": "我々はブルーティッシュと交戦中だ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_09b", "jp": "今は圧されているが 最後には勝つ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_10", "jp": "我々の縄張りが包囲されつつある\nブルーティッシュめ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_11a", "jp": "ルーパと連絡が取れん…", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_11b", "jp": "探してくれ ルーパを!", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_12", "jp": "地下…水道?\nなんだそれは\nそこにルーパが現れたというのか", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_13a", "jp": "そうか…狼は誇り高く散ったか", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_13b", "jp": "ならば勝て エンブリオンの長よ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#npc_01_13c", "jp": "ルーパの託した願い…叶えて見せてくれ", "zh": "", "speaker_jp": "ハウンズ構成員 男", "dup": null}, {"id": "bf:fld/f/f030/f030.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f030/f030.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f030/f030.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f030/f030.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f030/f030.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f030/f030.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f030/f030.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f030/f030.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f030/f030.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f030/f030.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f030/f030.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f030/f030.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f030/f030.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f030/f030.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f030/f030.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f030/f030.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f030/f030.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f030/f030.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f030/f030.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f030/f030.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f030/f030.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f030/f030.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f030/f030.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f030/f030.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f030/f030.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f030/f030.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f030/f030.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f030/f030.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}, {"id": "bf:fld/f/f030/f030.bf#AYASIIKEHAI", "jp": ">扉の向こうから\n邪悪な気配を感じる。\n>中に入りますか?", "zh": "", "dup": "dup:b22ae98470f6"}, {"id": "bf:fld/f/f030/f030.bf#ENB", "jp": "狩り殺して皆で山分けするよりも\nハントスキルを使い\n生きたまま捕食することを勧める\n獲物を独占できるだけでなく\nより多くのAPを摂取できるようだ", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}]