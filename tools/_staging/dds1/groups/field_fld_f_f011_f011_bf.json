[{"id": "bf:fld/f/f011/f011.bf#gale_01", "jp": "待て サーフ\nまずい事態になったらしい\n中で作戦計画を練りたい", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujira_001", "jp": "待って サーフ\nセラとヒートと 合流しなくちゃ…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#HEAT_JOIN", "jp": ">ヒートが\nパーティに加わった。", "zh": "", "dup": "dup:32e1ba7ceba5"}, {"id": "bf:fld/f/f011/f011.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f011/f011.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f011/f011.bf#sera_001_01", "jp": "ありがと…サーフ\n大丈夫だから…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#sera_001_02", "jp": "なんか 思い出みたいだね…\n消したはずなのに\nひょんなことで表に出てきちゃうなんて\n情報の循環からも忘れさられた…\n夢の…残骸…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_001_01", "jp": "この苦しさ いってぇなんなんだ…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_001_02a", "jp": "なんでもねぇ…", "zh": "", "speaker_jp": "ヒート", "dup": "dup:5e8ce06a1ebb"}, {"id": "bf:fld/f/f011/f011.bf#heat_001_02b", "jp": "自分で自分を ブチ殺したくなっただけだ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_001_03a", "jp": "一体何を隠してるってんだ セラ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_001_03b", "jp": "俺は そんなアテにならねぇ男なのか?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_001_01", "jp": "あの歌 \"祈り\"って言うそうよ…\nあたしたちが何者なのか\nどこへ行くのか教えて下さい\n導いて下さいって言葉なんだって\nでも大切なものが欠けているから\n届かないって…セラが言ってたわ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_001_02", "jp": "セラ また疲れが出たのかと思ったけど\nなんか違うみたいね\nようやく おなか減ってきたのかしら", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_001_03", "jp": "ジナーナ…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:f30e5564a1dd"}, {"id": "bf:fld/f/f011/f011.bf#arujila_001_04a", "jp": "もしよ…\nもしバロンの言ったことが 正しかったら\nセラはニルヴァーナに戻りたいと思う?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_001_04b", "jp": "あの娘のためになるのかな…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_001_01", "jp": "届かない 祈り…\n欠けている 大切なもの…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_001_03", "jp": "ルーパとの直接交渉には 俺が当たろう\nバロンの刺客という可能性もありえる\nリーダーの代わりはいないからな", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_001_04a", "jp": "俺は 知らないはずのセラの歌を\n知っていたかのように歌ったことがある…\n名も知らぬ 誰かに向けてだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_001_04b", "jp": "あの女 一体…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_001_05", "jp": "セラが消えたのは 何かを思い出したから\nといったところだろうな\nそれを俺たちに知られたくなかったんだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_01", "jp": "よくわかんねぇけど\nあの歌のおかげなんだよな\nまだ 人間のままでいられんの…", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_02a", "jp": "まーた セラが暗い顔んなっちまった", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_02b", "jp": "笑ってたほうがカワイイのになぁ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_03a", "jp": "思い出か 重いねぇ…\nあれ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_03b", "jp": "なんかおかしくなってきたぞ\nなんだ この感じ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_001_04", "jp": "やっとニルヴァーナに行けるってのにさ\nなんでセラは消えちまったんだよ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_01", "jp": "不思議ですね セラの歌を聴いてると\n何か思い出せそうな気がするんです", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:2a764cd2f42c"}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_02", "jp": "不思議ですね セラの歌を聴いてると\n何か思い出せそうな気がするんです", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:2a764cd2f42c"}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_03a", "jp": "みんな よく知らない昔に\n思いを馳せていますね", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_03b", "jp": "セラの歌のせいかな", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_04a", "jp": "ついに…ついにこれで\n僕たち殺し合わなくて済むんだ!", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_01_04b", "jp": "本当に嬉しいです", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_01a", "jp": "異常なし", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_01b", "jp": "セラの歌以外 静かなものよ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_02a", "jp": "私の方が おいしそうだと思うけど", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_02b", "jp": "ヒートって よっぽどセラが好きなのね\n必死すぎて見てらんないわ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_03", "jp": "このアジトも 遺跡なのよね\nジャンクヤードって\n文字通りガラクタの上にできた街\n誰が昔の街を壊して作ったかは\n知らないけどさ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_02_04", "jp": "私たちの頭の中も この土地と一緒で\n記憶の底にガラクタいっぱいありそうね\nしかも 全然違う奴のとかさ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_03_01", "jp": "今 ゲイルに\nハウンズとブルーティッシュの戦況を\n報告しといたんで後で聞いてくれよ", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_04_01", "jp": "なんていうか…Soulに響く歌ね\n哀しいけど安らぐ そんな感じ", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_04_02", "jp": "ニルヴァーナへの片道切符の黒い髪\nジャンクヤードを制霸するか\nあの娘を連れて行くか\nどっちかにして欲しいもんよね", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_04_03", "jp": "色んなものが土から顔出してるとこ見ると\n名残惜しかったのかもね 壊すのがさ\nブルーティッシュの縄張りにも\n変な建物が生えてるって話だよ", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_001_04_04", "jp": "死ぬ前の記憶がないかって?\nあるよ\n私は男で こうやっていつも群れてさ\nずっと誰かと争ってた気がするね\n人間なんて どこでも一緒なのかもね", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#sera_002_01a", "jp": "……", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#sera_002_01b", "jp": "気にしないで 大丈夫だから…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_002_01", "jp": "なんでもねぇ…\nさっさと行け セラは俺がみる", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_002_02", "jp": "セラ なんだ…\nその… 無理する必要はねぇ\nルーパが言ってただろ\nニルヴァーナに行きゃいいんだ\n俺が連れてってやるからよ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_002_03a", "jp": "連中が何もンだろうが\nセラを連れてニルヴァーナに上がる!", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#heat_002_03b", "jp": "そうしなきゃ\n俺はあいつの何もわからねぇ…\n何もしてやれねぇんだ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_002_01", "jp": "また 前みたいなことがあると厄介だし\nセラも連れていったほうがいいわね", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_002_02", "jp": "あたしも初耳よ\n他のことは\n聞いたことあるような気がするのにね", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_002_03a", "jp": "カルマ教会…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#arujila_002_03b", "jp": "今まで考えもしなかったけど\n彼らはいったい何者なの?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_002_01", "jp": "まだ ハウンズが戦力を保ったままならば\n兵力不足を補えるやもしれない\nが バロンの策ということも考えられる\nいずれにしても直に確認することだ", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_002_02a", "jp": "テクノシャーマンという言葉には\n俺も心当たりがない", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_002_02b", "jp": "バロンの口から聞くのがよかろう", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_002_03a", "jp": "テクノシャーマンを求める\nカルマ教会のエンジェルか", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#gale_002_03b", "jp": "エンジェル… エンジェル…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_002_01a", "jp": "ヒート どうしちまったんだ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_002_01b", "jp": "セラも向こう行ったまま\n戻って来ないし…\nなんか変じゃね?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_002_02", "jp": "セラに\nそんなことできるわけねーじゃんな\nあんな細いのに 最強なんてさ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#ciero_002_03", "jp": "オレら\n前からセラを知ってる感じじゃん?\nなんで テクノシャーマンって名前\n知らねーんだ?", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#sera_002_02a", "jp": "テクノ…シャーマン…\n世界を…減ぼす…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#sera_002_02b", "jp": "分からない…分からないよ…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_01a", "jp": "ボス バトンタッチ…", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_01b", "jp": "じゃなかった 伝令よ 伝令", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_01c", "jp": "シタデルでも 地下水道につながってる\nとこ見つけたらしいんだけど\n様子見に行った連中が帰ってこないって\nなんかあったんじゃない?", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_02a", "jp": "ボス 早くタスキタスキ!", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_02b", "jp": "…じゃなかった 伝令よ 伝令", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_01_02c", "jp": "\"一緒に死んだ恋人を探してる\"って\n変な男が縄張りほっつき歩いてるみたいよ\nこれがまた えらい強いらしいんだ\n因縁つけられないように 注意してよね", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_02_01", "jp": "マニプラ方面隊から\nエンブリオン総司令へ 報告です\n旧メリーベル占領地に\n地下水道へのルートを発見致しました", "zh": "", "speaker_jp": "元ブルーティッシュ構成員 女", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_01", "jp": "スワディスターナは\n元アサインメンツの縄張りですよ", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_02a", "jp": "テクノシャーマン?", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:6eda02756d20"}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_02b", "jp": "なんとなく… 聞いたことあるような…\nなんとなく…\nすごい嫌なことを思い出しそうな…", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_03a", "jp": "テクノ…シャーマン…\nテ…クノシャー…マン", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_03b", "jp": "あ…ああ…あああ\nた 太陽が… 太陽が…", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_002_01_03c", "jp": "ヒィィィ!", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_04_01a", "jp": "まぁ… あの妙な赤い壁あるから\n大丈夫だよなきっと…\nいや… でもいつなくなるかなんて\nわからないしな… 本当に大丈夫か?\nうーん… 不安だ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_04_01b", "jp": "あ ボス…\n何をブツブツ言ってるのかって?", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#npc_003_04_01c", "jp": "い いやいや!\nなんでもないんですよ へへ\nあの… スワディスターナのアジトには\nもう近づかないほうがいいですよ", "zh": "", "speaker_jp": "元アサインメンツ構成員 男", "dup": null}, {"id": "bf:fld/f/f011/f011.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f011/f011.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f011/f011.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f011/f011.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f011/f011.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f011/f011.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f011/f011.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f011/f011.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f011/f011.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f011/f011.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f011/f011.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f011/f011.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f011/f011.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f011/f011.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f011/f011.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f011/f011.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f011/f011.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f011/f011.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f011/f011.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f011/f011.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f011/f011.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f011/f011.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f011/f011.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f011/f011.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f011/f011.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f011/f011.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f011/f011.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f011/f011.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}]