[{"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0031", "jp": "後ろの二人も同じか", "zh": "身后那两人也一样吗？", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0032", "jp": "たった三人で来れるわけだな", "zh": "难怪你们只来了三个人。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0275", "jp": "やっぱり アナタもなのね", "zh": "果然，你也是啊。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0041", "jp": "ジナーナだけではない\n皆ほとんどこうなった", "zh": "不只是吉娜娜，大家几乎都变成这样了。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0042", "jp": "直にジャンクヤード中がそうなるだろう", "zh": "很快整个垃圾场都会变成那样吧。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0050", "jp": "戦はもっと厳しくなる\n神の呪いだな…", "zh": "战斗会变得更加严酷。是神的诅咒啊…", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0281", "jp": "呪い?", "zh": "诅咒？", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0282", "jp": "神って なに?", "zh": "神是什么？", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0060", "jp": "わからない\n頭に浮かんだだけだ", "zh": "不知道。只是浮现在脑海里。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0290", "jp": "哀しんで いるの?", "zh": "你在悲伤吗？", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0070", "jp": "哀しい とはなんだ?", "zh": "悲伤是什么？", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0300", "jp": "よくわからないわ\nたぶん 今のアナタみたいな様子", "zh": "我也不太清楚。大概就像你现在这样吧。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0081", "jp": "わけのわからない力で\n手下が何人も死んだ", "zh": "因为莫名其妙的力量，好几个手下都死了。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0082", "jp": "これが \"哀しい\"なら\n確かに 哀しいな", "zh": "不过我们……\n最好还是速战速决。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0090", "jp": "用件を聞こう", "zh": "说说你的来意。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0101", "jp": "面白い", "zh": "有趣。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0102", "jp": "だがその前に お前たちが\n共に戦うに値するか 力を示せ", "zh": "但在那之前，让我看看你们\n是否值得并肩作战，展示力量吧", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NARU0310", "jp": "待ってジナーナ", "zh": "等等，吉娜娜", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0111", "jp": "皆飢えている", "zh": "你总算来了。\n看来你确实有胆量。\n那就开始吧。", "dup": null}, {"id": "pm1:event/e610/e617/e617_001/E617_001.PM1@0x350#NJNA0112", "jp": "奴らの間を抜けて\nジナーナの所まで来るがいい", "zh": "穿过他们之间\n到吉娜娜这里来吧", "dup": null}]