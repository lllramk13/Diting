[{"id": "bf:fld/f/f008/f008.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f008/f008.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f008/f008.bf#heat_01", "jp": "あの娘 なぜここに倒れていた\nこのアザと関係あるのか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:d30dd1048833"}, {"id": "bf:fld/f/f008/f008.bf#heat_02", "jp": "あの娘 なぜここに倒れていた\nこのアザと関係あるのか", "zh": "", "speaker_jp": "ヒート", "dup": "dup:d30dd1048833"}, {"id": "bf:fld/f/f008/f008.bf#heat_03", "jp": "あんな黒髪 見たことねぇはずだ\nなのに なんだってんだ…", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#heat_04a", "jp": "何言ってやがる\nこいつは競争なんだ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#heat_04b", "jp": "殺し合いも共喰いも\n似たようなもんだろが", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#heat_05", "jp": "どんだけ来てみたところで\nもう後戻りはできねぇぞ\nいい加減 覚悟決めるんだな", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_01", "jp": "あの時 ここで何かが起きた\nそれを知りたい", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_02", "jp": "雨… 黒い…ツボミ…?\nそして 光… ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_03b", "jp": "あの物体と…光のせいだ\nあれのおかげで あたしたちは…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:da789bd0fa74"}, {"id": "bf:fld/f/f008/f008.bf#arujila_04a", "jp": "殺し合いだけじゃなくて\n共喰いまでしろっていうの!?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_04b", "jp": "喰わなきゃ喰われる…", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_04c", "jp": "あたしたち なんか悪いことした!?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_05", "jp": "そうね… ここにいても\n嫌なこと思い出すだけだわ", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_01_01", "jp": "光がジャンクヤード中に散った\nアサインメンツの武器なのか ボス", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:e8e120d03024"}, {"id": "bf:fld/f/f008/f008.bf#npc_01_02", "jp": "光がジャンクヤード中に散った\nアサインメンツの武器なのか ボス", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:e8e120d03024"}, {"id": "bf:fld/f/f008/f008.bf#npc_01_03", "jp": "あの光\nアサインメンツの武器ではなかったか", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_01_04", "jp": "敵を喰らって力をつけろ\nというのが新しい掟だそうだな", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:55203f05b618"}, {"id": "bf:fld/f/f008/f008.bf#npc_01_05", "jp": "敵を喰らって力をつけろ\nというのが新しい掟だそうだな", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:55203f05b618"}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01", "jp": "何か用か ボス", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01_2", "jp": "他に確認しておきたいことはあるか", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01_SEL", "jp": "用は無いニルヴァーナについて確認したいトライブについて確認したい", "zh": "", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01_ans0", "jp": "そうか ならばいい", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": "dup:4e9eebc27881"}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01_ans1", "jp": "詳しくは誰も知らない\nただ 楽園と呼ばれている\n我々は皆 そこを目指さねばならない\nそれが掟だ", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_02_01_ans2", "jp": "トライブの所属は色で判断する\n我々エンブリオンはオレンジだ\nボスが倒されたトライブは\n倒した者に従う それが掟だ", "zh": "", "speaker_jp": "エンブリオン構成員 男", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_01", "jp": "アサインメンツは なりを潜めたまま\n一体何があった ボス", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_02", "jp": "アルジラの様子がおかしい\nスワディスターナで何があった ボス", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_03", "jp": "ボス 私…おかしい…\n身体が化け物のように…\nそれに頭の中も…これは一体…", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_04a", "jp": "この力…悪魔と言うそうだな…\n教会から触れがあった と…", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_04b", "jp": "みんな…混乱している…わ ボス", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_03_05", "jp": "色々調べてみたが何も出てこない ボス", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_01", "jp": "縄張りの外では\n何があるか分からない\nこれをもって行け ボス\n>レーションを5個手に入れた。", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_02", "jp": "記憶は回復したか\n基本戦術については", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_02_SEL", "jp": "確認するまでもない確認しておきたい", "zh": "", "dup": "dup:cc5a495cf517"}, {"id": "bf:fld/f/f008/f008.bf#npc_04_02_ans0", "jp": "ならばいい\n戦術なく戦えば 勝機も遠のく\n常に基本を忘れるな", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_02_ans1", "jp": "徹底して敵の弱点を突き\n主導を握れ\n主導を握れば 敵の対応は後手に回り\n我が方の攻勢を維持しやすくなる\n戦いの原則を忘れるな", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_03", "jp": "戦いは攻防一体だ\n防御にも気を配れ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_03_SEL", "jp": "承知している具体的には", "zh": "", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#npc_04_03_ans0", "jp": "ならばいい", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": "dup:089cc52940a0"}, {"id": "bf:fld/f/f008/f008.bf#npc_04_03_ans1", "jp": "敵の攻撃に対応した耐性を張れ\n悪魔の力を使えば それが可能だ\n攻撃を防げば 主導を奪いやすくなる\n逆もまた然りだ\n防ぐだけでなく 反射したり吸収する\n技もあるという\n攻防一体の駆け引き\n遅れをとるな", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f008/f008.bf#arujila_03", "jp": "あの物体と…光のせいだ\nあれのおかげで あたしたちは…", "zh": "", "speaker_jp": "アルジラ", "dup": "dup:da789bd0fa74"}, {"id": "bf:fld/f/f008/f008.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f008/f008.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f008/f008.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f008/f008.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f008/f008.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f008/f008.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f008/f008.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f008/f008.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f008/f008.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f008/f008.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f008/f008.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f008/f008.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f008/f008.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f008/f008.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f008/f008.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f008/f008.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f008/f008.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f008/f008.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f008/f008.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f008/f008.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f008/f008.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f008/f008.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f008/f008.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f008/f008.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f008/f008.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f008/f008.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f008/f008.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f008/f008.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}]