[{"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0490", "jp": "ジナーナ", "zh": "吉娜娜", "dup": "dup:902a08fbb20f"}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0240", "jp": "強いな お前たち", "zh": "你们真强啊。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0500", "jp": "あたしたちのところに\nこの力を抑えられる娘がいるわ", "zh": "我们那里有个能压制这种力量的女孩。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0501", "jp": "さっきみたいに ならなくて済むの", "zh": "这样就不会变成刚才那样了。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0502", "jp": "アナタとあたしは上手くやれる\n皆とだって きっと上手くやれるわ", "zh": "你和我能好好相处，和大家也一定能好好相处的。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0503", "jp": "だから ね\n一緒にセラのところへ行こう", "zh": "所以啊，一起去塞拉那里吧。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0250", "jp": "初めて 見た", "zh": "第一次见到。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0251", "jp": "それが 涙か", "zh": "那就是眼泪吗？", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0510", "jp": "え… やだ 何これ", "zh": "诶…讨厌，这是什么？", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0520", "jp": "止まらない\n止まらないよ ジナーナ", "zh": "停不下来，停不下来啊，吉娜娜。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0260", "jp": "アルジラ 哀しむな", "zh": "阿尔吉拉，不要悲伤。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0261", "jp": "ジナーナは\nお前たちと 仲間になれた", "zh": "吉娜娜已经和你们成为同伴了。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0530", "jp": "仲間?", "zh": "同伴？", "dup": "dup:4600507ddabf"}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0270", "jp": "そう 仲間だ", "zh": "没错，是同伴。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NJNA0271", "jp": "気分がいい 言葉だ…", "zh": "心情舒畅的话语啊…", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0540", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NHET0320", "jp": "喰らってやれ", "zh": "吃掉它们吧。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0550", "jp": "ミックを追うわ", "zh": "我去追米克。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0560", "jp": "ニルヴァーナって\n楽園なんでしょ?", "zh": "涅槃就是乐园吧？", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0561", "jp": "きっと元に戻れて\nこんな思いもしなくて済む所なんだ", "zh": "那一定是个能恢复原状、不用再承受这种痛苦的地方。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NARU0562", "jp": "あたしは こんな所抜け出してやる", "zh": "我要逃离这种地方。", "dup": null}, {"id": "pm1:event/e620/e626/e626_001/E626_001.PM1@0x130#NHET0330", "jp": "もったいねぇ…", "zh": "太可惜了…", "dup": null}]