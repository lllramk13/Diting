[{"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0271", "jp": "そうか 失敗したか", "zh": "是吗，失败了啊。", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0272", "jp": "次のプランはあるのか", "zh": "有下一步计划吗？", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NARU0591", "jp": "プラン プラン プラン!", "zh": "计划、计划、计划！", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NARU0592", "jp": "なんでアナタはそうなの?\n仲間が死んだのよ!?", "zh": "你为什么总是这样？同伴死了啊！？", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0281", "jp": "仲間?", "zh": "同伴？", "dup": "dup:4600507ddabf"}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0282", "jp": "理解不能だ", "zh": "无法理解", "dup": "dup:4fd3e2007688"}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NHET0361", "jp": "気にすんな", "zh": "别在意", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NHET0362", "jp": "気にいった奴が死んで\n気が立ってるだけだ", "zh": "只是你看中的家伙死了，所以情绪激动罢了", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0290", "jp": "気にいった?\n気が立つ…", "zh": "看中？情绪激动……", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NARU0600", "jp": "あたしたちはミックを追う\n止めても無駄よ", "zh": "我们要去追米克。阻止也没用", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0301", "jp": "奴があの要塞から出たとなると\n勝算が無いわけではないか", "zh": "既然那家伙从要塞出来了，也不是没有胜算", "dup": null}, {"id": "pm1:event/e620/e627/e627_003/E627_003.PM1@0x350#NGIL0302", "jp": "了解した 俺も行こう", "zh": "明白了，我也去", "dup": null}]