[{"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL", "jp": "オレ様の連れに\n手ェ出すんじゃねぇ!", "zh": "别碰我的人！\n不准你碰他们！", "dup": "dup:2a35e02afb4a"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_ESCAPE", "jp": "ヘッ、馬鹿が。\nあばよ、ウスノロ。", "zh": "哼，傻瓜。\n再见了，笨蛋。", "dup": "dup:e2b5d580aa1c"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_ESCAPE_ANGRY", "jp": "ケッ、やってられるかってんだ!\nあばよ!", "zh": "切，谁受得了啊！\n再见！", "dup": "dup:6661a44448bc"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_FAIL_MONEY", "jp": "ふざけろッ!", "zh": "开什么玩笑！", "dup": "dup:cdabed333764"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_FAIL_MAG", "jp": "ふざけろッ!", "zh": "开什么玩笑！", "dup": "dup:cdabed333764"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_FAIL_ITEM", "jp": "ふざけろッ!", "zh": "开什么玩笑！", "dup": "dup:cdabed333764"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_EMPTY_MONEY", "jp": "…んだよテメェ、\n持ち金が足りねえじゃねぇか!", "zh": "……搞什么啊你，\n钱不够吧！", "dup": "dup:fcc90e305719"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_EMPTY_MAG", "jp": "…んだよテメェ、\n持ってねえじゃねぇか!", "zh": "……搞什么啊你，\n根本没带吧！", "dup": "dup:73be1ff3f0b2"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_EMPTY_ITEM", "jp": "…んだよテメェ、\n持ってねえじゃねェか!", "zh": "……搞什么啊你，\n根本没带吧！", "dup": "dup:f2c3039e3ed3"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_ATTACK", "jp": "死んで詫びろや!", "zh": "以死谢罪吧！", "dup": "dup:2d3b662de7d7"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_PLAN_INVITE", "jp": "オレ様を引き抜こうってか?", "zh": "想挖走本大爷？", "dup": "dup:9fa0df34a6ff"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_PLAN_MONEY", "jp": "何かよこせだァ?", "zh": "想让老子交东西？！", "dup": "dup:eb150f885f6c"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_PLAN_INFO", "jp": "オレ様の秘密を聞き出そうってか?", "zh": "想打听本大爷的秘密吗？", "dup": "dup:c5edb13b83d6"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_STYLE_SUCCESS", "jp": "あわわ・・・わ、わかったよ!\nわかったから、\nいい大人が子供をイジメないでくれよ!", "zh": "哇哇……好、好吧！\n知道了就请别让大人欺负小孩啊！", "dup": "dup:bf0cfbe3a182"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_STYLE_SUCCESS2", "jp": "あわわ・・・わ、わかったよ!\nわかったから、\nいい大人が子供をイジメないでくれよ!", "zh": "哇哇……好、好吧！\n知道了就请别让大人欺负小孩啊！", "dup": "dup:bf0cfbe3a182"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_STYLE_FAIL", "jp": "カツアゲ?\nガキが笑わせんじゃねえ!", "zh": "打劫？\n小屁孩别惹人笑！", "dup": "dup:b04d3c94b2f9"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_STYLE_FAIL2", "jp": "お前・・・ダマそうとしてるだろ。\nお前みたいなバカが\n俺をハメようなんざ十年早ぇんだよ!", "zh": "你……想骗人吧。\n像你这种蠢货想算计我，\n还早十年呢！", "dup": null}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MONEY", "jp": "あ", "zh": "啊", "dup": "dup:98fdfc0a7426"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MONEY0", "jp": "なら、円出してもらおうか。", "zh": "那就拿钱来吧。", "dup": "dup:bd26d5d344bb"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MONEY1", "jp": "安くしろだァ? チッ……\nじゃあ円で勘弁してやる。", "zh": "要我便宜点？切……\n行吧，给钱就算了。", "dup": "dup:0a9382b7cea0"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MONEY2", "jp": "まだ値切ろうってか?\nいっちょ前に足元見やがる……\n……円でどうだ?", "zh": "还想讨价还价？\n还学人趁火打劫……\n……多少钱怎么样？", "dup": "dup:b60f7487ce94"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MONEY3", "jp": "円だ!\nこれ以上はビタ一文譲れネェ!", "zh": "就这么多！\n再多一毛都不能少！", "dup": "dup:7eb1abb86123"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_MAG", "jp": "MAGよこしな。", "zh": "拿MAG来。", "dup": "dup:ec280086ac20"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_ITEM", "jp": "よこしな。", "zh": "交出来。", "dup": "dup:5cd557877cde"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_SEL", "jp": "渡す渡さない", "zh": "给还是不给", "dup": "dup:5643ba33c6e4"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_CONTINUE", "jp": "うーん、まだ足りねェな……", "zh": "嗯——还不够啊……", "dup": "dup:e3ef3aa10433"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_HELP_SUCCESS", "jp": "チッ、しょうがねえなァ…", "zh": "切，真没办法啊……", "dup": "dup:44a9f38e47c2"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_HELP_FAIL", "jp": "テメェの意見なんざ聞いてねー!", "zh": "谁听你的意见啊！", "dup": "dup:6501d134c6ff"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_SUCCESS_HELP", "jp": "ま、当然だな。", "zh": "嗯，当然了。", "dup": "dup:5e26e5e3c94d"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_SUCCESS_NOHELP", "jp": "当然だ。", "zh": "当然。", "dup": "dup:7dd36f542987"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_FAIL_HELP", "jp": "テメェ、いい度胸だ!", "zh": "你这家伙，胆子不小啊！", "dup": "dup:1458eb060618"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_REQ_FAIL_NOHELP", "jp": "ふざけろッ!", "zh": "开什么玩笑！", "dup": "dup:cdabed333764"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_SUCCESS_INVITE", "jp": "いいだろう。\nオレ様を連れていけ。\nが仲魔になった", "zh": "行吧。\n带本大爷走。\n成了你的仲魔了", "dup": "dup:b0269d59174f"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_SUCCESS_MONEY", "jp": "円だ。\nこれ持って失せな。", "zh": "钱。\n拿着滚吧。", "dup": "dup:13ed1175cdff"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_SUCCESS_MAG", "jp": "MAGだ。\nこれ持って失せな。", "zh": "MAG。\n拿着滚吧。", "dup": "dup:4b20597293b5"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_SUCCESS_ITEM", "jp": "だ。\nこれ持って失せな。", "zh": "。\n拿着滚吧。", "dup": "dup:c3e799c0d80b"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_SUCCESS_INFO", "jp": "まあいい、教えてやる。\n『ルイージ』って名前は、\n兄貴の『類似』品だから付いたらしいぜ。\nヒデェよな。", "zh": "算了，告诉你好了。\n「路易吉」这名字，\n听说是和他哥的「类似」品才这么叫的。\n够逊的吧。", "dup": "dup:b2ac0241e257"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_INVITE", "jp": "オレ様がテメェの仲魔だァ?\n寝ぼけんな!", "zh": "本大爷做你的仲魔？\n做梦吧！", "dup": "dup:278a703fc592"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_MONEY", "jp": "豚が真珠を\n欲しがってんじゃねえ!", "zh": "猪也配吃珍珠！\n少痴心妄想了！", "dup": "dup:7b61748a82ca"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_MAG", "jp": "テメェなんざ\nMAG切らして死にやがれ!", "zh": "像你这种家伙，\n没MAG了就去死吧！", "dup": "dup:7dafe4e22f83"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_ITEM", "jp": "豚が真珠を\n欲しがってんじゃねえ!", "zh": "猪也配吃珍珠！\n少痴心妄想了！", "dup": "dup:7b61748a82ca"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_FAIL_INFO", "jp": "テメェなんぞに話す事はねえ。\n失せろ!", "zh": "没什么好跟你说的。\n滚吧！", "dup": "dup:39a3cb745830"}, {"id": "bmd:battle/script/0x2d.bmd#DUMMY_ERROR", "jp": "まだ何か用か。\n話はもう済んだろうが!", "zh": "还有事吗？\n话已经说完了吧！", "dup": "dup:33f313e48d15"}]