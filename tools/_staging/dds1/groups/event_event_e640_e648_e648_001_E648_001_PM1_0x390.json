[{"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XMIC0011", "jp": "しらみつぶしに探せ!", "zh": "逐一搜查！", "dup": "dup:83477d9e2f9c"}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XMIC0012", "jp": "息の根を止めねぇと\n俺たちがバロンに喰われるぞ!", "zh": "不弄死他的话\n我们就要被巴隆吃掉了！", "dup": "dup:8c4366d23ef4"}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0140", "jp": "ようやくここに気付いたか", "zh": "你终于发现这里了？", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0151", "jp": "この先は ブルーティッシュの\n拠点にも繋がっている", "zh": "布鲁卜斯……\n你这个叛徒！", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0152", "jp": "君たちでバロンを仕留めろ", "zh": "由你们来干掉巴隆。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0153", "jp": "私が時間を稼ぐ", "zh": "我来拖延时间。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NSIE0420", "jp": "あんな大勢?\nアンタそりゃ いくらなんでも", "zh": "那么多人？你这也太离谱了。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0160", "jp": "私も長だった男だ\n奴がいなければ どうということはない", "zh": "我也是当过首领的人。如果没有那家伙，根本不足为惧。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NGIL0800", "jp": "どういう意味だ", "zh": "什么意思", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0170", "jp": "ハウンズは バロン一人に敗れたのだ", "zh": "猎犬队", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NARU1090", "jp": "たった 一人にですって?", "zh": "你说就一个人？", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0181", "jp": "奴は 何か特別な力を得た", "zh": "那家伙", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0182", "jp": "普通に戦えば勝機は無い\n恐らく その娘の力が必要になるだろう", "zh": "正常战斗的话没有胜算，恐怕需要那个女孩的力量吧。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NSER0390", "jp": "私… が?", "zh": "我…吗？", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0190", "jp": "先払いだ", "zh": "是预付的", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NGIL0810", "jp": "ルーパ", "zh": "鲁帕", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NGIL0820", "jp": "俺にも 会わねばならない者がいる\n一緒にニルヴァーナへ行こう", "zh": "……你这个混蛋。\n我不会饶了你的。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0201", "jp": "全てのトライブの頂点に立つには\nそのリーダーを斃さねばならん", "zh": "要站在所有部落的顶点，就必须打倒他们的首领。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0202", "jp": "教会がそれを許すかな", "zh": "教会会允许吗？", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NGIL0830", "jp": "その時は 教会も斃すさ", "zh": "那时，连教会也一起打倒。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#NLUP0210", "jp": "承知した", "zh": "明白了。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XMIC0020", "jp": "いたか!?", "zh": "找到了吗？", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XRLD0090", "jp": "いや いねぇ", "zh": "不，不在。", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XMIC0030", "jp": "その奥も探せ!", "zh": "里面也搜！", "dup": null}, {"id": "pm1:event/e640/e648/e648_001/E648_001.PM1@0x390#XBAT0010", "jp": "了解", "zh": "了解。", "dup": "dup:dcd61f0cb20f"}]