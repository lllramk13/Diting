[{"id": "bf:event/e910/e911/scr/e911.bf#MSG_SERA_00", "jp": "(また暴走にかかったのかよ…チッ)", "zh": "（又暴走了吗…切）", "speaker_jp": "セラ", "dup": null}, {"id": "bf:event/e910/e911/scr/e911.bf#MSG_HARI_00", "jp": "大したものだが ここまでだ", "zh": "虽然了不起，但也就到此为止了", "speaker_jp": "ハリ・ハラ", "dup": null}, {"id": "bf:event/e910/e911/scr/e911.bf#MSG_HARI_01", "jp": "貴様らは上には上がれんよ!", "zh": "你们是上不去的！", "speaker_jp": "ハリ・ハラ", "dup": "dup:aba82d2adc5a"}]