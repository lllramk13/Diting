[{"id": "bf:event/scr/scene06.bf#ANATO_01", "jp": "さて、戦利品を頂戴するぞ…", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene06.bf#ANATO_02", "jp": "ハッ…\nこ、これは『ヤタの鏡』!!\nなんと…『草薙の剣』ではなかったのか?", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene06.bf#ANATO_03", "jp": "それを早く申しておれば\n命失うこともなかったろうに…", "zh": "", "speaker_jp": "アナト", "dup": null}, {"id": "bf:event/scr/scene06.bf#ANATO_04", "jp": "まったく、どこまで馬鹿な女だ…", "zh": "", "speaker_jp": "アナト", "dup": null}]