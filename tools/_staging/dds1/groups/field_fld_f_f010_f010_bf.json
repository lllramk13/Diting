[{"id": "bf:fld/f/f010/f010.bf#YES_NO", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#hungry", "jp": ">サーフ達の心に飢えがよぎる…。", "zh": "", "dup": "dup:98dfcc5e2140"}, {"id": "bf:fld/f/f010/f010.bf#hungry02", "jp": ">餓えはサーフ達の体力を少し奪った…。", "zh": "", "dup": "dup:52509637e810"}, {"id": "bf:fld/f/f010/f010.bf#sera_01", "jp": "わぁ～ スゴイねサーフ\nねぇ… 登って…いい?", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_SEL", "jp": "ああ いいよ後にしよう", "zh": "", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_ans0", "jp": "ありがとう!\n私 この船知ってる気がするの\n船はね 本当は海にあるんだよ\n海って 広くてとっても綺麗なの…\nね 早く行こう!", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_01_ans1", "jp": "そう…\nじゃあ がまんするね…", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#sera_02", "jp": "行きたいな… 海", "zh": "", "speaker_jp": "セラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01", "jp": "おいサーフ この鉄クズ…\nどっかで見た気しねぇか?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_SEL", "jp": "そう言われれば…バカな…初めて見たはずだ", "zh": "", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_ans0", "jp": "やっぱり お前もか…\n俺 お前 セラ アルジラ シエロ…\n5人で 乗った気がしねぇか…?", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#heat_01_ans1", "jp": "俺だってそうだ\nなんだってんだ…スッキリしねぇ", "zh": "", "speaker_jp": "ヒート", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#arujila_01", "jp": "あれ\"船\"よね…\n船って\n\"海\"に浮かんでるんじゃないの…?", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01", "jp": "なんだこれは…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_SEL", "jp": "船…だと思うああ…なんなんだこいつは", "zh": "", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_ans0", "jp": "そんなことはわかっている\n初めて見たが これは艦艇の類だ\n理解不能なのは なぜここにあるかだ\nいや それ以前に…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#gale_01_ans1", "jp": "初めて見たが これは艦艇の類だ\nそれは理解できる\n理解不能なのは なぜここにあるかだ\nいや それ以前に…", "zh": "", "speaker_jp": "ゲイル", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#ciero_01a", "jp": "見ろよ兄貴\nセラ あんなに喜んでるぜ", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#ciero_01b", "jp": "泣くってんだっけ? あんな顔よりさ\nあっちの方があってるな", "zh": "", "speaker_jp": "シエロ", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01", "jp": "ボス ここで罠を張るんですよね?\n補給はしっかりしてって下さいよ\nたぶん 途中で仕入れに戻ってる暇なんか\nないでしょうから", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_SEL", "jp": "心配ないそうだな…", "zh": "", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_ans0", "jp": "相手はブルーティッシュです\n死ぬ気でいかなきゃ勝てないでしょうけど\n…死なないで下さいよ", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#npc_01_01_ans1", "jp": "そうでしょう?\n早く準備してきて下さいよ!\n奴ら いつ攻めて来るかわかりませんから", "zh": "", "speaker_jp": "エンブリオン構成員 女", "dup": null}, {"id": "bf:fld/f/f010/f010.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f010/f010.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f010/f010.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f010/f010.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f010/f010.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f010/f010.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f010/f010.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f010/f010.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f010/f010.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f010/f010.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f010/f010.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f010/f010.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f010/f010.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f010/f010.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f010/f010.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f010/f010.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f010/f010.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f010/f010.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f010/f010.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f010/f010.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST0", "jp": ">メッセージテスト\nまずは基本だ……。", "zh": "", "dup": "dup:debdba1a5bab"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1", "jp": ">メッセージテスト\n次は選択肢だ。", "zh": "", "dup": "dup:f3c36ec5c05d"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_YES", "jp": "はい…だと?", "zh": "", "dup": "dup:c69f1cf5e902"}, {"id": "bf:fld/f/f010/f010.bf#INFTEST1_NO", "jp": "いいえ…だと?", "zh": "", "dup": "dup:cd5619bdd771"}]