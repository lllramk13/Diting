[{"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_bullet_set", "jp": ">はを排莢し、\nを装填した。", "zh": ">退出了弹壳，\n装填上了。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_bullet_set_err", "jp": ">は既に装填されている。", "zh": ">已经装填过了。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_sel01", "jp": "はいいいえ", "zh": ">这样好吗?", "dup": "dup:794ae24722fa"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_000", "jp": "ダミー", "zh": "虚拟目标", "dup": "dup:f9a799ae2032"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_001", "jp": ">は、\n息を吹き返した。", "zh": "开始捆绑英雄", "dup": "dup:c5471917dcd5"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_002", "jp": ">は、\n息を吹き返した。", "zh": ">开始吞噬灵魂。", "dup": "dup:c5471917dcd5"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_003", "jp": ">たちの\n気配が消えた。", "zh": ">们的\n气息消失了。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_004", "jp": ">たちの\n気配が強まった。", "zh": ">们的\n气息变强了。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_005", "jp": ">たちの体が、\nわずかに浮き上がった。\n床からのダメージを受けなくなった。", "zh": ">们的身体\n微微浮了起来。\n不再受到来自地面的伤害。", "dup": "dup:caa5a0d566a1"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_skill_006", "jp": ">強烈な光が\n周囲を照らし出した。", "zh": ">强烈的光芒\n照亮了四周。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_000", "jp": "ダミー", "zh": "是/否", "dup": "dup:f9a799ae2032"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_001", "jp": ">は、\n英を束き初した。", "zh": "开始捆绑英雄", "dup": "dup:b09ce957a249"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_002", "jp": ">は、\n英を束き初した。", "zh": ">开始聚集英。", "dup": "dup:b09ce957a249"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_003", "jp": ">悪魔を退ける奇香が\n周囲に立ち込めた。", "zh": ">驱退恶魔的奇香\n弥漫在四周。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_004", "jp": ">悪魔を誘う妖しの音が\n周囲にこだました。", "zh": ">引诱恶魔的妖异之音\n回荡在四周。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_005", "jp": ">たちの体が、\nわずかに浮き上がった。\n床からのダメージを受けなくなった。", "zh": ">们的身体\n微微浮了起来。\n不再受到来自地面的伤害。", "dup": "dup:caa5a0d566a1"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_item_006", "jp": ">光玉の放つ強烈な光が\n周囲を照らし出した。", "zh": ">光珠放射出的强烈光芒\n照亮了四周。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_000", "jp": "はすぐにも\n有虎しそうだ‥", "zh": "马上就要变化了……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_001", "jp": "は変化しないようだ…", "zh": "似乎不会变化……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_002", "jp": "の変化の兆しが\n大きくなってきている…", "zh": "的变化征兆\n越来越明显了……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_003", "jp": "の変化の兆しは\nまだ微かだ…", "zh": "的变化征兆\n还很微弱……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_004", "jp": "の変化は\nまだ先のようだ…", "zh": "的变化\n似乎还很微弱……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_tokusyu_005", "jp": "は変化しそうだが…\n目覚めつつある力は、今の\nでは扱えそうにない…", "zh": "虽然似乎要变化了……\n但正在觉醒的力量，以现在的\n状态似乎无法驾驭……", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_is_err_000", "jp": "ダミー", "zh": "虚拟", "dup": "dup:f9a799ae2032"}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_is_err_001", "jp": ">襲に静いている。", "zh": ">在袭击中安静了。", "dup": null}, {"id": "slpm_msg:SLPM_655.97@0x27c7d0#msg_is_err_002", "jp": ">ここでは使えない。", "zh": ">在这里无法使用。", "dup": "dup:5cecb7fdcab2"}]