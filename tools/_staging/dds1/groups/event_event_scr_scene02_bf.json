[{"id": "bf:event/scr/scene02.bf#TAKE_02_01", "jp": "おうおうおうおう!\nゲセンの者が物欲しそうに見上げよるわ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_02", "jp": "んんっ?\nひょっとして貴様ら、小生意気にも\nアマテラスさまにお目通り願いたいとか!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_03", "jp": "んー!\nアマテラスさまにお会いしたいのは解るが\nあいにく…", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_04", "jp": "あいにく、\nあの中にお隠れ中なのだ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_05", "jp": "こうなったのもアナト!\nあの女のせいなのだ!\n奴の呪いで姿を汚され、心を痛められた!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_06", "jp": "おお、そうだ!\nヒマそうな貴様らに\n折り入ってお頼み申す!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_07", "jp": "アマテラスさまのお姿を\n元に戻すという『伝説の神器』が\nこの動物園のどこかにあるらしい!\nそれを探し出し\nここへ届けてもらいたい!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_SEL_01", "jp": "もちろんだ、任せてくれ俺はアマテラスを殺しに来た", "zh": "", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_Y_01", "jp": "おお、そう来ると思ってましたぞ!\nいやいや、聞くまでもなかったですなあ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_Y_02", "jp": "ところで『伝説の神器』だが…\nいったいどこにあるんでしょうなあ!\n私にも皆目見当が付かん!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_Y_03", "jp": "おおっ、そうだ!\nこもれびの小径には『物知りな悪魔』が\n多いと聞く!\n彼らなら\n何か知っているかもしれませんぞ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_Y_04", "jp": "こもれびの小径はこの裏手になります!\nさっそく行ってみてはいかがでしょう!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_N_01", "jp": "なっ、なんと!\n貴様、アナトの刺客であったか!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_N_02", "jp": "アマテラスさま! お逃げくだされーっ!\nここは私におまかせを～～～～～～～っ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_02_N_03", "jp": "追わせるものか!\n貴様の相手は、この私だ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene02.bf#TAKE_LOSE", "jp": "ア…マテラス様は\n御…所にお戻りだ…\n御所で…とうに結界など\n張っておられよう…\n貴…様ごとき若造にゃ…\nあれは破…れんよ…\nグ…ッ", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}]