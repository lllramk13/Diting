[{"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0171", "jp": "あれがソリッドの城砦だ", "zh": "那就是索利德的堡垒", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0172", "jp": "あのおかげで ブルーティッシュも\nソリッドに手出しができない", "zh": "多亏了它，布鲁蒂什\n也无法对索利德出手。", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NARU0370", "jp": "だから アナタたちに攻撃を\n集中できるってわけ", "zh": "所以才能把攻击\n全都集中到你们身上。", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NHET0260", "jp": "ボスを殺れば済むことだろうが", "zh": "只要干掉头目就能解决吧", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0181", "jp": "ミック・ザ・ニックは用心深い", "zh": "但米克·扎·尼克很谨慎", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0182", "jp": "自分は戦場には出てこない", "zh": "他自己不会上战场", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NARU0380", "jp": "厄介ね どうするの?", "zh": "真麻烦，你打算怎么办？", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0191", "jp": "メリーベルが陽動を仕掛ける", "zh": "梅丽贝尔会进行佯攻", "dup": null}, {"id": "pm1:event/e620/e620/e620_001/E620_001.PM1@0x250#NJNA0192", "jp": "正面に手勢を拘束するから\nその隙に潜入してミックを殺せ", "zh": "梅丽贝尔会进行佯攻，\n趁此机会从背后偷袭米克。", "dup": null}]