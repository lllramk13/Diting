[{"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NSER0420", "jp": "力に力で抗ってもダメ…\n溺れたら もう誰も止められないの", "zh": "以力抗力也是徒劳……一旦沉溺其中，就再也无人能阻止了。", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NSER0431", "jp": "だから神は…!", "zh": "所以神……！", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NSER0432a", "jp": "こんな悲しい輪廻を\n断たなきゃダメだって…", "zh": "必须斩断这悲伤的轮回……", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NSER0432b", "jp": "でも私… 私…", "zh": "但是我……我……", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NLUP0240", "jp": "私を… 喰らえ", "zh": "把我……吞噬吧。", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NGIL0860", "jp": "子には 何を伝えればいい", "zh": "该向孩子传达些什么呢。", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NLUP0251", "jp": "誇り… 高い男になれと", "zh": "骄傲……要成为一个高傲的男人。", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NLUP0252", "jp": "オリーブの葉を… 持っているはずだ", "zh": "你应该持有橄榄叶……", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NGIL0870", "jp": "貴方の誇りは受け取った\n必ず息子に伝えよう", "zh": "我收下了你的骄傲。一定会传达给儿子。", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NGIL0881", "jp": "エンジェルか悪魔か知らないが", "zh": "不知道你是天使还是恶魔，但……", "dup": null}, {"id": "pm1:event/e650/e650/e650_001/E650_001.PM1@0x130#NGIL0882", "jp": "俺にこんな力を与えたことを\n悔やむがいい!", "zh": "后悔给了我这样的力量吧！", "dup": null}]