[{"id": "bf:event/scr/scene04.bf#TAKE_01", "jp": "おおっ!\nそ、それはーっ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene04.bf#TAKE_02", "jp": "いやーっ、ついに見つかったのですな!\nお見事、お見事!\n貴殿に任せて正解でしたなあ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene04.bf#TAKE_03", "jp": "さあっ!\nあちらへ神器をかざしてくだされっ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene04.bf#AMA_01", "jp": "ああ…\n力が満ちてゆく…\nこれが、これが私の真の姿なのだ!", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene04.bf#AMA_02", "jp": "エーイチ殿。\nそなたのお陰で私は目覚め、\n日本の大地は再び芽吹いた!", "zh": "", "speaker_jp": "アマテラス", "dup": null}, {"id": "bf:event/scr/scene04.bf#AMA_03", "jp": "こたびにおけるそなたの大功、\n我が魂に深う銘じようぞ…\nそして人百万の神々は\nそなたの名を千代に語り継ぐであろう…", "zh": "", "speaker_jp": "アマテラス", "dup": null}]