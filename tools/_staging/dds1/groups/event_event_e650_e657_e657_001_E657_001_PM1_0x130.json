[{"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0551", "jp": "止めて!", "zh": "住手！", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0552", "jp": "なんでもするから\nお願い 消さないで…", "zh": "我什么都愿意做，求求你，别消失…", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NARU1230", "jp": "セラ!", "zh": "塞拉！", "dup": "dup:8ffa3fe756ea"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NGIL0940", "jp": "あいつが エンジェルか…?", "zh": "那家伙就是天使吗…？", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0191", "jp": "ご苦労だったな", "zh": "辛苦你了", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0192", "jp": "お前たちも回収するつもりだったが\n事情が変わった", "zh": "我本来也打算回收你们，但情况变了", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0193", "jp": "私の望みが叶うまで\n大人しくこの煉獄にいてもらおう", "zh": "在我的愿望实现之前，你们就老实", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NHET0821", "jp": "もう教会の指図は受けねぇ", "zh": "再也不接受教会的指示了", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NHET0822", "jp": "てめぇをぶっ殺してでも\n俺たちはセラとニルヴァーナへ行く", "zh": "就算宰了你，我们也要去塞拉和涅槃。", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0200", "jp": "止めろ", "zh": "住手！", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0560", "jp": "来ないで!", "zh": "别过来！", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSAF0050", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NARU1240", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NHET0830", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSIE0540", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NGIL0950", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSIE0550", "jp": "なんでだよ… セラ", "zh": "为什么啊… 塞拉", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0570", "jp": "みんな また会えて\nうれしかった", "zh": "大家，能再见面，我很高兴", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NARU1250", "jp": "行っちゃ… ダメよ", "zh": "别走… 不行啊", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0580", "jp": "お願い\n来ないで サーフ", "zh": "求你了 别过来 瑟夫", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NHET0840", "jp": "ク… ソ", "zh": "可… 恶", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0590", "jp": "ダメよ 止まって", "zh": "不行啊 停下来", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0211", "jp": "お前は美しい", "zh": "你很美", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0212", "jp": "己が生きるため 他者を屠り喰らう", "zh": "为了自己生存，屠杀并吞噬他人", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0213", "jp": "命が背負う業を\n最もシンプルに体現する存在だ", "zh": "是生命所背负的业，以最简单的方式体现的存在", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0221", "jp": "だからこそ 無駄は許せん…", "zh": "正因如此，不容浪费…", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0222", "jp": "貴様らの信じるものが\n如何に無価値か教えてやろう", "zh": "让我来告诉你们，你们所相信的东西是多么毫无价值", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NSER0600", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NANG0230", "jp": "私の蒔いた種がどう育ったか\n見せてもらおうか!", "zh": "让我看看我播下的种子长成了什么样吧！", "dup": null}, {"id": "pm1:event/e650/e657/e657_001/E657_001.PM1@0x130#NHET0850", "jp": "上等だァッ!", "zh": "正合我意啊！", "dup": null}]