[{"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0241", "jp": "敵と", "zh": "与敌人？", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0242", "jp": "協力するって言うの?", "zh": "你是说要合作？", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0191", "jp": "これまで 全てのトライブが\n自分たちの力のみで戦ってきた", "zh": "至今为止，所有部族都只凭自身之力战斗。", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0192", "jp": "硬直した思考は 戦術の幅を狭める", "zh": "僵化的思维会缩小战术的广度", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0251", "jp": "\"敵の敵は味方\"ってわけ", "zh": "“敌人的敌人就是朋友”就是这个意思", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0252", "jp": "アナタ ちょっと変わった?", "zh": "你有点变了？", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0201", "jp": "変わったのはお前たちの方だ\n情緒面の不安定が伺える", "zh": "变的是你们才对。能看出情绪上的不稳定", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0202", "jp": "理解不能だ", "zh": "无法理解", "dup": "dup:4fd3e2007688"}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NHET0221", "jp": "セラはどうすんだ", "zh": "塞拉怎么办？", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NHET0222", "jp": "今ごろ どいつもこいつも\n血眼んなって捜してるはずだ", "zh": "现在这个时候，他们应该都在拼命寻找吧", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0211", "jp": "俺とシエロが残る\nまだどこにも知られていないはずだ", "zh": "我和谢洛留下。应该还没有人知道", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0212", "jp": "以後 緘口令を敷き\nセラの存在を隠す", "zh": "今后实施禁口令，隐藏塞拉的存在", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NSIE0090", "jp": "リーダーの判断は", "zh": "领导的决定是？", "dup": "dup:1da1dbed751b"}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#HANDAN_SEL", "jp": "協力はするが騙し討ちはしないいい作戦だ", "zh": "会合作但不会偷袭。是个好计划", "dup": "dup:77d92f22f765"}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NHET0231", "jp": "甘ぇな", "zh": "太天真了", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NHET0232", "jp": "殺らなきゃ殺られるぜ", "zh": "不杀就会被杀", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0261", "jp": "騙まし討ちってのが引っかかるけど", "zh": "不过“偷袭”这点让我在意", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NARU0262", "jp": "決まりね", "zh": "就这么定了", "dup": null}, {"id": "pm1:event/e610/e616/e616_001/E616_001.PM1@0x330#NGIL0221", "jp": "では メリーベルの縄張りへ向かえ", "zh": "那么，前往梅莉贝尔的领地", "dup": null}]