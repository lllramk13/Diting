[{"id": "bf:fld/f/f023/f023.bf#KEHAI_KIETA", "jp": ">何者かの気配は消えた…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#START_MESSAGE", "jp": ">至るところから\n飢えた視線と気配を感じる…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_VOICE01", "jp": ">どこからか囁き合う声が聞こえる…。\n…来た 餌がきた…", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_VOICE02", "jp": ">どこからか囁き合う声が聞こえる…。\n俺は あの女の胸を喰う…\n俺は尻を…\nおうぇは美味そうな脚ヲモラウ", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_1_1", "jp": "エンブリオン!", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_1_2", "jp": "共にソリッドを倒すだと\n意味がわからない", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_1_3", "jp": "力になると言うのなら\n大人しく餌になってもらおうか", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_1_ALG", "jp": "意味 わかってくれた?\nあたしたちと一緒に戦えば 楽だってこと", "zh": "", "speaker_jp": "アルジラ", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#HINT_01", "jp": "わ わかったような気がする…\nジナーナは 4番ゲートの奥に向かった\nみんな腹をすかしている\n他の連中に襲われないよう気を付けろ", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_VOICE03", "jp": ">どこからか囁き合う声が聞こえる…。\n…活きのいい餌だ…\n…喰いがいがある…", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_VOICE04", "jp": ">どこからか囁き合う声が聞こえる…。\n…とうに喰い尽くされていると思ったが…\n…弱小トライブの斥候と侮ったか…", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_VOICE05", "jp": ">どこからか囁き合う声が聞こえる…。\n…手強い 手強いぞ…\n…人数を集めろ…", "zh": "", "speaker_jp": "声", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_3_1", "jp": "本当にここまで来たか\nジナーナの言った通りだ", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_3_2", "jp": "喰らえるものなら 喰らってかまわん\nとも言っていた", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_3_3", "jp": "おかしな話だ\n喰らえないはずなどないのに", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_3_4", "jp": "本当に… 喰らえなかった…", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE1_3_5", "jp": "てか… むしろオレ様ピンチ…?\nですか～ みたいな…\nお…お…おおお\nお助けぇぇぇぇ～!!", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOLID_RUNAWAY", "jp": ">あれはソリッドの構成員だ…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#GATELOCK_01", "jp": "HAHAHA!\nゲートを閉じろ!\n簡単にゃ出すんじゃねぇぞ", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE21_1", "jp": "HAHAHA!\nそう簡単に通すわけねーだろ バーカ\nかかれ!", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AFT_BATTLE21", "jp": "うお 西側へ逃げたぞ\n回り込め!", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE22_1", "jp": "待てやコラ!", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE22_2", "jp": "あぶねえ…\nちょっと焦って Hurry upしちゃったぜ\n7番だ 7番ゲートにいるぞ!\n数で押しつぶせ!", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE23_1", "jp": "くそっ\nもうこんな所まで来やがった…\n閉じ込めて時間稼ぎするって\n話じゃなかったのかよ!?", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BATTLE24_1", "jp": "待てっつってんだろ あぁ!?", "zh": "", "speaker_jp": "ソリッド構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#CONFIRM_BATTLE", "jp": ">扉の向こうに何者かの気配がする…。\n>扉を開けますか?", "zh": "", "dup": "dup:7e4b247cddb4"}, {"id": "bf:fld/f/f023/f023.bf#WIN_BYAKKO", "jp": ">\"白色の龍玉\"を手に入れた。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BYAKKO_NPC_01", "jp": "ボス… 突然現れたひよっ子に…\nボスを探してる… 気をつけ…", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#BYAKKO_NPC_02", "jp": "なんなの… あいつ…\nニュービーのはずなのに…\nその壁すら… なんなく…", "zh": "", "speaker_jp": "元ソリッド構成員 女", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#YESNO_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#QUES", "jp": ">ゲートのスイッチのようだ…。\n>スイッチを押しますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN", "jp": ">ゲートのロックは解除されている…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOOK_01GATE", "jp": ">01と書かれたゲートが見える…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_01", "jp": ">1番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_02", "jp": ">2番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_03", "jp": ">3番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_04", "jp": ">4番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_05", "jp": ">5番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_06", "jp": ">6番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#OPEN_07", "jp": ">7番ゲートのロックを解除した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#HEAT_OUT", "jp": ">ヒートが\nパーティから離脱した。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#RECOVER_FREE", "jp": ">HP・MPが回復した。", "zh": "", "dup": "dup:c0e31c8d41b5"}, {"id": "bf:fld/f/f023/f023.bf#RECOVER_FREE_HINT", "jp": "その緑のヤツは\nあの光が降った時に急に現れた\nそれに触ると傷が回復するようだ", "zh": "", "speaker_jp": "元メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST", "jp": "テスト", "zh": "", "dup": "dup:63b560db8849"}, {"id": "bf:fld/f/f023/f023.bf#USO_KAIFUKU", "jp": "(現在は機能していません)", "zh": "", "dup": "dup:31f68b6dc1df"}, {"id": "bf:fld/f/f023/f023.bf#TEST_2ND_START", "jp": "2回目 開始演出", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_01", "jp": "デバッグ用に設置してます", "zh": "", "speaker_jp": "テスト", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_02", "jp": "ただ今 2回目の攻略中\nどうします?", "zh": "", "speaker_jp": "テスト", "dup": "dup:c3f64e5b16ad"}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_03", "jp": "では 2回目「ソリッドの陽動」\n開始します", "zh": "", "speaker_jp": "テスト", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_04", "jp": "ただ今 2回目の攻略中\nどうします?", "zh": "", "speaker_jp": "テスト", "dup": "dup:c3f64e5b16ad"}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_05", "jp": "では 1回目「メリーベルと共闘」\n開始します", "zh": "", "speaker_jp": "テスト", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_06", "jp": "この操作の信頼性はいまいちです\nあしからず", "zh": "", "speaker_jp": "テスト", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#TEST_DEBUG_07", "jp": "どのエリアに飛びます?", "zh": "", "speaker_jp": "テスト", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#DEBUG_SEL_01", "jp": "エリアに飛ぶ2回目の状態に切り替えるやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#DEBUG_SEL_02", "jp": "エリアに飛ぶ1回目の状態に切り替えるやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_01", "jp": "エリア02エリア03エリア04エリア05次へやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_02", "jp": "前へエリア06エリア08エリア09エリア10次へやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_03", "jp": "前へエリア11エリア12エリア13エリア14エリア15次へやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_04", "jp": "前へエリア16エリア17エリア18エリア19エリア20次へやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_05", "jp": "前へエリア21エリア22エリア23エリア24エリア25次へやめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#AREA_SEL_06", "jp": "前へエリア26エリア27やめる", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#EXITWARP", "jp": ">他のエリアに行きますか?", "zh": "", "dup": "dup:b942aa213957"}, {"id": "bf:fld/f/f023/f023.bf#EXITWARP_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#HOSEKI", "jp": ">異様な物体が浮いている。\n触れてみますか?", "zh": "", "dup": "dup:47750438ab12"}, {"id": "bf:fld/f/f023/f023.bf#HOSEKI_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#HOSEKI_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f023/f023.bf#HOSEKI_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA", "jp": ">奇妙な物体が鎮座している。\n触れてみますか?", "zh": "", "dup": "dup:1f10fc7723c4"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_NOGET", "jp": ">接触をあきらめた。", "zh": "", "dup": "dup:c2a6f84664a4"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_STILLGET", "jp": ">何もおきない。", "zh": "", "dup": "dup:20afcfdb38cc"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_GET", "jp": ">を個手に入れた。", "zh": "", "dup": "dup:1ddbe3462bd5"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_GET2", "jp": ">を個手に入れた。\n>教会が探していると、噂の物質のようだ。\n<1727>と交換してくれるだろう。", "zh": "", "dup": "dup:2fe5618b8bd8"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_MAKA_GET", "jp": ">マッカ手に入れた。", "zh": "", "dup": "dup:ae4d99c30b1f"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_DAMAGE", "jp": ">サーフたちはダメージを受けた。", "zh": "", "dup": "dup:ab51c65780a1"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_DAMAGE_POISON", "jp": ">サーフたちはダメージを受け、\nさらに毒におかされた。", "zh": "", "dup": "dup:3b4648950d12"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_DAMAGE_ACHE", "jp": ">サーフたちはダメージを受け、\nさらにおなかを壊した。", "zh": "", "dup": "dup:36fec643ec65"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_DAMAGE_CLOSE", "jp": ">サーフたちはダメージを受け、\nさらに魔法を封じられた。", "zh": "", "dup": "dup:aaf374953e94"}, {"id": "bf:fld/f/f023/f023.bf#TAKARA_KARAGET", "jp": ">中身は空っぽだった。", "zh": "", "dup": "dup:2768675fb669"}, {"id": "bf:fld/f/f023/f023.bf#TAKARASAGASI", "jp": ">は、何かを見つけた。\n………\n>を個手に入れた。", "zh": "", "dup": "dup:93f0d3cff44a"}, {"id": "bf:fld/f/f023/f023.bf#COMP_OPENERROR", "jp": ">ここでは使えない。", "zh": "", "dup": "dup:5cecb7fdcab2"}, {"id": "bf:fld/f/f023/f023.bf#BAD_KAIFUKUSITAYO", "jp": ">ソーラーノイズの低下により、\nサーフ達の体から\nバッドステータスが消え去った。", "zh": "", "dup": "dup:f6a42097c9de"}, {"id": "bf:fld/f/f023/f023.bf#COMP_LIGHTMAEND", "jp": ">光の効果が切れた。", "zh": "", "dup": "dup:0ee7273eea20"}, {"id": "bf:fld/f/f023/f023.bf#COMP_ESTOMAEND", "jp": ">封魔の効果が切れた。", "zh": "", "dup": "dup:e54ea8d4589a"}, {"id": "bf:fld/f/f023/f023.bf#COMP_REBERAMAEND", "jp": ">集魔の効果が切れた。", "zh": "", "dup": "dup:f655249b0a19"}, {"id": "bf:fld/f/f023/f023.bf#COMP_REFUTOMAEND", "jp": ">浮き足の効果が切れた。", "zh": "", "dup": "dup:2a4bfae5b8c8"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_MSG", "jp": ">階数を選んで下さい。", "zh": "", "dup": "dup:7391190be71e"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL1", "jp": " やめる", "zh": "", "dup": "dup:2b81edf23a17"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL2", "jp": "  やめる", "zh": "", "dup": "dup:8c8c7c8c9d87"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL3", "jp": "   やめる", "zh": "", "dup": "dup:89e9c9945efb"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL4", "jp": "    やめる", "zh": "", "dup": "dup:e285e3624a25"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL5", "jp": "     やめる", "zh": "", "dup": "dup:56f2ebfc886d"}, {"id": "bf:fld/f/f023/f023.bf#WARP_ELV_SEL6", "jp": "      やめる", "zh": "", "dup": "dup:86e58e6ec4a6"}, {"id": "bf:fld/f/f023/f023.bf#FLD_BLUEICE_KEYHAVE", "jp": ">不思議な青色の壁がある。\nブルーアイスキーで壊せそうだ。", "zh": "", "dup": "dup:27a6f3f357f0"}, {"id": "bf:fld/f/f023/f023.bf#FLD_REDICE_KEYHAVE", "jp": ">不思議な赤色の壁がある。\nレッドアイスキーで壊せそうだ。", "zh": "", "dup": "dup:8d51b7e90f21"}, {"id": "bf:fld/f/f023/f023.bf#FLD_YERWICE_KEYHAVE", "jp": ">不思議な黄色の壁がある。\nイエローアイスキーで壊せそうだ。", "zh": "", "dup": "dup:0e94f5ce89e0"}, {"id": "bf:fld/f/f023/f023.bf#FLD_BLUEICE", "jp": ">不思議な青色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3eaffd7a49dc"}, {"id": "bf:fld/f/f023/f023.bf#FLD_REDICE", "jp": ">不思議な赤色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:5a93719ec4b7"}, {"id": "bf:fld/f/f023/f023.bf#FLD_YERWICE", "jp": ">不思議な黄色の壁がある。\n…今はまだ通れそうにない。", "zh": "", "dup": "dup:3fc075012710"}, {"id": "bf:fld/f/f023/f023.bf#FLD_ICE_BREAK", "jp": ">破壊しますか?", "zh": "", "dup": "dup:b08093e13342"}, {"id": "bf:fld/f/f023/f023.bf#FLD_ICE_BREAK_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_KEHAI_DOOR", "jp": ">扉の向こうに何者かの気配を感じる…。\n>扉を開けて外に出ますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_KEHAI_GATE", "jp": ">ゲートの向こうに何者かの気配を感じる…。\n>ゲートを開けて先に進みますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#SOMEBODY_KEHAI_DOWN", "jp": ">下に何者かの気配を感じる…。\n>ハシゴを下りますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#ENTER_NO10_DOOR", "jp": ">ゲートの向こうから物音が聞こえる…。\n>ゲートを開けて先に進みますか?", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#DOOR_SEL", "jp": "はいいいえ", "zh": "", "dup": "dup:794ae24722fa"}, {"id": "bf:fld/f/f023/f023.bf#LOCK", "jp": ">ゲートはロックされていて開かない…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_01", "jp": ">01と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_02", "jp": ">02と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_03", "jp": ">03と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_04", "jp": ">04と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_05", "jp": ">05と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_06", "jp": ">06と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#LOCK_07", "jp": ">07と書かれたゲートがある。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#JUU_DOOR", "jp": ">扉は固く閉ざされている…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#ENT_DOOR", "jp": ">扉が開かない…。\n>向こう側から何者かが\n押さえつけているようだ…。", "zh": "", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#HINT_1", "jp": "ジナーナは 4番ゲートの奥に向かった\nみんな腹をすかしている\n他の連中に襲われないよう気を付けろ", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}, {"id": "bf:fld/f/f023/f023.bf#HINT_2", "jp": "ひぃ お助け…\nこ このゲートをくぐると\n街の入口に戻ります\nジナーナの姉御はこの先\n4番のゲートの向こう…です", "zh": "", "speaker_jp": "メリーベル構成員 男", "dup": null}]