[{"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NARU0920", "jp": "残念だったわね\nセラならいないわ", "zh": "真遗憾呢，塞拉不在哦", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NARU0930", "jp": "ここなら そう高くも飛べない\nもう逃がさないわ", "zh": "在这里可飞不了那么高，不会再让你逃掉了", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NARU0940", "jp": "なぜジナーナを裏切った!?", "zh": "为什么要背叛吉娜娜！？", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NBAT0240", "jp": "あの単細胞に聞け\nあいつならわかるだろうよ", "zh": "去问那个单细胞吧，那家伙应该明白", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NBAT0251a", "jp": "だが そいつも無理だ", "zh": "但是，那家伙也不行", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NBAT0251b", "jp": "お前は俺に喰われる", "zh": "你会被我吃掉", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NBAT0252", "jp": "ジナーナは美味かったぜ", "zh": "吉娜娜的味道不错啊", "dup": null}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NARU0950a", "jp": "お前…", "zh": "你…", "dup": "dup:fa7534759193"}, {"id": "pm1:event/e640/e640/e640_001/E640_001.PM1@0x130#NARU0950b", "jp": "お前ぇ!", "zh": "你这家伙！", "dup": null}]