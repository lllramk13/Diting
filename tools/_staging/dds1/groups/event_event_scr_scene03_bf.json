[{"id": "bf:event/scr/scene03.bf#TAKE_01", "jp": "神器は見つかりましたかな!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_01", "jp": "焦んなくていいぜ…", "zh": "", "speaker_jp": "スサノオ", "dup": null}, {"id": "bf:event/scr/scene03.bf#TAKE_02", "jp": "悪魔なり、机なり、ゴミ箱なり…\n聞けるものには何でも聞く!\nこれ、物事の基本ですぞ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_02", "jp": "見たとこアンタも日本人だろ?\n姉貴のために一肌脱ぐなんて\nすっげー名誉なことだぜ…", "zh": "", "speaker_jp": "スサノオ", "dup": null}, {"id": "bf:event/scr/scene03.bf#TAKE_03", "jp": "そうです、そうです!\n大変名誉なことですぞ!", "zh": "", "speaker_jp": "タケミカヅチ", "dup": null}, {"id": "bf:event/scr/scene03.bf#SUSA_03", "jp": "…というわけだ。がんばってくれ。", "zh": "", "speaker_jp": "スサノオ", "dup": null}]