[{"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NARU1151", "jp": "バロン!", "zh": "巴隆！", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NARU1152", "jp": "あたしが喰われたって\nどういう意味なの!?", "zh": "你说我被吃了，到底是什么意思！？", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0261", "jp": "私を…\nそんな名で呼ぶな", "zh": "别……用那个名字叫我。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0262", "jp": "私は大佐だ\nベック大佐だ", "zh": "我是大佐，贝克大佐。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NGIL0901", "jp": "お前は知っているんだな", "zh": "你是知道的吧。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NGIL0902", "jp": "俺以外…", "zh": "除了我之外……", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NGIL0903", "jp": "サーフたちが\n一体何者かということを", "zh": "瑟夫他们到底是什么人。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0271", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0272", "jp": "馬鹿者が", "zh": "蠢货！", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0273a", "jp": "お前も", "zh": "你也是。", "dup": "dup:1bbb79f118d4"}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0273b", "jp": "お前も", "zh": "你也是。", "dup": "dup:1bbb79f118d4"}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0273c", "jp": "お前も", "zh": "你也是。", "dup": "dup:1bbb79f118d4"}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0274", "jp": "あの女に こんな地獄へ\n堕されたのを忘れたか", "zh": "你忘了是被那个女人打入这种地狱的吗？", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0281", "jp": "知りたければ教えてやる", "zh": "想知道的话我就告诉你。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0282", "jp": "私も… お前たちも…\n一度 死んだ人間なのだよ", "zh": "我……还有你们……都是已经死过一次的人。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0283", "jp": "お前たちが恋焦がれる\nニルヴァーナでな", "zh": "在你们魂牵梦萦的涅槃之中。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NARU1160", "jp": "そんな…\nバカな", "zh": "这……怎么可能。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0291a", "jp": "あの女だ", "zh": "是那个女人。", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0291b", "jp": "あの女こそ\n世界を減ぼす…", "zh": "正是那个女人，要毁灭世界……", "dup": null}, {"id": "pm1:event/e650/e653/e653_001/E653_001.PM1@0x390#NBRN0292", "jp": "悪魔…", "zh": "恶魔…", "dup": null}]