[{"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NHET0391", "jp": "なんで女ひとり守れねぇんだ!", "zh": "为什么连一个女人都", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NHET0392", "jp": "あぁ!?", "zh": "啊！？", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0130", "jp": "済ま…ない", "zh": "对不……起。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0400", "jp": "なぜ セラに執着する", "zh": "为什么对塞拉如此执着？", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0410", "jp": "自分でもわからないのだろう", "zh": "你自己也不明白吧。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NHET0400", "jp": "殺されてぇのか", "zh": "想被杀吗？", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NARU0730", "jp": "もうやめて!", "zh": "住手！", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0421", "jp": "お前だけじゃない\nセラが現れてから皆変わった", "zh": "不只是你，自从塞拉出现后大家都变了。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0422", "jp": "混乱するのはわかるが\nシエロを弱らせるな", "zh": "我知道你很混乱，但别让西埃罗变弱。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NHET0410", "jp": "大層な口きくじゃねぇか\nてめぇはどうなんだ", "zh": "口气倒是不小啊\n那你呢", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0431", "jp": "俺は変わらない…", "zh": "我始终如一…", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0432", "jp": "俺は俺だ", "zh": "我就是我", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0441", "jp": "全てを解く鍵は セラの記憶にある", "zh": "解开一切的关键在于塞拉的记忆", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0442", "jp": "荒れる前に取り戻す手段を考えろ", "zh": "在事态恶化之前，想想夺回的方法", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0451", "jp": "セラはどこだ", "zh": "塞拉在哪里？", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0452", "jp": "お前が生かされているということは\n俺たちにそれを伝えさせるためだ", "zh": "你之所以被留活口，是为了让你把这件事告诉我们", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0140", "jp": "北の廃墟の\nポイント136だ", "zh": "北边废墟的136号点", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NARU0740", "jp": "ヒート", "zh": "希特", "dup": "dup:9cc24389ebb7"}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NGIL0460", "jp": "奴一人では危険だ\n追うぞ", "zh": "一个人太危险了，我追上去", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0151", "jp": "俺も…", "zh": "我也……", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0152", "jp": "オレも連れて行ってくれよ!", "zh": "也带我去吧！", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0153", "jp": "このままじゃカッコつかねぇよ", "zh": "这样下去我可没面子。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NARU0750", "jp": "アンタは休んでなさい\nそんな身体じゃ 何もできないわ", "zh": "那是个老头子，什么忙都帮不上。\n真是个废物。", "dup": null}, {"id": "pm1:event/e630/e630/e630_001/E630_001.PM1@0x390#NSIE0160", "jp": " ", "zh": "", "dup": "dup:b858cb282617"}]