[{"id": "script:10959", "jp": "<c2e/>イゴール<c2e/>\\n<c31/>ようこそ、ベルベットルームへ。\\n<WAIT><PAGE>", "zh": "<c2e/>伊格尔<c2e/>\\n<c31/>欢迎来到天鹅绒房间。\\n<WAIT><PAGE>", "meta": "イゴール", "srcs": ["script:397_16:0x1ccc"]}, {"id": "script:10960", "jp": "<c2e/>イゴール<c2e/>\\n<c31/>他に御用はありますかな?\\n<WAIT><PAGE>", "zh": "<c2e/>伊格尔<c2e/>\\n<c31/>还有别的事吗？\\n<WAIT><PAGE>", "meta": "イゴール", "srcs": ["script:397_16:0x1d06"]}, {"id": "script:10961", "jp": "<c2e/>イゴール<c2e/>\\n会話データ\\n<WAIT><PAGE>", "zh": "<c2e/>伊格尔<c2e/>\\n对话数据\\n<WAIT><PAGE>", "meta": "イゴール", "srcs": ["script:397_16:0x1d3a"]}, {"id": "script:10962", "jp": "<c2e/>イゴール<c2e/>\\n別れメッセージ<WAIT><PAGE>", "zh": "<c2e/>伊格尔<c2e/>\\n告别讯息<WAIT><PAGE>", "meta": "イゴール", "srcs": ["script:397_16:0x1d5e"]}, {"id": "script:10963", "jp": "<c2e/>悪魔絵師<c2e/>\\n<c31/>タロットは心の雛形だ。心ガ人の運命を回す。\\n<c31/>さて、何か描いて欲しいのかな?<WAIT><PAGE>", "zh": "<c2e/>恶魔画师<c2e/>\\n<c31/>塔罗是心灵的雏形。心将推动人的命运之轮。\\n<c31/>那么，你是想让我画点什么吗？<WAIT><PAGE>", "meta": "悪魔絵師", "srcs": ["script:397_16:0x1d84"]}, {"id": "script:10964", "jp": "<c2e/>悪魔絵師<c2e/>\\n会話データ\\n<WAIT><PAGE>", "zh": "<c2e/>恶魔画师<c2e/>\\n会话数据\\n<WAIT><PAGE>", "meta": "悪魔絵師", "srcs": ["script:397_16:0x1dea"]}, {"id": "script:10965", "jp": "<c2e/>悪魔絵師<c2e/>\\n別れメッセージ<WAIT><PAGE>", "zh": "<c2e/>恶魔画师<c2e/>\\n告别消息<WAIT><PAGE>", "meta": "悪魔絵師", "srcs": ["script:397_16:0x1e0e"]}, {"id": "script:10966", "jp": "<c31/>どの説明を読みますか?\\n<c8/>召喚\\n入れ替え・帰還\\n<c28/>変異\\nやめる\\n<c9/><PAGE>", "zh": "<c31/>要看哪项说明？\\n<c8/>召唤\\n替换・归还\\n<c28/>变异\\n结束\\n<c9/><PAGE>", "srcs": ["script:397_16:0x1e34"]}, {"id": "script:10967", "jp": "作成中です\\n<WAIT><PAGE>", "zh": "制作中\\n<WAIT><PAGE>", "srcs": ["script:397_16:0x1e96", "script:397_16:0x1ea8", "script:397_16:0x1efc", "script:397_16:0x1f0e", "script:397_16:0x1f20"]}, {"id": "script:10968", "jp": "<c31/>どの説明を読みますか?\\n<c8/>依頼\\nフリータロット\\nやめる\\n<c9/><PAGE>", "zh": "<c31/>要看哪项说明？\\n<c8/>委托\\n自由塔罗牌\\n结束\\n<c9/><PAGE>", "srcs": ["script:397_16:0x1eba"]}, {"id": "manual:recover_script_11498_1e84", "jp": "作成中です\\n<WAIT><PAGE>", "zh": "制作中\\n<WAIT><PAGE>", "srcs": ["script:397_16:0x1e84"]}, {"id": "manual:recover_script_11500_1f32", "jp": "BITのON、OFFを行います。\\n<c8/>噂全聞き\\n噂、少し聞き\\n尋ね人表示\\nお金沢山\\nやめる\\n<c9/><PAGE>", "zh": "进行BIT的ON／OFF设置。\\n<c8/>传闻全听\\n传闻，稍微听听\\n寻人显示\\n很多钱\\n结束\\n<c9/><PAGE>", "srcs": ["script:397_16:0x1f32"]}, {"id": "manual:recover_script_11501_1f94", "jp": "会話データ\\n<WAIT><PAGE>", "zh": "会话数据\\n<WAIT><PAGE>", "srcs": ["script:397_16:0x1f94"]}]