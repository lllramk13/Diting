[{"id": "script:13594", "jp": "<c2e/><c31/>触れてみますか?<c2e/>\\n<c8/>はい\\nいいえ\\n<c9/><PAGE>", "zh": "<c2e/><c31/>要试着碰一下吗？<c2e/>\\n<c8/>是\\n否\\n<c9/><PAGE>", "meta": "<c31/>触れてみますか?", "srcs": ["script:735_8:0x278", "script:735_156:0x26c", "script:735_157:0x26c", "script:735_158:0x26c", "script:735_159:0x26c", "script:735_160:0x26c", "script:735_161:0x26c"]}, {"id": "script:13595", "jp": "<c2e/><c31/>どこかで何かガ変化した。<c2e/>\\n<WAIT><PAGE>", "zh": "<c2e/><c31/>某个地方发生了变化。<c2e/>\\n<WAIT><PAGE>", "meta": "<c31/>どこかで何かガ変化した。", "srcs": ["script:735_8:0x2ac"]}, {"id": "script:13596", "jp": "<c2e/><c31/>何も起こらなかった。<c2e/>\\n<WAIT><PAGE>", "zh": "<c2e/><c31/>什么都没发生。<c2e/>\\n<WAIT><PAGE>", "meta": "<c31/>何も起こらなかった。", "srcs": ["script:735_8:0x2d6", "script:735_156:0x2d4", "script:735_157:0x2d4", "script:735_158:0x2d4", "script:735_159:0x2d4", "script:735_160:0x2d4", "script:735_161:0x2d4"]}]