[{"id": "script:5421", "jp": "<c31/>怪我をしたのか!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你受伤了吗!?\\n<c7/><WAIT><PAGE>", "srcs": ["script:187_24:0x22a0"]}, {"id": "script:5422", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>なぜ来たんだ…!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>你为什么要来……!!\\n<c7/><WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["script:187_24:0x22be"]}, {"id": "script:5423", "jp": "<c31/>なぜ来たんだ…!!\\n<c8/><NAME/>…クン…\\nなぜって…\\n<c9/><PAGE>", "zh": "<c31/>你为什么要来……!!\\n<c8/><NAME/>……阿、阿……\\n为什么……\\n<c9/><PAGE>", "srcs": ["script:187_24:0x22e8"]}, {"id": "script:5424", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>身体の痛みなら耐えられる!!\\n<c31/>だけど…!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>身体上的痛我还能忍!!\\n<c31/>可是……!\\n<c7/><WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["script:187_24:0x2320"]}, {"id": "script:5425", "jp": "<c2e/><NAME/><c2e/>\\n<c31/>クッ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n<c31/>唔…\\n<c7/><WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["script:187_24:0x2362", "script:239_43:0x42c0", "script:253_39:0x2430"]}, {"id": "script:5426", "jp": "<c2e/>克哉<c2e/>\\n<c31/>済まない、天野君…\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>对不起，天野……\\n", "meta": "克哉", "srcs": ["script:187_24:0x23a2"]}, {"id": "script:5427", "jp": "<c31/>本当はあんな奴じゃないんだ…\\n", "zh": "<c31/>他其实不是那样的人……\\n", "srcs": ["script:187_24:0x23c8"]}, {"id": "script:5428", "jp": "<c31/>許してやってくれ…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>请原谅他吧……\\n<c7/><WAIT><PAGE>", "srcs": ["script:187_24:0x23ea"]}, {"id": "script:5429", "jp": "<c2e/>うらら<c2e/>\\n<c31/><NAME/>君のあんな怒った顔、初めてだわね…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/><NAME/>你那种气成那样的表情，我还是头一次见呢……\\n<c7/><WAIT><PAGE>", "meta": "うらら", "srcs": ["script:187_24:0x2408"]}, {"id": "script:5430", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>ガキガ、無理しやガって…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n<c31/>小鬼还硬撑什么……\\n<c7/><WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["script:187_24:0x2448"]}, {"id": "script:5431", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>竜蔵は逃ガしたガ、遺跡に向かってるヤツらを\\n<c31/>放っとくわけにもいかねぇな…\\n", "zh": "<c2e/>报复<c2e/>\\n<c31/>虽然让龙藏那家伙跑了，但朝遗迹去的那些人\\n<c31/>也不能放着不管啊……\\n", "meta": "パオフゥ", "srcs": ["script:187_24:0x247e"]}, {"id": "script:5432", "jp": "<c31/>天野、追いかける手段を探すぞ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>天野，去找追上他们的办法吧。\\n<c7/><WAIT><PAGE>", "srcs": ["script:187_24:0x24e0"]}, {"id": "script:5433", "jp": "<c2e/>エリー<c2e/>\\n<c31/>彼…辛そうですわね…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>他……看起来很痛苦呢……\\n<c7/><WAIT><PAGE>", "meta": "エリー", "srcs": ["script:187_24:0x250a"]}, {"id": "script:5434", "jp": "<c2e/>エリー<c2e/>\\n<c31/>きっと、彼の心を救ってあげられるのは、\\n<c31/>Ms、Amano…あなただけですわ…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>一定能拯救他内心的人，\\n<c31/>Ms、Amano……就只有您了……\\n<c7/><WAIT><PAGE>", "meta": "エリー", "srcs": ["script:187_24:0x253a"]}, {"id": "script:5435", "jp": "<c2e/>南条<c2e/>\\n<c31/>痛々しいな…見ていて辛い…\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>南条<c2e/>\\n<c31/>太惨了……光看着都难受……\\n<c7/><WAIT><PAGE>", "meta": "南条", "srcs": ["script:187_24:0x25a4"]}, {"id": "legacy:script:5498", "jp": "<c2e/>克哉<c2e/>\\n<c31/><NAME/>…!!\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/><NAME/>……!!\\n", "srcs": ["script:187_24:0x2286"]}, {"id": "legacy:script:5504", "jp": "<c2e/>克哉<c2e/>\\n<c31/><NAME/>…!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/><NAME/>……!!\\n<c7/><WAIT><PAGE>", "srcs": ["script:187_24:0x2382"]}]