[{"id": "script:4919", "jp": "<c2e/>エリー<c2e/>\\n<c31/>皆さん、申し訳ありませんでした…\\n", "zh": "<c2e/>艾莉<c2e/>\\n<c31/>各位，真是对不起……\\n", "meta": "エリー", "srcs": ["script:158_59:0x13d8"]}, {"id": "script:4920", "jp": "<c31/>私の弱さのせいで…\\n<c31/>ご迷惑おかけしてしまって…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>都怪我太软弱了……\\n<c31/>给大家添了这么多麻烦……\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x140e"]}, {"id": "script:4921", "jp": "<c2e/>うらら<c2e/>\\n<c31/>なぁにそんなこと気にしてんのよう。\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>哎呀，你干吗这么放在心上嘛。\\n", "meta": "うらら", "srcs": ["script:158_59:0x144a"]}, {"id": "script:4922", "jp": "<c31/>気持ち、なんとなくわかるしさ…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>这种心情，我多少也能懂啦……\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x1482"]}, {"id": "script:4923", "jp": "<c2e/>うらら<c2e/>\\n<c31/>レッツ・ポジティブシンキングよ!\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>Let's Positive Thinking哟！\\n", "meta": "うらら", "srcs": ["script:158_59:0x14ac"]}, {"id": "script:4924", "jp": "<c31/>ね、マーヤ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>对吧，玛雅。\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x14e2"]}, {"id": "script:4925", "jp": "<c2e/>パオフゥ<c2e/>\\n<c31/>どこぞの誰かみてぇに、\\n<c31/>てめぇガJOKERになっちまうよりは、\\n", "zh": "<c2e/>报复<c2e/>\\n<c31/>比起像不知道哪个家伙那样，\\n<c31/>让你自己变成JOKER，\\n", "meta": "パオフゥ", "srcs": ["script:158_59:0x14fa"]}, {"id": "script:4926", "jp": "<c31/>可愛いもんってこった…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>这还算可爱的了……\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x1552"]}, {"id": "script:4927", "jp": "<c2e/>うらら<c2e/>\\n<c31/>グッ…\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>唔……\\n", "meta": "うらら", "srcs": ["script:158_59:0x1574"]}, {"id": "script:4928", "jp": "<c31/>悪かったって言ってんじゃないよう…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我不是都说我错了吗……\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x1590"]}, {"id": "script:4929", "jp": "<c2e/>克哉<c2e/>\\n<c31/>まぁ、これで、敵の術は破れたわけか…\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>嗯，这下敌人的法术算是破了吧……\\n", "meta": "克哉", "srcs": ["script:158_59:0x15be"]}, {"id": "script:4930", "jp": "<c31/>早く表に戻ろう。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>快回到外面去吧。\\n<c7/><WAIT><PAGE>", "srcs": ["script:158_59:0x15f6"]}]