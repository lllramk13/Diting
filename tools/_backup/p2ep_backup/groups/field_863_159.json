[{"id": "field:15291", "jp": "<c2e/><NAME/><c2e/>\\n 俺一人で充分だ…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我一个人就够了……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_159:dec:0x5dc", "field:863_161:dec:0xac0", "field:863_168:dec:0x5dc", "field:863_169:dec:0x5dc", "field:863_397:dec:0x6a8"]}, {"id": "field:15292", "jp": "<c2e/>うらら<c2e/>\\n あんまり無茶しちゃダメだからね。\\n<WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n可别太乱来了哦。\\n<WAIT><PAGE>", "meta": "うらら", "srcs": ["field:863_159:dec:0x602"]}, {"id": "field:15293", "jp": "<c2e/><NAME/><c2e/>\\n 俺は、ずっとここにいる…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我会一直待在这里……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_159:dec:0x63c", "field:863_165:dec:0x75a"]}, {"id": "field:15294", "jp": "<c2e/><NAME/><c2e/>\\n もう、たくさんだ…\\n こんな思い…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n已经……够了……\\n这种感受……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_159:dec:0x66a", "field:863_165:dec:0x788"]}, {"id": "field:15295", "jp": "<c2e/><NAME/><c2e/>\\n あんたの事は忘れない…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我不会忘记你的……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_159:dec:0x6a2", "field:863_165:dec:0x7c0"]}]