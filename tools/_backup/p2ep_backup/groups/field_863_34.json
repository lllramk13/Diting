[{"id": "field:14919", "jp": "<c2e/>南条<c2e/>\\n 日本経済の基盤は人材だ。\\n 不況の原因は、人材育成を怠った事にある!\\n 早急に頭を切り替える事ガ必要なのだ!\\n<WAIT><PAGE>", "zh": "", "meta": "南条", "srcs": ["field:863_34:dec:0x268", "field:863_131:dec:0x4ea", "field:863_134:dec:0xa28", "field:863_135:dec:0x4e8", "field:863_137:dec:0x4e8", "field:863_332:dec:0x2e8", "field:863_333:dec:0x2e8", "field:863_334:dec:0x2e8", "field:863_336:dec:0x2e8", "field:863_337:dec:0x2e8", "field:863_338:dec:0x2e8", "field:863_339:dec:0x2e8", "field:863_340:dec:0x2e8"]}, {"id": "field:14920", "jp": "<c2e/>南条<c2e/>\\n 武力を持たぬと言う以上、\\n 諸外国との対等関係の構築には、\\n 経済力と威風堂々たる外交姿勢ガ必要だ!\\n<WAIT><PAGE>", "zh": "<c2e/>南条<c2e/>\\n 既然说了不持有武力，\\n 那么要与各国建立对等关系，\\n 就必须具备经济实力与堂堂正正的外交姿态!\\n<WAIT><PAGE>", "meta": "南条", "srcs": ["field:863_34:dec:0x2ec", "field:863_131:dec:0x56e", "field:863_134:dec:0xaac", "field:863_135:dec:0x56c", "field:863_137:dec:0x56c", "field:863_332:dec:0x36c", "field:863_333:dec:0x36c", "field:863_334:dec:0x36c", "field:863_336:dec:0x36c", "field:863_337:dec:0x36c", "field:863_338:dec:0x36c", "field:863_339:dec:0x36c", "field:863_340:dec:0x36c"]}, {"id": "field:14921", "jp": "<c2e/>南条<c2e/>\\n 日本の教育制度は破綻の兆しを見せつつある。\\n 保守的な制度では、時代の変化についていけない!\\n <cb/><c7/>抜本的な改革ガ必要だ!<c7/>\\n<WAIT><PAGE>", "zh": "<c2e/>南条<c2e/>\\n 日本的教育制度已经开始显露出崩坏的征兆。\\n 这种保守的制度，根本跟不上时代的变化！\\n <cb/><c7/>必须进行根本性的改革！<c7/>\\n<WAIT><PAGE>", "meta": "南条", "srcs": ["field:863_34:dec:0x36e", "field:863_131:dec:0x5f0", "field:863_134:dec:0xb2e", "field:863_135:dec:0x5ee", "field:863_137:dec:0x5ee", "field:863_332:dec:0x3ee", "field:863_333:dec:0x3ee", "field:863_334:dec:0x3ee", "field:863_336:dec:0x3ee", "field:863_337:dec:0x3ee", "field:863_338:dec:0x3ee", "field:863_339:dec:0x3ee", "field:863_340:dec:0x3ee"]}]