[{"id": "field:15595", "jp": "<c2e/><NAME/><c2e/>\\n 二人とも下ガっていてくれ…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你们两个都退下吧……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_388:dec:0x3cc", "field:863_389:dec:0x3cc", "field:863_390:dec:0x92c", "field:863_395:dec:0x3cc", "field:863_396:dec:0x3cc", "field:863_398:dec:0x3cc", "field:863_399:dec:0x3cc", "field:863_400:dec:0x3cc", "field:863_401:dec:0x3cc", "field:863_402:dec:0x3cc"]}, {"id": "field:15596", "jp": "<c2e/>南条<c2e/>\\n 承知した、<SURNAME/>。\\n しかし、あまりMs、天野を心配させるな。\\n<WAIT><PAGE>", "zh": "<c2e/>南条<c2e/>\\n知道了，<SURNAME/>。\\n不过，别让Ms、天野太过担心。\\n<WAIT><PAGE>", "meta": "南条", "srcs": ["field:863_388:dec:0x3fc"]}]