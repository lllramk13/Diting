[{"id": "field:14913", "jp": "<c2e/>パオフゥ<c2e/>\\n いいから聞きなよ。\\n あんまり調子乗ってっと、コイツばら撒くぜ…?\\n<WAIT><PAGE>", "zh": "", "meta": "パオフゥ", "srcs": ["field:863_27:dec:0x274", "field:863_114:dec:0x6ba", "field:863_116:dec:0xdee", "field:863_119:dec:0x8fe", "field:863_121:dec:0xe90", "field:863_124:dec:0x50a", "field:863_293:dec:0xa88", "field:863_296:dec:0x306", "field:863_297:dec:0x2f6", "field:863_298:dec:0x2f4", "field:863_301:dec:0x118e", "field:863_316:dec:0xcdc", "field:863_318:dec:0x34c", "field:863_321:dec:0x342", "field:863_322:dec:0x342", "field:863_323:dec:0x340"]}, {"id": "field:14914", "jp": "<c2e/>パオフゥ<c2e/>\\n どうだ、このテープ?\\n 良く録れてるだろうガ?\\n 都合…悪いんじゃねぇのかい?\\n<WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n 怎么样，这盘磁带？\\n 录得很清楚吧？\\n 你那边……是不是不太好办了啊？\\n<WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["field:863_27:dec:0x2d2", "field:863_116:dec:0xe4c", "field:863_119:dec:0x95c", "field:863_121:dec:0xeee", "field:863_124:dec:0x568", "field:863_293:dec:0xae6", "field:863_297:dec:0x354", "field:863_298:dec:0x352", "field:863_301:dec:0x11ec", "field:863_316:dec:0xd3a", "field:863_318:dec:0x3aa", "field:863_321:dec:0x3a0", "field:863_322:dec:0x3a0", "field:863_323:dec:0x39e"]}, {"id": "field:14915", "jp": "<c2e/>パオフゥ<c2e/>\\n おっと、ちょいと待ちな…\\n コイツをよ〜く聞いてみなよ…\\n<WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n 哎，先稍微等等……\\n 你好好听听这家伙怎么说……\\n<WAIT><PAGE>", "meta": "パオフゥ", "srcs": ["field:863_27:dec:0x33c", "field:863_114:dec:0x7c6", "field:863_116:dec:0xeb6", "field:863_119:dec:0xa00", "field:863_121:dec:0xf58", "field:863_124:dec:0x5d2", "field:863_293:dec:0xb50", "field:863_296:dec:0x40e", "field:863_297:dec:0x3be", "field:863_298:dec:0x3bc", "field:863_301:dec:0x1256", "field:863_316:dec:0xda4", "field:863_318:dec:0x414", "field:863_321:dec:0x40a", "field:863_322:dec:0x40a", "field:863_323:dec:0x408"]}, {"id": "field:14916", "jp": "<c2e/>パオフゥ<c2e/>\\n 全く…あんたも隅に置けないねぇ…\\n おっと、勘違いすんなよ!\\n こいつぁ取引だぜ…\\n<WAIT><PAGE>", "zh": "<c2e/>报复<c2e/>\\n 真是的……你也挺有一套啊……\\n 喂，可别误会了!\\n 这可是笔交易……\\n<WAIT><PAGE>", "meta": "パオフゥ