[{"id": "script:3656", "jp": "<c2e/>うらら<c2e/>\\n<c31/>あ、あそこあそこ!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>啊、在那边在那边！\\n<c7/><WAIT><PAGE>", "meta": "うらら", "srcs": ["script:69_24:0x174c"]}, {"id": "script:3657", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>レイディ、お前は俺の仲間だ。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>小姐，你是我的同伴。\\n", "meta": "JOKER", "srcs": ["script:69_24:0x177a"]}, {"id": "script:3658", "jp": "<c31/>迎えに来たんだよ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我是来接你的。\\n<c7/><WAIT><PAGE>", "srcs": ["script:69_24:0x17b0"]}, {"id": "script:3659", "jp": "<c2e/>杏奈<c2e/>\\n<c31/>あんたなんか知らない…\\n", "zh": "<c2e/>杏奈<c2e/>\\n<c31/>我根本不认识你……\\n", "meta": "杏奈", "srcs": ["script:69_24:0x17ce"]}, {"id": "script:3660", "jp": "<c31/>私は、JOKER呪いなんかしてない…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我、我根本没下什么JOKER诅咒……\\n<c7/><WAIT><PAGE>", "srcs": ["script:69_24:0x17f8"]}, {"id": "script:3661", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>心配するこたねぇ。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>别担心。\\n", "meta": "JOKER", "srcs": ["script:69_24:0x1828"]}, {"id": "script:3662", "jp": "<c31/>悪いようにはしねぇ、一緒に来い。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>不会把你怎么样的，跟我来吧。\\n<c7/><WAIT><PAGE>", "srcs": ["script:69_24:0x18dc"]}, {"id": "script:3663", "jp": "<c2e/>克哉<c2e/>\\n<c31/>501号、その子から離れろ!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>501号，离那孩子远点！\\n<c7/><WAIT><PAGE>", "meta": "克哉", "srcs": ["script:69_24:0x1908"]}, {"id": "script:3664", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>邪魔すんじゃねぇ!!\\n<c31/>てめぇらはそいつらの相手でもしてろお!!\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>少来碍事!!\\n<c31/>你们几个就去陪那些家伙玩玩吧!!\\n<c7/><WAIT><PAGE>", "meta": "JOKER", "srcs": ["script:69_24:0x193e"]}, {"id": "manual:recover_script_3653_1860", "jp": "<c31/>俺の事も「向こう側」の事も、すぐにわかる。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>我的事也好，“那一边”的事也好，你很快就会明白。\\n<c7/><WAIT><PAGE>", "srcs": ["script:69_24:0x1854"]}, {"id": "manual:recover_script_3654_18b8", "jp": "<c2e/>JOKER<c2e/>\\n<c31/>そうすりゃお前も、\\n<c31/>「こっち側」ガ間違いだって気づく。\\n", "zh": "<c2e/>JOKER<c2e/>\\n<c31/>到那时，你也会明白，\\n<c31/>“这一边”才是错的。\\n", "srcs": ["script:69_24:0x188a"]}]