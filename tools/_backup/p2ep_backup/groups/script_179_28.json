[{"id": "script:5286", "jp": "<c2e/>うらら<c2e/>\\n<c31/>ねぇ…<c5/>\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>喂……<c5/>\\n", "meta": "うらら", "srcs": ["script:179_28:0x448c"]}, {"id": "script:5287", "jp": "<c31/>どうしてそんなに憎むの…?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你为什么会那么恨呢……?\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x44ac"]}, {"id": "script:5288", "jp": "<c2e/>うらら<c2e/>\\n<c31/>あっ…!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>啊……!?\\n<c7/><WAIT><PAGE>", "meta": "うらら", "srcs": ["script:179_28:0x44f2"]}, {"id": "script:5289", "jp": "<c2e/>うらら<c2e/>\\n<c31/>わわっ…!?\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>丽<c2e/>\\n<c31/>哇哇……!?\\n<c7/><WAIT><PAGE>", "meta": "うらら", "srcs": ["script:179_28:0x4518"]}, {"id": "script:5290", "jp": "<c2e/>克哉<c2e/>\\n<c31/>奴を追うぞ。\\n<c7/><WAIT><PAGE>", "zh": "<c2e/>克哉<c2e/>\\n<c31/>追上那家伙。\\n<c7/><WAIT><PAGE>", "meta": "克哉", "srcs": ["script:179_28:0x4540"]}, {"id": "script:5291", "jp": "<c2e/>うらら<c2e/>\\n<c31/>なんなのよう!?\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>这到底是怎么回事啊!?\\n", "meta": "うらら", "srcs": ["script:179_28:0x4566"]}, {"id": "script:5292", "jp": "<c31/>なにガどうなってんの!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>这、这到底是怎么搞的!?\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x458c"]}, {"id": "script:5293", "jp": "<c2e/>克哉<c2e/>\\n<c31/>盗聴ガバレていたんだ。\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>窃听已经暴露了。\\n", "meta": "克哉", "srcs": ["script:179_28:0x45b0"]}, {"id": "script:5294", "jp": "<c31/>あの電話は、マフィア共々僕らを抹殺する\\n<c31/>ための罠だったんだ。\\n<c7/><WAIT><PAGE>", "zh": "<c31/>那通电话，是为了把我们连同黑手党一起抹杀的\\n<c31/>陷阱。\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x45da"]}, {"id": "script:5295", "jp": "<c2e/>うらら<c2e/>\\n<c31/>えぇ!?\\n<c31/>じゃあ、パオの奴ガ…\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>欸!?\\n<c31/>那、那报复那家伙……\\n", "meta": "うらら", "srcs": ["script:179_28:0x4624"]}, {"id": "script:5296", "jp": "<c31/>ヤバイよ、教えてやんなきゃ!\\n<c7/><WAIT><PAGE>", "zh": "<c31/>糟了，得快告诉他才行！\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x465a"]}, {"id": "script:5297", "jp": "<c2e/>克哉<c2e/>\\n<c31/>自分の身を心配しろ。\\n", "zh": "<c2e/>克哉<c2e/>\\n<c31/>先担心你自己吧。\\n", "meta": "克哉", "srcs": ["script:179_28:0x4682"]}, {"id": "script:5298", "jp": "<c31/>奴も、知っていることだ…\\n<c7/><WAIT><PAGE>", "zh": "<c31/>那件事，他自己也知道……\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x46aa"]}, {"id": "script:5299", "jp": "<c2e/>うらら<c2e/>\\n<c31/>え…?\\n", "zh": "<c2e/>丽<c2e/>\\n<c31/>欸……?\\n", "meta": "うらら", "srcs": ["script:179_28:0x46ce"]}, {"id": "script:5300", "jp": "<c31/>なんて言ったの?<c31/>ねぇ!?\\n<c7/><WAIT><PAGE>", "zh": "<c31/>你说什么？<c31/>喂!?\\n<c7/><WAIT><PAGE>", "srcs": ["script:179_28:0x46ea"]}]