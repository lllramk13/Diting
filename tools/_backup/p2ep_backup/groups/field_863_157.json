[{"id": "field:15285", "jp": "<c2e/><NAME/><c2e/>\\n この女には、指一本触れさせない…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我绝不会让你碰这女人一根手指……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x524", "field:863_384:dec:0x380", "field:863_386:dec:0x380", "field:863_387:dec:0x380"]}, {"id": "field:15286", "jp": "<c2e/><NAME/><c2e/>\\n 俺は、あんたを守る為にここに来た…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我是为了保护你才来到这里的……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x55a", "field:863_384:dec:0x438", "field:863_386:dec:0x422", "field:863_387:dec:0x3f4"]}, {"id": "field:15287", "jp": "<c2e/><NAME/><c2e/>\\n どうしてもやる気か…?\\n <cb/><c7/>なら…死ぬ気で来い。<c7/>\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你铁了心要动手吗……？\\n <cb/><c7/>那就……拼死来吧。<c7/>\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x598", "field:863_384:dec:0x4ee", "field:863_386:dec:0x4a8", "field:863_387:dec:0x486"]}, {"id": "field:15288", "jp": "<c2e/><NAME/><c2e/>\\n 貴様…よくも…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你这家伙…竟敢…\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x5e4", "field:863_161:dec:0xb16"]}, {"id": "field:15289", "jp": "<c2e/><NAME/><c2e/>\\n 俺を怒らせたな…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n你把我惹火了……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x608", "field:863_161:dec:0xb3a"]}, {"id": "field:15290", "jp": "<c2e/><NAME/><c2e/>\\n 貴様は殺す…\\n<WAIT><PAGE>", "zh": "<c2e/><NAME/><c2e/>\\n我要宰了你……\\n<WAIT><PAGE>", "meta": "<NAME/>", "srcs": ["field:863_157:dec:0x62e", "field:863_161:dec:0xb60"]}]